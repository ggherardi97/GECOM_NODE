<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ScarletDrive - Controle</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/scarlet-drive.css" />
</head>
<body>
  <main class="page">
    <section class="panel hero">
      <div class="hero-top">
        <div class="brand">
          <img class="logo" src="/Assets/scarletdrive-logo.png" alt="Logo ScarletDrive" onerror="this.style.display='none'" />
          <div>
            <h1 class="brand-title">ScarletDrive Control</h1>
            <p class="brand-sub">Guestlist, repertorio atual e votacao de opcoes no mesmo painel.</p>
          </div>
        </div>
        <div id="heroActions" class="hero-actions">
          <div id="heroMusicBadge" class="pill">Repertorio: <strong>0</strong> musicas</div>
          <div id="totalCounter" class="pill">Total: <strong>0</strong> / <%= maxGuests %></div>
        </div>
      </div>
      <div class="hero-nav">
        <button type="button" class="nav-tab is-active" data-view-target="lista">Lista</button>
        <button type="button" class="nav-tab" data-view-target="repertorio">Repertorio atual</button>
        <button type="button" class="nav-tab" data-view-target="votacao">Votacao de opcoes</button>
      </div>
      <div id="hostChips" class="host-chips"></div>
    </section>

    <section class="view is-active" data-view="lista">
      <div class="layout-grid">
        <article class="panel panel-body">
          <div class="section-head">
            <div>
              <h2 class="panel-title">Add convidado +</h2>
              <p class="panel-subtitle">A guestlist continua inteira na aba Lista.</p>
            </div>
            <button id="exportBtn" type="button" class="btn btn-secondary">Exportar lista final</button>
          </div>
          <form id="addForm" class="form-grid guest-form">
            <label class="field"><span>Nome</span><input id="guestName" type="text" maxlength="120" placeholder="Nome do convidado" required /></label>
            <label class="field"><span>Convidado por</span><select id="guestHost" required><% scarletHosts.forEach(function(host) { %><option value="<%= host %>"><%= host %></option><% }) %></select></label>
            <label class="field"><span>Pago?</span><select id="guestPaid"><option value="false">Nao</option><option value="true">Sim</option></select></label>
            <label class="field"><span>Confirmado?</span><select id="guestConfirmed"><option value="false">Nao</option><option value="true">Sim</option></select></label>
            <button id="addBtn" type="submit" class="btn btn-primary">Adicionar +</button>
          </form>
          <div id="feedback" class="feedback"></div>
          <div class="toolbar"><div id="filterSummary" class="muted">Mostrando todos os convidados.</div></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Nome</th><th>Convidado por</th><th>Pago?</th><th>Confirmado?</th><th>Excluir</th></tr>
                <tr class="filter-row">
                  <th><input id="filterName" class="filter-control" type="text" placeholder="Filtrar nome" /></th>
                  <th><select id="filterHost" class="filter-control"><option value="">Todos</option><% scarletHosts.forEach(function(host) { %><option value="<%= host %>"><%= host %></option><% }) %></select></th>
                  <th><select id="filterPaid" class="filter-control"><option value="">Todos</option><option value="true">Sim</option><option value="false">Nao</option></select></th>
                  <th><select id="filterConfirmed" class="filter-control"><option value="">Todos</option><option value="true">Sim</option><option value="false">Nao</option></select></th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="guestsTableBody"><tr><td colspan="5">Carregando...</td></tr></tbody>
            </table>
          </div>
        </article>

        <aside class="panel panel-body">
          <h2 class="panel-title">Visao rapida</h2>
          <div class="charts-grid">
            <div class="chart-card"><h3>Confirmados vs nao confirmados</h3><div class="chart-box"><canvas id="confirmedChart"></canvas></div></div>
            <div class="chart-card"><h3>Pago vs nao pago</h3><div class="chart-box"><canvas id="paidChart"></canvas></div></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="view" data-view="repertorio">
      <div class="layout-grid layout-grid--music">
        <article class="panel panel-body">
          <div class="section-head">
            <h2 class="panel-title">Repertorio atual</h2>
            <button id="printRepertoireBtn" type="button" class="btn btn-secondary">Imprimir repertorio</button>
          </div>
          <form id="songForm" class="form-grid song-form">
            <label class="field"><span>Nome da musica</span><input id="songName" type="text" maxlength="160" placeholder="Ex.: Sweet Child O' Mine" required /></label>
            <label class="field"><span>Quem sugeriu</span><select id="songSuggestedBy" required><% scarletHosts.forEach(function(host) { %><option value="<%= host %>"><%= host %></option><% }) %></select></label>
            <button id="songAddBtn" type="submit" class="btn btn-primary">Adicionar musica</button>
          </form>
          <div id="songFeedback" class="feedback"></div>
          <p class="helper">Arraste uma musica para cima ou para baixo para reorganizar o repertorio.</p>
          <div id="repertoireList" class="stack"></div>
        </article>

        <aside class="panel panel-body">
          <h2 class="panel-title">Preview do repertorio</h2>
          <p class="panel-subtitle">Ordem atual das musicas para conferencia rapida.</p>
          <div id="repertoireRanking" class="stack"></div>
        </aside>
      </div>
    </section>

    <section class="view" data-view="votacao">
      <div id="voterGate" class="panel panel-body narrow-panel">
        <div>
          <h2 class="panel-title">Quem esta votando?</h2>
          <p class="panel-subtitle">Selecione o votante antes de entrar na tela de votacao.</p>
        </div>
        <div class="form-grid voter-grid">
          <label class="field"><span>Votante</span><select id="voterSelect"><option value="">Selecione</option><% scarletHosts.forEach(function(host) { %><option value="<%= host %>"><%= host %></option><% }) %></select></label>
          <button id="continueVotingBtn" type="button" class="btn btn-primary">Continuar</button>
        </div>
        <div id="voterFeedback" class="feedback"></div>
        <button id="forceVoterAccessBtn" type="button" class="btn btn-secondary" hidden>Estou em outro aparelho - Continuar</button>
      </div>

      <div id="voteSessionHub" class="layout-grid layout-grid--music" hidden>
        <article class="panel panel-body">
          <div class="section-head">
            <div>
              <h2 class="panel-title">Votacoes ativas</h2>
              <p class="panel-subtitle">Escolha uma votacao para abrir ou crie uma nova com as opcoes dessa rodada.</p>
            </div>
            <div class="inline-actions">
              <span id="currentVoterBadge" class="pill">Votando: -</span>
              <button id="openVoteBuilderBtn" type="button" class="btn btn-primary">Nova votacao</button>
              <button id="changeVoterBtn" type="button" class="btn btn-secondary">Trocar votante</button>
            </div>
          </div>
          <div id="voteBuilder" class="builder" hidden>
            <div class="section-head builder-head">
              <div>
                <h3 class="panel-title panel-title--small">Nova votacao</h3>
                <p class="panel-subtitle">Defina o nome da votacao, monte a lista de opcoes e salve.</p>
              </div>
              <button id="closeVoteBuilderBtn" type="button" class="btn btn-secondary">Fechar</button>
            </div>
            <div class="builder-form">
              <label class="field">
                <span>Nome da votacao</span>
                <input id="voteSessionName" type="text" maxlength="120" placeholder="Ex.: Compras do mes" />
              </label>
              <label class="field">
                <span>Tipo de resposta</span>
                <select id="voteSessionAnswerMode">
                  <option value="yes_no">Sim ou nao</option>
                  <option value="rating_1_5">Nota de 1 a 5</option>
                </select>
              </label>
              <label class="field">
                <span id="voteSessionMaxVotesLabel">Limite de votos Sim por pessoa</span>
                <input id="voteSessionMaxVotes" type="number" min="1" max="99" step="1" value="5" />
              </label>
              <label class="field">
                <span>Voto secreto?</span>
                <select id="voteSessionIsSecret">
                  <option value="false">Nao</option>
                  <option value="true">Sim</option>
                </select>
              </label>
              <div class="form-grid draft-grid">
                <label class="field">
                  <span>Adicionar opcao</span>
                  <input id="voteDraftSongName" type="text" maxlength="160" placeholder="Digite a outra opcao" />
                </label>
                <button id="addDraftVoteSongBtn" type="button" class="btn btn-primary">Adicionar opcao</button>
              </div>
              <div id="voteBuilderFeedback" class="feedback"></div>
              <div id="voteDraftSongs" class="stack"></div>
              <button id="saveVoteSessionBtn" type="button" class="btn btn-primary">Salvar votacao</button>
            </div>
          </div>
          <div id="voteSessionsList" class="stack"></div>
        </article>

        <aside class="panel panel-body">
          <h2 class="panel-title">Ativas agora</h2>
          <p class="panel-subtitle">Resumo rapido das votacoes abertas.</p>
          <div id="voteSessionsPreview" class="stack"></div>
        </aside>
      </div>

      <div id="voteWorkspace" class="layout-grid layout-grid--music" hidden>
        <article class="panel panel-body">
          <div class="section-head">
            <div>
              <h2 id="activeVoteSessionTitle" class="panel-title">Votacao</h2>
              <p id="activeVoteSessionSubtitle" class="panel-subtitle">Adicione novas opcoes e vote com o limite configurado para esta votacao.</p>
            </div>
            <div class="inline-actions">
              <button id="convertVoteSessionModeBtn" type="button" class="btn btn-secondary" hidden>Converter para notas 1 a 5</button>
              <button id="backToVoteSessionsBtn" type="button" class="btn btn-secondary">Voltar para votacoes</button>
            </div>
          </div>
          <div id="ratingLegend" class="helper" hidden>
            <strong>1</strong> pior tipo de musica pra se tocar |
            <strong>2</strong> ruim, mas tem piores |
            <strong>3</strong> musica ok, tanto faz |
            <strong>4</strong> boa, mas tem melhores |
            <strong>5</strong> muito boa para repertorio
          </div>
          <form id="voteSongForm" class="form-grid draft-grid">
            <label class="field"><span>Adicionar opcao</span><input id="voteSongName" type="text" maxlength="160" placeholder="Digite a outra opcao" required /></label>
            <button id="voteSongAddBtn" type="submit" class="btn btn-primary">Adicionar opcao</button>
          </form>
          <div id="voteFeedback" class="feedback"></div>
          <div class="vote-limit"><span id="voteProgressLabel">Seus votos Sim:</span> <strong id="positiveVoteCount">0</strong> / <span id="positiveVoteLimit">0</span></div>
          <div id="voteSongList" class="stack"></div>
        </article>

        <aside class="panel panel-body">
          <h2 class="panel-title">Preview</h2>
          <p class="panel-subtitle">Ranking das opcoes dessa votacao por quantidade de votos.</p>
          <div id="voteRanking" class="stack"></div>
        </aside>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    window.SCARLET_DRIVE_BOOT = {
      hosts: <%- JSON.stringify(scarletHosts) %>,
      maxGuests: <%- maxGuests %>,
      maxPerHost: <%- maxPerHost %>,
      maxPositiveVotesPerVoter: <%- maxPositiveVotesPerVoter %>
    };
  </script>
  <script src="/js/scarlet-drive.page.js"></script>
</body>
</html>
