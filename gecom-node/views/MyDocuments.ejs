    function syncDocumentListHeaderMeta() {
      const $headerCells = $("#documentsHeaderRow").children("th");
      const $filterCells = $("#documentsFiltersRow").children("th");
      const fallbackKeys = ["name", "type", "related", "storage", "created_at_text", "__actions"];

      $headerCells.each(function (index) {
        const $th = $(this);
        if (!$th.attr("data-column-key")) {
          const key = String($th.data("sort-key") || fallbackKeys[index] || "").trim();
          if (key) $th.attr("data-column-key", key);
        }
      });

      $filterCells.each(function (index) {
        const $th = $(this);
        if (!$th.attr("data-column-key")) {
          const key = String($headerCells.eq(index).attr("data-column-key") || fallbackKeys[index] || "").trim();
          if (key) $th.attr("data-column-key", key);
        }
      });

      $headerCells.last().attr("data-sv-fixed", "right");
      $filterCells.last().attr("data-sv-fixed", "right");
      if ($headerCells.last().text().indexOf("AÃ") === 0) {
        $headerCells.last().html("A&ccedil;&otilde;es");
      }
    }

    function syncDocumentListToVisibleColumns() {
      syncDocumentListHeaderMeta();

      const headerColumns = $("#documentsHeaderRow").children("th").map(function () {
        const $th = $(this);
        return {
          key: String($th.attr("data-column-key") || $th.data("sort-key") || "").trim(),
          visible: $th.is(":visible")
        };
      }).get().filter(col => !!col.key);

      if (!headerColumns.length) return;

      $("#documentsFiltersRow").children("th").each(function (index) {
        const meta = headerColumns[index];
        $(this).toggle(meta ? meta.visible : true);
      });

      $("#documentsListBody").children("tr").each(function () {
        const $tr = $(this);
        const $cells = $tr.children("td");
        if (!$cells.length) return;

        const cellsByKey = new Map();
        $cells.each(function () {
          const key = String($(this).attr("data-column-key") || "").trim();
          if (!key) return;
          cellsByKey.set(key, $(this));
        });
        if (!cellsByKey.size) return;

        const orderedCells = [];
        headerColumns.forEach((col) => {
          const $cell = cellsByKey.get(col.key);
          if (!$cell || !$cell.length) return;
          $cell.toggle(col.visible);
          orderedCells.push($cell);
        });

        if (orderedCells.length) $tr.empty().append(orderedCells);
      });
    }

