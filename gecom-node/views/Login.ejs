<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title id="loginPageTitle">GECOM | <%= t('page.login.pageTitle') %></title>
    <link id="loginFaviconShortcut" rel="shortcut icon" href="../Pages/favicon.ico" type="image/x-icon" />
    <link id="loginFavicon" rel="icon" href="../Pages/favicon.ico" type="image/x-icon" />
    <link href="../Assets/inspinia/css/bootstrap.min.css" rel="stylesheet" />
    <link href="../Assets/inspinia/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link href="../Assets/inspinia/css/animate.css" rel="stylesheet" />
    <link href="../Assets/inspinia/css/style.css" rel="stylesheet" />
    <script src="../Assets/js/pages/Login.js"></script>
    <style>
        .loginscreen.middle-box {
            width: 350px;
        }
        #loginForm,
        #acessNumberForm,
        #forgotPassword,
        #resetPassword {
            position: relative;
            z-index: 2;
        }
        body.modal-open {
            padding-right: 0 !important;
        }
        .password-input-group .btn {
            background-color: #fff;
            border-color: #e5e6e7;
            color: #676a6c;
        }
        .password-input-group .btn:hover,
        .password-input-group .btn:focus {
            color: #1ab394;
        }
        body.brand-gecom::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 200%;
  height: 100%;
  background-image: url("../Assets/img/gecom_bk3.png");
  background-repeat: repeat-x;
  background-size: auto 100%;
  opacity: 0.25;
  z-index: -1;
  animation: moveBackground 120s linear infinite;
}

@keyframes moveBackground {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

        body.brand-convert {
            overflow: hidden;
            background: radial-gradient(circle at 15% 20%, #153f66 0%, #0a2038 38%, #061523 70%, #050f1c 100%);
            background-size: 180% 180%;
            animation: convertGradientShift 18s ease-in-out infinite;
        }

        body.brand-convert::before {
            content: "";
            position: fixed;
            inset: -12%;
            z-index: -2;
            pointer-events: none;
            background:
                radial-gradient(circle at 18% 26%, rgba(0, 190, 255, 0.22) 0%, transparent 35%),
                radial-gradient(circle at 82% 72%, rgba(84, 255, 180, 0.18) 0%, transparent 34%),
                radial-gradient(circle at 48% 52%, rgba(14, 72, 130, 0.45) 0%, transparent 50%);
            filter: blur(16px);
            animation: convertAuraDrift 20s ease-in-out infinite alternate;
        }

        body.brand-convert::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: linear-gradient(115deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 35%, rgba(64, 216, 255, 0.08) 100%);
        }

        @keyframes convertGradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes convertAuraDrift {
            from { transform: translate3d(-2%, -1%, 0) scale(1); }
            to { transform: translate3d(2%, 2%, 0) scale(1.04); }
        }

        .register-tech-bg {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
        }

        body.brand-convert .register-tech-bg {
            display: block;
        }

        .register-tech-track {
            position: absolute;
            left: 0;
            width: 200%;
            display: flex;
            color: rgba(160, 230, 255, 0.3);
            text-shadow: 0 0 10px rgba(88, 216, 255, 0.26);
            animation: registerTechScroll 120s linear infinite;
            will-change: transform;
        }

        .register-tech-track--one {
            top: 14%;
            font-size: 34px;
            animation-duration: 140s;
        }

        .register-tech-track--two {
            top: 46%;
            font-size: 28px;
            color: rgba(119, 255, 219, 0.25);
            animation-duration: 145s;
            animation-direction: reverse;
        }

        .register-tech-track--three {
            top: 76%;
            font-size: 30px;
            color: rgba(138, 200, 255, 0.22);
            animation-duration: 165s;
        }

        .register-tech-seq {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 0 24px;
        }

        .register-tech-seq i {
            opacity: .85;
            transform: rotate(-4deg);
        }

        @keyframes registerTechScroll {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-50%);
            }
        }

        .convert-tech-surface {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        body.brand-convert .convert-tech-surface {
            display: block;
        }

        .convert-grid,
        .convert-grid::after {
            content: "";
            position: absolute;
            inset: -8%;
            background-size: 42px 42px, 42px 42px;
            background-image:
                linear-gradient(to right, rgba(96, 204, 255, 0.14) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(96, 204, 255, 0.12) 1px, transparent 1px);
        }

        .convert-grid {
            transform: perspective(850px) rotateX(59deg) translateY(12%);
            transform-origin: center top;
            opacity: .56;
            animation: convertGridMove 26s linear infinite;
        }

        .convert-grid::after {
            inset: 0;
            opacity: .42;
            transform: translateY(18px);
            background-image:
                linear-gradient(to right, rgba(145, 255, 223, 0.14) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(145, 255, 223, 0.1) 1px, transparent 1px);
        }

        @keyframes convertGridMove {
            from {
                transform: perspective(850px) rotateX(59deg) translate3d(0, 12%, 0);
            }
            to {
                transform: perspective(850px) rotateX(59deg) translate3d(-42px, 18%, 0);
            }
        }

        .convert-scanline {
            position: absolute;
            left: 0;
            right: 0;
            height: 190px;
            background: linear-gradient(to bottom, rgba(127, 231, 255, 0), rgba(127, 231, 255, 0.16), rgba(127, 231, 255, 0));
            filter: blur(1px);
            animation: convertScan 8s ease-in-out infinite;
            opacity: .68;
        }

        @keyframes convertScan {
            0% { top: -220px; }
            100% { top: 110%; }
        }

        .convert-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(22px);
            opacity: .42;
            animation: convertOrbFloat 13s ease-in-out infinite alternate;
        }

        .convert-orb--one {
            width: 260px;
            height: 260px;
            top: -70px;
            right: 8%;
            background: rgba(82, 213, 255, 0.35);
        }

        .convert-orb--two {
            width: 220px;
            height: 220px;
            bottom: -58px;
            left: 7%;
            background: rgba(112, 255, 208, 0.3);
            animation-delay: -5s;
        }

        .convert-orb--three {
            width: 160px;
            height: 160px;
            top: 28%;
            left: 56%;
            background: rgba(136, 165, 255, 0.26);
            animation-delay: -2.8s;
        }

        @keyframes convertOrbFloat {
            from { transform: translate3d(0, 0, 0) scale(1); }
            to { transform: translate3d(14px, -18px, 0) scale(1.08); }
        }

        body.brand-convert #loginForm,
        body.brand-convert #acessNumberForm,
        body.brand-convert #forgotPassword,
        body.brand-convert #resetPassword {
            background: rgba(7, 25, 43, 0.74) !important;
            border: 1px solid rgba(102, 224, 255, 0.36);
            border-radius: 12px !important;
            backdrop-filter: blur(8px);
            box-shadow: 0 20px 50px rgba(2, 8, 17, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
        }

        body.brand-convert #loginForm h3,
        body.brand-convert #acessNumberForm h3,
        body.brand-convert #forgotPassword h3,
        body.brand-convert #resetPassword h3 {
            color: #e9f9ff;
        }

        body.brand-convert #loginSubtitle,
        body.brand-convert #acessNumberForm p,
        body.brand-convert #forgotPassword p,
        body.brand-convert #resetPassword p {
            color: rgba(226, 241, 255, 0.78);
        }

        body.brand-convert #registerCta {
            color: #9ddfff !important;
        }

        body.brand-convert .password-input-group .btn {
            border-color: rgba(110, 220, 255, 0.4);
        }

        body.brand-convert .btn-white,
        body.brand-convert a.btn-white {
            background: rgba(247, 252, 255, 0.96);
            border-color: #c8dceb;
            color: #12344f !important;
        }

        body.brand-convert .btn-white:hover,
        body.brand-convert .btn-white:focus,
        body.brand-convert a.btn-white:hover,
        body.brand-convert a.btn-white:focus {
            background: #e6f1f9;
            border-color: #b9d0e1;
            color: #0f2b42 !important;
        }

        body.brand-convert #world-map {
            opacity: .86;
        }

        .login-hero-visual {
            height: 100px;
            margin-top: 20px;
            position: relative;
        }

        #world-map {
            width: 100%;
            height: 100%;
        }

        .ai-listening-hero {
            display: none;
            width: 100%;
            height: 100%;
            position: relative;
            align-items: center;
            justify-content: center;
            color: #b5eeff;
        }

        .ai-listening-core {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            border: 2px solid rgba(134, 232, 255, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 30% 30%, rgba(120, 237, 255, 0.18), rgba(9, 32, 56, 0.25) 70%);
            box-shadow: 0 0 22px rgba(73, 213, 255, 0.22), inset 0 0 20px rgba(76, 231, 255, 0.16);
        }

        .ai-listening-core i {
            font-size: 28px;
            color: #c8f4ff;
            animation: aiRocketFloat 1.9s ease-in-out infinite;
        }

        .ai-ring {
            position: absolute;
            inset: 0;
            margin: auto;
            border-radius: 50%;
            border: 1px solid rgba(128, 234, 255, 0.45);
            animation: aiPulse 2.6s ease-out infinite;
            opacity: 0;
        }

        .ai-ring--one { width: 78px; height: 78px; }
        .ai-ring--two { width: 102px; height: 102px; animation-delay: .45s; }
        .ai-ring--three { width: 126px; height: 126px; animation-delay: .9s; }

        .ai-eq {
            position: absolute;
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 4px;
            align-items: flex-end;
            height: 24px;
        }

        .ai-eq span {
            width: 4px;
            border-radius: 3px;
            background: linear-gradient(to top, rgba(120, 243, 255, 0.4), rgba(165, 251, 255, 0.95));
            animation: aiEqBounce 1.1s ease-in-out infinite;
        }

        .ai-eq span:nth-child(1) { height: 9px; animation-delay: .0s; }
        .ai-eq span:nth-child(2) { height: 16px; animation-delay: .15s; }
        .ai-eq span:nth-child(3) { height: 22px; animation-delay: .3s; }
        .ai-eq span:nth-child(4) { height: 16px; animation-delay: .45s; }
        .ai-eq span:nth-child(5) { height: 9px; animation-delay: .6s; }

        @keyframes aiPulse {
            0% {
                transform: scale(.72);
                opacity: .0;
            }
            28% {
                opacity: .48;
            }
            100% {
                transform: scale(1.14);
                opacity: 0;
            }
        }

        @keyframes aiEqBounce {
            0%, 100% { transform: scaleY(.65); opacity: .7; }
            50% { transform: scaleY(1.2); opacity: 1; }
        }

        @keyframes aiRocketFloat {
            0%, 100% { transform: translateY(0) rotate(-4deg); }
            50% { transform: translateY(-3px) rotate(2deg); }
        }

        @media (prefers-reduced-motion: reduce) {
            .register-tech-track {
                animation: none;
            }
            .convert-grid,
            .convert-scanline,
            .convert-orb,
            body.brand-convert,
            body.brand-convert::before {
                animation: none !important;
            }
            .ai-ring,
            .ai-eq span,
            .ai-listening-core i {
                animation: none !important;
            }
        }

    </style>
</head>
