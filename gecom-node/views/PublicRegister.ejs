<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta id="registerMetaDescription" name="description" content="Cadastro GECOM - escolha seu plano e comece a usar a plataforma." />
  <meta id="registerMetaAuthor" name="author" content="GECOM" />
  <meta name="google-maps-key" content="<%= googleKey || '' %>" />
  <title id="registerPageTitle">GECOM | Cadastro</title>

  <link id="registerFaviconShortcut" rel="shortcut icon" href="/Pages/favicon.ico" type="image/x-icon" />
  <link id="registerFavicon" rel="icon" href="/Pages/favicon.ico" type="image/x-icon" />
  <script>
    (function () {
      function resolvePortalBrand() {
        const host = String(window.location && window.location.hostname ? window.location.hostname : "").toLowerCase();
        if (host.includes("convert-plus.com")) return "convert";
        if (host.includes("portalgecom.log.br")) return "gecom";
        return "convert";
      }

      function buildRocketFaviconDataUri() {
        const svg =
          "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>" +
          "<rect width='64' height='64' rx='12' fill='#0f2c45'/>" +
          "<text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-size='36'>&#x1F680;</text>" +
          "</svg>";
        return "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg);
      }

      const brand = resolvePortalBrand();
      const isConvert = brand === "convert";
      const brandName = isConvert ? "Convert Plus" : "GECOM";
      const description = isConvert
        ? "Cadastro Convert Plus - escolha seu plano e comece a usar a plataforma."
        : "Cadastro GECOM - escolha seu plano e comece a usar a plataforma.";
      const favicon = isConvert ? buildRocketFaviconDataUri() : "/Pages/favicon.ico";
      window.__portalBrand = brand;
      document.documentElement.setAttribute("data-portal-brand", brand);

      document.title = brandName + " | Cadastro";
      const metaDescription = document.getElementById("registerMetaDescription");
      const metaAuthor = document.getElementById("registerMetaAuthor");
      if (metaDescription) metaDescription.setAttribute("content", description);
      if (metaAuthor) metaAuthor.setAttribute("content", brandName);

      const faviconDefault = document.getElementById("registerFavicon");
      const faviconShortcut = document.getElementById("registerFaviconShortcut");
      if (faviconDefault) faviconDefault.setAttribute("href", favicon);
      if (faviconShortcut) faviconShortcut.setAttribute("href", favicon);
    })();
  </script>

  <link href="/Assets/inspinia/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/Assets/inspinia/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
  <link href="/Assets/inspinia/css/animate.css" rel="stylesheet" />
  <link href="/Assets/inspinia/css/style.css" rel="stylesheet" />
  <link href="/Assets/inspinia/css/plugins/sweetalert/sweetalert.css" rel="stylesheet" />

  <style>
    body.register-marketing {
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      background: linear-gradient(145deg, #f8fbfd 0%, #f0f5f8 45%, #e9f3ef 100%);
    }

    html[data-portal-brand="convert"] body.register-marketing {
      background: radial-gradient(circle at 15% 20%, #153f66 0%, #0a2038 38%, #061523 70%, #050f1c 100%);
      background-size: 180% 180%;
      animation: convertGradientShift 18s ease-in-out infinite;
      color: #e8f4ff;
    }

    html[data-portal-brand="convert"] body.register-marketing::before {
      content: "";
      position: fixed;
      inset: -12%;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 18% 26%, rgba(0, 190, 255, 0.22) 0%, transparent 35%),
        radial-gradient(circle at 82% 72%, rgba(84, 255, 180, 0.18) 0%, transparent 34%),
        radial-gradient(circle at 48% 52%, rgba(14, 72, 130, 0.45) 0%, transparent 50%);
      filter: blur(16px);
      animation: convertAuraDrift 20s ease-in-out infinite alternate;
    }

    html[data-portal-brand="convert"] body.register-marketing::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(115deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 35%, rgba(64, 216, 255, 0.08) 100%);
    }

    @keyframes convertGradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes convertAuraDrift {
      from { transform: translate3d(-2%, -1%, 0) scale(1); }
      to { transform: translate3d(2%, 2%, 0) scale(1.04); }
    }

    .register-tech-bg {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      overflow: hidden;
    }

    .register-tech-track {
      position: absolute;
      left: 0;
      width: 200%;
      display: flex;
      color: rgba(35, 89, 123, 0.15);
      animation: registerTechScroll 150s linear infinite;
      will-change: transform;
    }

    html[data-portal-brand="convert"] .register-tech-track {
      color: rgba(160, 230, 255, 0.3);
      text-shadow: 0 0 10px rgba(88, 216, 255, 0.26);
      animation-duration: 130s;
    }

    .register-tech-track--one {
      top: 14%;
      font-size: 34px;
      animation-duration: 140s;
    }

    .register-tech-track--two {
      top: 46%;
      font-size: 28px;
      color: rgba(22, 129, 112, 0.13);
      animation-duration: 180s;
      animation-direction: reverse;
    }

    .register-tech-track--three {
      top: 76%;
      font-size: 30px;
      color: rgba(60, 95, 132, 0.12);
      animation-duration: 210s;
    }

    html[data-portal-brand="convert"] .register-tech-track--two {
      color: rgba(119, 255, 219, 0.25);
    }

    html[data-portal-brand="convert"] .register-tech-track--three {
      color: rgba(138, 200, 255, 0.22);
    }

    .register-tech-seq {
      width: 50%;
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding: 0 24px;
    }

    .register-tech-seq i {
      opacity: .9;
      transform: rotate(-4deg);
    }

    @keyframes registerTechScroll {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }

    .convert-tech-surface {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    html[data-portal-brand="convert"] .convert-tech-surface {
      display: block;
    }

    .convert-grid,
    .convert-grid::after {
      content: "";
      position: absolute;
      inset: -8%;
      background-size: 42px 42px, 42px 42px;
      background-image:
        linear-gradient(to right, rgba(96, 204, 255, 0.14) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(96, 204, 255, 0.12) 1px, transparent 1px);
    }

    .convert-grid {
      transform: perspective(850px) rotateX(59deg) translateY(12%);
      transform-origin: center top;
      opacity: .56;
      animation: convertGridMove 26s linear infinite;
    }

    .convert-grid::after {
      inset: 0;
      opacity: .42;
      transform: translateY(18px);
      background-image:
        linear-gradient(to right, rgba(145, 255, 223, 0.14) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(145, 255, 223, 0.1) 1px, transparent 1px);
    }

    @keyframes convertGridMove {
      from {
        transform: perspective(850px) rotateX(59deg) translate3d(0, 12%, 0);
      }
      to {
        transform: perspective(850px) rotateX(59deg) translate3d(-42px, 18%, 0);
      }
    }

    .convert-scanline {
      position: absolute;
      left: 0;
      right: 0;
      height: 190px;
      background: linear-gradient(to bottom, rgba(127, 231, 255, 0), rgba(127, 231, 255, 0.16), rgba(127, 231, 255, 0));
      filter: blur(1px);
      animation: convertScan 8s ease-in-out infinite;
      opacity: .68;
    }

    @keyframes convertScan {
      0% { top: -220px; }
      100% { top: 110%; }
    }

    .convert-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(22px);
      opacity: .42;
      animation: convertOrbFloat 13s ease-in-out infinite alternate;
    }

    .convert-orb--one {
      width: 260px;
      height: 260px;
      top: -70px;
      right: 8%;
      background: rgba(82, 213, 255, 0.35);
    }

    .convert-orb--two {
      width: 220px;
      height: 220px;
      bottom: -58px;
      left: 7%;
      background: rgba(112, 255, 208, 0.3);
      animation-delay: -5s;
    }

    .convert-orb--three {
      width: 160px;
      height: 160px;
      top: 28%;
      left: 56%;
      background: rgba(136, 165, 255, 0.26);
      animation-delay: -2.8s;
    }

    @keyframes convertOrbFloat {
      from { transform: translate3d(0, 0, 0) scale(1); }
      to { transform: translate3d(14px, -18px, 0) scale(1.08); }
    }

    #heroSection,
    #featuresPublic,
    #plansStage {
      position: relative;
      z-index: 3;
    }

    .top-login-link {
      position: fixed;
      top: 14px;
      right: 18px;
      z-index: 1004;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid #1ab394;
      background: #1ab394;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 22px rgba(26, 179, 148, 0.35);
      transition: all .18s ease;
    }

    .top-login-link:hover,
    .top-login-link:focus {
      color: #fff;
      background: #159a80;
      border-color: #159a80;
      transform: translateY(-1px);
      text-decoration: none;
    }

    html[data-portal-brand="convert"] .top-login-link {
      border-color: rgba(99, 224, 255, 0.45);
      background: rgba(11, 40, 65, 0.8);
      box-shadow: 0 8px 22px rgba(13, 35, 56, 0.45);
    }

    html[data-portal-brand="convert"] .top-login-link:hover,
    html[data-portal-brand="convert"] .top-login-link:focus {
      background: rgba(19, 58, 90, 0.92);
      border-color: rgba(130, 235, 255, 0.65);
    }

    .gecom-spinner-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(255, 255, 255, .72);
      z-index: 9999;
      align-items: center;
      justify-content: center;
    }

    .gecom-spinner-overlay.is-visible {
      display: flex;
    }

    .gecom-spinner-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      background: #fff;
      border: 1px solid #e7edf2;
      border-radius: 14px;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.12);
      padding: 18px 22px;
      min-width: 320px;
    }

    .gecom-spinner-text {
      font-weight: 600;
      color: #2f3f48;
      text-align: center;
      max-width: 360px;
    }

    html[data-portal-brand="convert"] .gecom-spinner-overlay {
      background: rgba(3, 15, 28, 0.64);
    }

    html[data-portal-brand="convert"] .gecom-spinner-content {
      background: rgba(8, 29, 47, 0.88);
      border-color: rgba(102, 224, 255, 0.35);
      color: #e4f2ff;
      box-shadow: 0 12px 36px rgba(2, 7, 16, 0.5);
    }

    html[data-portal-brand="convert"] .gecom-spinner-text {
      color: #d7ecff;
    }

    .hero-wrap {
      padding: 120px 0 70px;
    }

    .hero-title {
      font-size: 44px;
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .hero-subtitle {
      font-size: 17px;
      color: #4d5a62;
      margin-bottom: 24px;
    }

    html[data-portal-brand="convert"] .hero-subtitle {
      color: rgba(220, 238, 255, 0.8);
    }

    .hero-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 18px 45px rgba(14, 34, 56, 0.12);
      padding: 24px;
      border: 1px solid #e9eef2;
    }

    html[data-portal-brand="convert"] .hero-card,
    html[data-portal-brand="convert"] .plan-card,
    html[data-portal-brand="convert"] .register-form-card,
    html[data-portal-brand="convert"] .payment-step {
      background: rgba(7, 25, 43, 0.74);
      border: 1px solid rgba(102, 224, 255, 0.26);
      box-shadow: 0 20px 50px rgba(2, 8, 17, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
      backdrop-filter: blur(8px);
    }

    html[data-portal-brand="convert"] .register-form-card label,
    html[data-portal-brand="convert"] .register-form-card .radio-inline,
    html[data-portal-brand="convert"] .register-form-card .checkbox label {
      color: #deefff;
    }

    html[data-portal-brand="convert"] .register-form-card .form-control {
      background: rgba(247, 252, 255, 0.96);
      border-color: #bfd4e5;
      color: #15374f;
    }

    html[data-portal-brand="convert"] .register-form-card .form-control:focus {
      border-color: #78c8ea;
      box-shadow: 0 0 0 2px rgba(73, 178, 221, 0.18);
    }

    html[data-portal-brand="convert"] .register-form-card .form-control::placeholder {
      color: #6a7b89;
      opacity: 1;
    }

    html[data-portal-brand="convert"] .register-form-card .form-control[readonly],
    html[data-portal-brand="convert"] .register-form-card .form-control[disabled] {
      background: #e9f2f8;
      color: #183a52;
      border-color: #bfd4e5;
      opacity: 1;
      -webkit-text-fill-color: #183a52;
    }

    html[data-portal-brand="convert"] .register-form-card select.form-control,
    html[data-portal-brand="convert"] .register-form-card select.form-control option {
      color: #15374f;
    }

    html[data-portal-brand="convert"] .hero-title,
    html[data-portal-brand="convert"] .hero-card h3,
    html[data-portal-brand="convert"] .plan-name,
    html[data-portal-brand="convert"] h1,
    html[data-portal-brand="convert"] h2,
    html[data-portal-brand="convert"] h3,
    html[data-portal-brand="convert"] h4 {
      color: #ebf7ff;
    }

    html[data-portal-brand="convert"] .text-muted,
    html[data-portal-brand="convert"] p.text-muted {
      color: rgba(207, 231, 255, 0.72) !important;
    }

    html[data-portal-brand="convert"] .btn-white,
    html[data-portal-brand="convert"] a.btn-white {
      background: rgba(247, 252, 255, 0.96);
      border-color: #c8dceb;
      color: #12344f !important;
    }

    html[data-portal-brand="convert"] .btn-white:hover,
    html[data-portal-brand="convert"] .btn-white:focus,
    html[data-portal-brand="convert"] a.btn-white:hover,
    html[data-portal-brand="convert"] a.btn-white:focus {
      background: #e6f1f9;
      border-color: #b9d0e1;
      color: #0f2b42 !important;
    }

    .feature-pill {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      background: #ecf8f2;
      color: #1f9d62;
      margin: 4px 8px 4px 0;
      font-size: 12px;
      font-weight: 600;
    }

    html[data-portal-brand="convert"] .feature-pill {
      background: rgba(109, 233, 255, 0.14);
      border: 1px solid rgba(126, 240, 255, 0.22);
      color: #b8efff;
    }

    .plans-stage {
      display: none;
      padding: 110px 0 60px;
    }

    .plans-stage.is-active {
      display: block;
    }

    .plan-card {
      background: #fff;
      border: 1px solid #e7edf2;
      border-radius: 14px;
      padding: 22px;
      min-height: 345px;
      position: relative;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .plan-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.10);
    }

    .plan-card.selected {
      border-color: #1ab394;
      box-shadow: 0 20px 44px rgba(26, 179, 148, 0.2);
    }

    html[data-portal-brand="convert"] .plan-card.selected {
      border-color: rgba(130, 235, 255, 0.72);
      box-shadow: 0 20px 44px rgba(6, 16, 33, 0.45);
    }

    .plan-name {
      font-size: 24px;
      margin-bottom: 8px;
      color: #29363d;
    }

    .plan-price {
      font-size: 28px;
      font-weight: 700;
      color: #1ab394;
      margin-bottom: 6px;
    }

    .plan-price small {
      font-size: 14px;
      color: #7f8b91;
      font-weight: 500;
    }

    html[data-portal-brand="convert"] .plan-price small,
    html[data-portal-brand="convert"] .plan-list {
      color: rgba(208, 229, 248, 0.82);
    }

    .plan-list {
      margin: 16px 0 18px;
      padding-left: 18px;
      color: #57656d;
    }

    .plan-list li {
      margin-bottom: 8px;
    }

    .disclaimer-box {
      border-left: 4px solid #f8ac59;
      padding: 12px 14px;
      background: #fff8ef;
      color: #8a5b19;
      border-radius: 6px;
      margin: 22px 0 0;
      font-weight: 600;
    }

    html[data-portal-brand="convert"] .disclaimer-box {
      border-left-color: #ffb85c;
      background: rgba(255, 184, 92, 0.14);
      color: #ffe1b8;
    }

    .register-form-wrap {
      display: none;
      margin-top: 30px;
    }

    .register-form-col {
      float: none;
      margin-left: auto;
      margin-right: auto;
      max-width: 980px;
    }

    .register-form-wrap.is-active {
      display: block;
    }

    .register-form-card {
      background: #fff;
      border: 1px solid #e6edf2;
      border-radius: 14px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.08);
      padding: 26px;
    }

    .section-hidden {
      display: none !important;
    }

    .btn-plan {
      width: 100%;
    }

    .plans-list-wrap {
      transition: opacity .2s ease;
    }

    .plans-list-wrap.is-hidden {
      display: none;
    }

    .custom-module-option {
      border: 1px solid #dfe8ee;
      border-radius: 8px;
      padding: 8px 10px;
      margin-bottom: 10px;
      min-height: 74px;
      background: #fff;
    }

    html[data-portal-brand="convert"] .custom-module-option,
    html[data-portal-brand="convert"] .payment-card-element {
      background: rgba(7, 25, 43, 0.66);
      border-color: rgba(110, 220, 255, 0.28);
      color: #deefff;
    }

    .custom-module-option label {
      margin: 0;
      cursor: pointer;
      width: 100%;
    }

    .custom-module-price {
      color: #1a9d7b;
      font-weight: 700;
      font-size: 12px;
      display: inline-block;
      margin-top: 4px;
    }

    .selected-plan-chip {
      display: inline-block;
      margin-bottom: 12px;
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .2px;
      background: #e8fbf5;
      color: #1a7b58;
    }

    .back-plan-btn {
      border: none;
      background: transparent;
      color: #1ab394;
      font-weight: 700;
      padding: 0;
      margin-bottom: 10px;
    }

    .trial-hint {
      display: inline-block;
      margin-bottom: 10px;
      padding: 7px 12px;
      border-radius: 999px;
      background: #e8fbf5;
      color: #1a7b58;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .2px;
    }

    .payment-step {
      border: 1px solid #e7edf2;
      border-radius: 10px;
      padding: 18px;
      background: #f9fcfe;
      margin-top: 18px;
    }

    .payment-card-element {
      border: 1px solid #dbe5ec;
      border-radius: 8px;
      padding: 12px 14px;
      background: #fff;
      min-height: 46px;
    }

    .payment-card-error {
      min-height: 18px;
      margin-top: 8px;
      color: #cc5965;
      font-size: 12px;
      font-weight: 600;
    }

    .payment-coupon-help {
      display: block;
      margin-top: 6px;
      color: #6a7880;
      font-size: 12px;
    }

    @media (max-width: 991px) {
      .hero-title {
        font-size: 34px;
      }

      .register-tech-track--one {
        font-size: 24px;
      }

      .register-tech-track--two {
        font-size: 20px;
      }

      .register-tech-track--three {
        font-size: 22px;
      }

      .hero-wrap {
        padding-top: 96px;
      }

      .plans-stage {
        padding-top: 94px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .register-tech-track {
        animation: none;
      }
      html[data-portal-brand="convert"] body.register-marketing,
      html[data-portal-brand="convert"] body.register-marketing::before,
      .convert-grid,
      .convert-scanline,
      .convert-orb {
        animation: none !important;
      }
    }
  </style>
</head>
<body class="register-marketing">
  <div class="register-tech-bg" aria-hidden="true">
    <div class="register-tech-track register-tech-track--one">
      <div class="register-tech-seq">
        <i class="fa fa-cloud"></i>
        <i class="fa fa-database"></i>
        <i class="fa fa-cogs"></i>
        <i class="fa fa-shield"></i>
        <i class="fa fa-line-chart"></i>
        <i class="fa fa-code"></i>
        <i class="fa fa-server"></i>
        <i class="fa fa-envelope-o"></i>
        <i class="fa fa-sitemap"></i>
        <i class="fa fa-lock"></i>
      </div>
      <div class="register-tech-seq" aria-hidden="true">
        <i class="fa fa-cloud"></i>
        <i class="fa fa-database"></i>
        <i class="fa fa-cogs"></i>
        <i class="fa fa-shield"></i>
        <i class="fa fa-line-chart"></i>
        <i class="fa fa-code"></i>
        <i class="fa fa-server"></i>
        <i class="fa fa-envelope-o"></i>
        <i class="fa fa-sitemap"></i>
        <i class="fa fa-lock"></i>
      </div>
    </div>

    <div class="register-tech-track register-tech-track--two">
