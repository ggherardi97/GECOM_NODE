<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="GECOM - landing atual com menu superior operando como tabs.">
    <meta name="author" content="GECOM">
    <title>GECOM - Landing Tabs</title>
    <link href="../Assets/inspinia/css/bootstrap.min.css" rel="stylesheet">
    <link href="../Assets/inspinia/css/animate.css" rel="stylesheet">
    <link href="../Assets/inspinia/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <link href="../Assets/inspinia/css/style.css" rel="stylesheet">
    <style>
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a[data-toggle="tab"]{cursor:pointer}
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a{
            color:#5f6f7f!important;
            font-weight:700;
            transition:color .2s ease,opacity .2s ease
        }
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a:hover,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a:focus{
            color:#1ab394!important;
            background:transparent!important
        }
        .landing-page.tabs-mode .navbar-default .navbar-nav>li.active>a,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li.active>a:hover,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li.active>a:focus,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a.active,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a.active:hover,
        .landing-page.tabs-mode .navbar-default .navbar-nav>li>a.active:focus{
            color:#1ab394!important;
            background:transparent!important;
            font-weight:700;
            opacity:1
        }
        .landing-tabs-summary{padding:30px 0 16px;text-align:center;background:#f7f9fb}
        .landing-tabs-summary p{max-width:760px;margin:0 auto;color:#6b7b8c}
        .landing-tabs-note{max-width:920px;margin:22px auto 0;padding:14px 18px;border-radius:14px;background:rgba(26,179,148,.08);color:#47677a;font-size:14px;line-height:1.7}
        .landing-tabs-shell{background:#f7f9fb;border-top:1px solid rgba(0,0,0,.04)}
        .landing-tabs-shell .tab-pane{display:none}
        .landing-tabs-shell .tab-pane.active{display:block}
        .landing-tab-panel{background:#fff;box-shadow:0 14px 36px rgba(31,45,61,.06)}
        .landing-tab-panel.gray-section,.landing-tab-panel.navy-section{box-shadow:none}
        .landing-tab-cta{padding:54px 0 70px;text-align:center}
        .landing-tab-cta .btn{margin:8px 6px 0}
        .tabs-mode .landing-tabs-shell{transition:padding-top .25s ease}
        .tabs-mode #inSlider .carousel-caption{padding-top:120px;padding-bottom:90px}
        .tabs-mode #inSlider .carousel-caption h1{font-size:46px;line-height:1.04}
        .tabs-mode #inSlider .carousel-caption p{font-size:18px}
        .tabs-mode #inSlider .carousel-image img{max-width:82%}
        .tabs-mode #inSlider .header-back{min-height:520px}
        .tabs-mode:not(.tabs-home-active) #inSlider{display:none}
        .tabs-mode:not(.tabs-home-active) .landing-tabs-shell{padding-top:86px}
        @media (max-width:991px){
            .tabs-mode #inSlider .carousel-caption{padding-top:90px;padding-bottom:65px}
            .tabs-mode #inSlider .carousel-caption h1{font-size:34px}
            .tabs-mode #inSlider .header-back{min-height:420px}
            .tabs-mode:not(.tabs-home-active) .landing-tabs-shell{padding-top:74px}
        }
    </style>
</head>
