<script>
    $(document).ready(function () {
        function syncTabsHero(targetSelector) {
            var isHome = String(targetSelector || '#tab-home').toLowerCase() === '#tab-home';
            $('body').toggleClass('tabs-home-active', isHome);
        }

        function syncActiveMenu(targetSelector) {
            var target = String(targetSelector || '#tab-home').toLowerCase();
            $('#navbar-tabs li').removeClass('active');
            $('#navbar-tabs a[data-toggle="tab"]').removeClass('active');
            var $link = $('#navbar-tabs a[data-toggle="tab"]').filter(function () {
                return String($(this).attr('href') || '').toLowerCase() === target;
            }).first();
            if ($link.length) {
                $link.addClass('active');
                $link.parent('li').addClass('active');
            }
        }

        var initialTarget = $('.tab-content .tab-pane.active').attr('id') ? '#' + $('.tab-content .tab-pane.active').attr('id') : '#tab-home';
        syncTabsHero(initialTarget);
        syncActiveMenu(initialTarget);

        $('a[data-toggle="tab"]').on('shown.bs.tab', function () {
            var target = $(this).attr('href') || '#tab-home';
            syncTabsHero(target);
            syncActiveMenu(target);
            $("#navbar-tabs").collapse('hide');
            $('html, body').stop().animate({ scrollTop: 0 }, 250);
        });
    });
    var cbpAnimatedHeader=(function(){var docElem=document.documentElement,header=document.querySelector('.navbar-default'),didScroll=false,changeHeaderOn=200;function init(){window.addEventListener('scroll',function(){if(!didScroll){didScroll=true;setTimeout(scrollPage,250)}},false)}function scrollPage(){var sy=window.pageYOffset||docElem.scrollTop;if(sy>=changeHeaderOn){$(header).addClass('navbar-scroll')}else{$(header).removeClass('navbar-scroll')}didScroll=false}init()})();
    new WOW().init();
</script>
</body>
