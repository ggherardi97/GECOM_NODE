  function getExtFromName(fileName) {
    const n = String(fileName || "");
    const idx = n.lastIndexOf(".");
    if (idx <= 0 || idx >= n.length - 1) return null;
    return n.substring(idx + 1).toLowerCase();
  }

  function defaultDisplayNameFor(file) {
    return String(file?.name || "").trim() || "Arquivo";
  }

  function showProcDocNotice(message, tone, autoHideMs) {
    const $el = $("#procDocNotice");
    if (!$el.length) return;
    if (state.procDocNoticeTimer) {
      clearTimeout(state.procDocNoticeTimer);
      state.procDocNoticeTimer = null;
    }
    $el.removeClass("alert-info alert-success alert-warning");
    if (tone === "success") $el.addClass("alert-success");
    else if (tone === "warning") $el.addClass("alert-warning");
    else $el.addClass("alert-info");
    $el.stop(true, true).html(message || "").fadeIn(120);

    const duration = Number.isFinite(Number(autoHideMs)) ? Number(autoHideMs) : 4200;
    if (duration > 0) {
      state.procDocNoticeTimer = setTimeout(function () {
        $el.fadeOut(220);
        state.procDocNoticeTimer = null;
      }, duration);
    }
  }

  function addDraftFileItem(file, forcedName) {
    const totalNow = countTotalPendingFileUploads();
    if (totalNow >= 5) throw new Error("Máximo de 5 arquivos no total.");

    const baseName = String(forcedName || "").trim() || defaultDisplayNameFor(file);
    state.procDocDraftItems.push({
      temp_id: nextDraftTempId(),
      parent_temp_id: state.procDocCurrentParentTempId,
      item_type: "FILE",
      name: baseName,
      filename: file?.name || baseName,
      ext: getExtFromName(file?.name || ""),
      mime_type: file?.type || "application/octet-stream",
      file
    });

    renderDraftList();
  }

  function pickFirst(selectors) {
    for (const sel of selectors) {
      const el = document.querySelector(sel);
      if (el) return el;
    }
    return null;
  }

  function replaceWithClone(el) {
    if (!el || !el.parentNode) return el;
    const clone = el.cloneNode(true);
    el.parentNode.replaceChild(clone, el);
    return clone;
  }

  function openSideModal(opts) {
    const overlay = pickFirst(["#dynamicModalOverlay", ".dynamic-modal-overlay"]);
    const modal = pickFirst(["#dynamicModal", ".dynamic-modal"]);
    const titleEl = pickFirst(["#dynamicModalTitle", ".dynamic-modal-title"]);
    const bodyEl = pickFirst(["#dynamicModalBody", ".dynamic-modal-body"]);
    let btnClose = pickFirst(["#dynamicModalCloseBtn", ".dynamic-modal-close"]);
    let btnCancel = pickFirst(["#dynamicModalCancelBtn", ".dynamic-modal-cancel"]);
    let btnOk = pickFirst(["#dynamicModalOkBtn", ".dynamic-modal-ok"]);

    if (!overlay || !modal || !titleEl || !bodyEl || !btnOk) {
      alert("Modal lateral não encontrado no layout.");
      return;
    }

    btnOk = replaceWithClone(btnOk);
    if (btnCancel) btnCancel = replaceWithClone(btnCancel);
    if (btnClose) btnClose = replaceWithClone(btnClose);

    titleEl.textContent = (opts?.title || "");
    bodyEl.innerHTML = (opts?.bodyHtml || "");
    if (btnCancel) btnCancel.textContent = (opts?.cancelText || "Cancelar");
    btnOk.textContent = (opts?.okText || "OK");

    function close() {
      overlay.style.display = "none";
      modal.style.display = "none";
    }

    btnOk.addEventListener("click", async function (e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      const keepOpen = (typeof opts?.onOk === "function") ? await opts.onOk() : false;
      if (!keepOpen) close();
    }, true);

    if (btnCancel) {
      btnCancel.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        close();
      }, true);
    }

    if (btnClose) {
      btnClose.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        close();
      }, true);
    }

    overlay.style.display = "block";
    modal.style.display = "block";

    if (typeof opts?.onOpen === "function") {
      setTimeout(() => {
        try { opts.onOpen(); } catch (_) {}
      }, 0);
    }
  }

