  async function createTransportsForProcess(processId) {
    const rows = readTransportRows();
    for (const transport of rows) {
      const createdTransport = await apiPost('/api/transports', {
        transport_company: transport.transport_company,
        origin: transport.origin,
        destination: transport.destination,
        contact_phone: transport.contact_phone,
        ship_id: transport.ship_id,
        transport_type_id: transport.transport_type_id,
        transport_status_id: transport.transport_status_id,
        departure_forecast: transport.departure_forecast,
        arrival_forecast: transport.arrival_forecast,
        process_id: processId
      });

      const transportId = String(createdTransport?.id || createdTransport?.transport_id || '').trim();
      const hasTracking = !!(transport.tracking_mode && transport.tracking_provider && transport.tracking_external_id);
      if (transportId && hasTracking) {
        await apiPut(`/api/transports/${encodeURIComponent(transportId)}/tracking/link`, {
          mode: transport.tracking_mode,
          provider: transport.tracking_provider,
          externalId: transport.tracking_external_id
        });
      }
    }
  }

