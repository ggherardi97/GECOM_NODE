  function collectTransportModalValues() {
    return {
      transport_company: String($('#transportModalCompany').val() || '').trim(),
      contact_phone: String($('#transportModalPhone').val() || '').trim() || null,
      origin: String($('#transportModalOrigin').val() || '').trim(),
      destination: String($('#transportModalDestination').val() || '').trim(),
      transport_type_id: String($('#transportModalType').val() || '').trim() || null,
      transport_status_id: String($('#transportModalStatus').val() || '').trim() || null,
      tracking_mode: String($('#transportModalTrackingMode').val() || '').trim() || null,
      tracking_provider: String($('#transportModalTrackingProvider').val() || '').trim() || null,
      tracking_external_id: String($('#transportModalTrackingExternalId').val() || '').trim() || null,
      ship_id: String($('#transportModalShipId').val() || '').trim() || null,
      departure_forecast: toIsoZFromBr(String($('#transportModalDeparture').val() || '').trim()) || null,
      arrival_forecast: toIsoZFromBr(String($('#transportModalArrival').val() || '').trim()) || null
    };
  }

  function applyTransportModalDefaults(rootEl) {
    const $root = rootEl ? $(rootEl) : $(document);
    const typeSelect = $root.find('#transportModalType');
    const trackingModeSelect = $root.find('#transportModalTrackingMode');
    const trackingProviderSelect = $root.find('#transportModalTrackingProvider');
    if (!typeSelect.length || !trackingModeSelect.length || !trackingProviderSelect.length) return;

    const applyDefaults = function () {
      const defaults = resolveTransportTrackingDefaults(typeSelect.val(), state.transportTypes);
      if (!defaults) return;
      trackingModeSelect.val(defaults.mode).trigger('change');
      trackingProviderSelect.val(defaults.provider).trigger('change');
    };

    typeSelect.off('change.transportDefaults').on('change.transportDefaults', applyDefaults);
    applyDefaults();
  }

  function openTransportSideModal(editIndex) {
    const isEdit = Number.isInteger(editIndex) && editIndex >= 0 && editIndex < state.transportRows.length;
    const current = isEdit ? state.transportRows[editIndex] : null;

    openSideModal({
      title: isEdit ? 'Editar transporte' : 'Adicionar transporte',
      okText: isEdit ? 'Salvar' : 'Criar',
      bodyHtml: buildTransportModalBody(current),
      onOpen: function () {
        const rootEl = document.getElementById('dynamicModalBody') || document.body;
        initDatePickers(rootEl);
        initCountriesTypeahead(rootEl);
        applyTransportModalDefaults(rootEl);
        if (!current?.departure_forecast) $('#transportModalDeparture').val('');
        if (!current?.arrival_forecast) $('#transportModalArrival').val('');
        if (!current?.ship_id) $('#transportModalShipId').val('');
      },
      onOk: async function () {
        const item = collectTransportModalValues();
        const error = validateTransportItem(item);
        if (error) {
          alert(error);
          return true;
        }

        if (isEdit) {
          state.transportRows[editIndex] = item;
        } else {
          state.transportRows.push(item);
        }

        renderTransportTable();
        return false;
      }
    });
  }

  function addTransportRow() {
    openTransportSideModal(null);
  }

  function deleteTransportRow(index) {
    const safeIndex = Number(index);
    if (!Number.isInteger(safeIndex) || safeIndex < 0 || safeIndex >= state.transportRows.length) return;

    const ok = confirm('Deseja excluir este transporte?');
    if (!ok) return;

