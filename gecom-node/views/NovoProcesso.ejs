  function normalizeTransportTypeToken(value) {
    const input = String(value || '').trim();
    if (!input) return '';
    try {
      return input.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();
    } catch {
      return input.toUpperCase();
    }
  }

  function resolveTransportTrackingDefaults(typeId, types) {
    const id = String(typeId || '').trim();
    if (!id) return null;

    const rows = Array.isArray(types) ? types : state.transportTypes;
    const match = rows.find((item) => String(item?.id || '').trim() === id);
    const token = normalizeTransportTypeToken(match?.name || match?.label || match?.code || '');

    if (!token) return null;
    if (token.includes('MARIT') || token.includes('SEA')) {
      return { mode: 'SEA', provider: 'MARINETRAFFIC' };
    }
    if (token.includes('AERE') || token.includes('AIR')) {
      return { mode: 'AIR', provider: 'FR24' };
    }

    return null;
  }

  function readTransportRows() {
    return Array.isArray(state.transportRows) ? state.transportRows : [];
  }

  function validateTransportItem(item) {
    if (!item.transport_company) return 'Preencha a companhia do transporte.';
    if (!item.origin) return 'Preencha a origem do transporte.';
    if (!item.destination) return 'Preencha o destino do transporte.';
    if (!item.transport_type_id) return 'Selecione o tipo de transporte.';
    if (!item.transport_status_id) return 'Selecione o status do transporte.';
    return null;
  }

  function validateTransportRows() {
    const rows = readTransportRows();
    if (!rows.length) return 'Adicione pelo menos 1 transporte.';
    const invalid = rows.find((row) => validateTransportItem(row));
    if (invalid) return validateTransportItem(invalid);
    return null;
  }

  function buildTransportModalBody(transport) {
    const types = Array.isArray(state.transportTypes) ? state.transportTypes : [];
    const statuses = Array.isArray(state.transportStatuses) ? state.transportStatuses : [];
    const trackingMode = String(transport?.tracking_mode || '').trim();
    const trackingProvider = String(transport?.tracking_provider || '').trim();
    const currentTypeId = String(transport?.transport_type_id || '').trim();
    const currentStatusId = String(transport?.transport_status_id || '').trim();
    const departureValue = transport?.departure_forecast ? new Date(transport.departure_forecast).toLocaleDateString('pt-BR') : '';
    const arrivalValue = transport?.arrival_forecast ? new Date(transport.arrival_forecast).toLocaleDateString('pt-BR') : '';
    const currentShipId = String(transport?.ship_id || '').trim();

    const typeOptions = ['<option value="">Selecionar...</option>']
      .concat(types.map((t) => {
        const id = String(t?.id ?? '');
        const label = String(t?.name ?? t?.type_name ?? t?.label ?? id);
        const selected = id === currentTypeId ? ' selected' : '';
        return `<option value="${escapeHtml(id)}"${selected}>${escapeHtml(label)}</option>`;
      }))
      .join('');

    const statusOptions = ['<option value="">Selecionar...</option>']
      .concat(statuses.map((s) => {
        const id = String(s?.id ?? '');
        const label = String(s?.name ?? s?.status_name ?? s?.label ?? id);
        const selected = id === currentStatusId ? ' selected' : '';
        return `<option value="${escapeHtml(id)}"${selected}>${escapeHtml(label)}</option>`;
      }))
      .join('');

    const trackingModeOptions = `
      <option value="">-</option>
      <option value="AIR"${trackingMode === 'AIR' ? ' selected' : ''}>AIR</option>
      <option value="SEA"${trackingMode === 'SEA' ? ' selected' : ''}>SEA</option>
    `;

    const trackingProviderOptions = `
      <option value="">-</option>
      <option value="FR24"${trackingProvider === 'FR24' ? ' selected' : ''}>FR24</option>
      <option value="MARINETRAFFIC"${trackingProvider === 'MARINETRAFFIC' ? ' selected' : ''}>Marine Traffic</option>
    `;

    return `
      <div class="form-group">
        <label for="transportModalCompany">Transportadora</label>
        <input id="transportModalCompany" type="text" class="form-control" value="${escapeHtml(transport?.transport_company || '')}" />
      </div>

      <div class="form-group">
        <label for="transportModalPhone">Telefone de contato</label>
        <input id="transportModalPhone" type="text" class="form-control phone-mask" value="${escapeHtml(transport?.contact_phone || '')}" placeholder="(11) 99999-9999" />
      </div>

      <div class="form-group">
        <label for="transportModalOrigin">Origem</label>
        <input id="transportModalOrigin" type="text" class="form-control autocompleteCountry" value="${escapeHtml(transport?.origin || '')}" placeholder="País de origem" autocomplete="off" />
      </div>

      <div class="form-group">
        <label for="transportModalDestination">Destino</label>
        <input id="transportModalDestination" type="text" class="form-control autocompleteCountry" value="${escapeHtml(transport?.destination || '')}" placeholder="País de destino" autocomplete="off" />
      </div>

      <div class="form-group">
        <label for="transportModalType">Tipo de transporte</label>
        <select id="transportModalType" class="form-control transport-modal-type">${typeOptions}</select>
      </div>

      <div class="form-group">
        <label for="transportModalStatus">Status do transporte</label>
        <select id="transportModalStatus" class="form-control transport-modal-status">${statusOptions}</select>
      </div>

      <div class="form-group">
        <label for="transportModalTrackingMode">Tracking mode</label>
        <select id="transportModalTrackingMode" class="form-control transport-modal-tracking-mode">${trackingModeOptions}</select>
      </div>

      <div class="form-group">
        <label for="transportModalTrackingProvider">Tracking provider</label>
        <select id="transportModalTrackingProvider" class="form-control transport-modal-tracking-provider">${trackingProviderOptions}</select>
      </div>

      <div class="form-group">
        <label for="transportModalTrackingExternalId">Tracking IMO/MMSI</label>
        <input id="transportModalTrackingExternalId" type="text" class="form-control" value="${escapeHtml(transport?.tracking_external_id || '')}" placeholder="IMO ou MMSI do navio" />
      </div>

      <div class="form-group">
        <label for="transportModalShipId">Ship ID</label>
        <input id="transportModalShipId" type="text" class="form-control" value="${escapeHtml(currentShipId)}" placeholder="SHIP_ID do MarineTraffic" />
      </div>

      <div class="form-group">
        <label for="transportModalDeparture">Previsão de embarque</label>
        <input id="transportModalDeparture" type="text" class="form-control datepicker" value="${escapeHtml(departureValue)}" />
      </div>

      <div class="form-group">
        <label for="transportModalArrival">Previsão de chegada</label>
        <input id="transportModalArrival" type="text" class="form-control datepicker" value="${escapeHtml(arrivalValue)}" />
      </div>
    `;
