  function normalizeTransportTypeToken(value) {
    const input = String(value || "").trim();
    if (!input) return "";
    try {
      return input.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();
    } catch {
      return input.toUpperCase();
    }
  }

  function resolveTransportTrackingDefaults(typeId) {
    const id = String(typeId || "").trim();
    if (!id) return null;

    const match = state.transportTypes.find((item) => String(item?.id || "").trim() === id);
    const token = normalizeTransportTypeToken(match?.name || match?.label || match?.code || "");

    if (!token) return null;
    if (token.includes("MARIT") || token.includes("SEA")) {
      return { mode: "SEA", provider: "MARINETRAFFIC" };
    }
    if (token.includes("AERE") || token.includes("AIR")) {
      return { mode: "AIR", provider: "FR24" };
    }

    return null;
  }

  function applyTransportTrackingDefaults(rowId) {
    const typeSelect = document.getElementById(`${rowId}_type`);
    const modeSelect = document.getElementById(`${rowId}_tracking_mode`);
    const providerSelect = document.getElementById(`${rowId}_tracking_provider`);
    if (!typeSelect || !modeSelect || !providerSelect) return;

    const defaults = resolveTransportTrackingDefaults(typeSelect.value);
    if (!defaults) return;

    $(modeSelect).val(defaults.mode).trigger("change");
    $(providerSelect).val(defaults.provider).trigger("change");
  }

  function addTransportRow() {
    const tbody = document.getElementById("transportsTbody");
    if (!tbody) return;

    const rowId = `trow_${++state.transportSeq}`;
    tbody.insertAdjacentHTML("beforeend", buildTransportRow(rowId));

    const tr = tbody.querySelector(`tr[data-row-id="${CSS.escape(rowId)}"]`);
    if (!tr) return;

    initDatePickers(tr);
    const $typeSelect = $(tr).find("select.transport-type");
    initSelect2($typeSelect, "Selecionar...", null);
    initSelect2($(tr).find("select.transport-status"), "Selecionar...", null);
    initSelect2($(tr).find("select.transport-tracking-mode"), "Selecionar...", null);
    initSelect2($(tr).find("select.transport-tracking-provider"), "Selecionar...", null);
    $typeSelect.off("change.transportDefaults").on("change.transportDefaults", function () {
      applyTransportTrackingDefaults(rowId);
    });

    // OK: typeahead align fix per row
    initCountriesTypeahead(tr);
  }

