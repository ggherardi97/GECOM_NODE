  function removeDraftItemRecursive(tempId) {
    const children = state.procDocDraftItems.filter((item) => item.parent_temp_id === tempId);
    children.forEach((child) => removeDraftItemRecursive(child.temp_id));
    state.procDocDraftItems = state.procDocDraftItems.filter((item) => item.temp_id !== tempId);
  }

  function renderDraftList() {
    const $list = $("#procDocDraftList");
    if (!$list.length) return;
    $list.empty();

    const rows = getDraftItemsByParent(state.procDocCurrentParentTempId).slice().sort((a, b) => {
      const ta = String(a?.item_type || "").toUpperCase();
      const tb = String(b?.item_type || "").toUpperCase();
      if (ta === "FOLDER" && tb !== "FOLDER") return -1;
      if (ta !== "FOLDER" && tb === "FOLDER") return 1;
      return String(a?.name || "").localeCompare(String(b?.name || ""), "pt-BR", { sensitivity: "base" });
    });
    if (!rows.length) {
      $list.append('<li class="list-group-item text-muted">Nenhum item criado nesta pasta.</li>');
      updateProcDocFolderUi();
      return;
    }

    rows.forEach((item) => {
      const isFolder = String(item.item_type).toUpperCase() === "FOLDER";
      const icon = isFolder ? "fa-folder" : (String(item.item_type).toUpperCase() === "LINK" ? "fa-link" : "fa-file-o");
      const isLink = String(item.item_type).toUpperCase() === "LINK";
      const subtitle = isFolder
        ? "Pasta"
        : (isLink
          ? `Link: ${item.object_key || ""}`
          : `Arquivo: ${item.filename || item.name || ""}`);
      const statusBadge = isFolder
        ? '<span class="label label-default">Pasta</span>'
        : (isLink
          ? '<span class="label label-info">Link</span>'
          : '<span class="label label-warning">Pendente envio</span>');

      const openBtn = isFolder
        ? `<button type="button" class="btn btn-xs btn-white btn-proc-doc-open" data-id="${escapeHtml(item.temp_id)}"><i class="fa fa-folder-open"></i> Abrir</button>`
        : "";

      $list.append(`
        <li class="list-group-item">
          <div>
            <strong><i class="fa ${icon}"></i> ${escapeHtml(item.name || "Sem nome")}</strong>
            <div class="small text-muted proc-doc-item-sub">${escapeHtml(subtitle)}</div>
            <div class="proc-doc-item-sub">${statusBadge}</div>
          </div>
          <div class="proc-doc-list-actions">
            ${openBtn}
            <button type="button" class="btn btn-xs btn-white btn-proc-doc-rename" data-id="${escapeHtml(item.temp_id)}"><i class="fa fa-pencil"></i></button>
            <button type="button" class="btn btn-xs btn-danger btn-proc-doc-remove" data-id="${escapeHtml(item.temp_id)}"><i class="fa fa-trash"></i></button>
          </div>
        </li>
      `);
    });

    updateProcDocFolderUi();
  }

