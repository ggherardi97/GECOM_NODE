  async function loadProcessStatusConfigs() {
    try {
      const data = await apiGet("/api/status-configs?entity=PROCESS&active=true");
      const list = listToArray(data);
      state.processStatusConfigs = list
        .map((row) => ({
          id: String(row?.id || "").trim(),
          label: String(row?.label || "").trim(),
          color: String(row?.color || "").trim(),
          legacy: Number(row?.legacy_int_value),
          sort: Number(row?.sort_order || 0),
        }))
        .filter((x) => x.id && x.label)
        .sort((a, b) => (a.sort - b.sort) || String(a.label).localeCompare(String(b.label), "pt-BR"));
    } catch (e) {
      console.warn("loadProcessStatusConfigs fallback:", e);
      state.processStatusConfigs = [];
    }

    state.processStatusByLegacy = new Map();
    state.processStatusConfigs.forEach((cfg) => {
      if (!Number.isFinite(cfg.legacy)) return;
      if (!state.processStatusByLegacy.has(cfg.legacy)) state.processStatusByLegacy.set(cfg.legacy, cfg);
    });
  }

  function pickDefaultProcessStatusConfig() {
    if (!Array.isArray(state.processStatusConfigs) || state.processStatusConfigs.length === 0) return null;
    return (
      state.processStatusByLegacy.get(0)?.id ||
      state.processStatusByLegacy.get(1)?.id ||
      state.processStatusConfigs[0]?.id ||
      null
    );
  }

  function pickLegacyStatusByConfigId(statusConfigId) {
    const id = String(statusConfigId || "").trim();
    if (!id) return null;
    const cfg = state.processStatusConfigs.find((x) => x.id === id);
    return Number.isFinite(cfg?.legacy) ? Number(cfg.legacy) : null;
  }

  // =========================
