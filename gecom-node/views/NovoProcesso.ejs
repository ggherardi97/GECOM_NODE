<% %>

<div class="wrapper wrapper-content animated fadeInRight" style="margin-top: 0px;">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Novo Processo</h5>
          <div class="ibox-tools"></div>
        </div>

        <div class="ibox-content">
          <p>Preencha as informações do processo e seus transportes.</p>

          <form id="form" action="#" class="wizard-big" onsubmit="return false;">
            <!-- STEP 1 -->
            <h1>Detalhes</h1>
            <fieldset>
              <div class="row">
                <div class="col-lg-9">
                  <div class="row">
                    <div class="form-group col-lg-6">
                      <label>Nº do Processo *</label>
                      <input id="process_number" type="text" class="form-control" placeholder="Preenchido pelo sistema." readonly>
                    </div>

                    <div class="form-group col-lg-6">
                      <label>Empresa *</label>
                      <select id="company_id" class="form-control required"></select>
                    </div>
                  </div>

                  <div class="row">
                    <div class="form-group col-lg-6">
                      <label>Invoice relacionado</label>
                      <select id="invoice" class="form-control"></select>
                      <div class="muted" id="invoiceHelp" style="margin-top:4px; display:none;">
                        Selecione uma empresa para listar as invoices.
                      </div>
                    </div>

                    <div class="form-group col-lg-6">
                      <label>Previsão de Entrega</label>
                      <div class="input-group date">
                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                        <input id="ship_date" type="text" class="form-control datepicker" autocomplete="off">
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="form-group col-lg-6">
                      <label>Tipo de Processo</label>
                      <select id="process_type_id" class="form-control"></select>
                    </div>

                    <div class="form-group col-lg-6">
                      <label>Contato do Cliente</label>
                      <select id="primary_contact_id" class="form-control"></select>
                      <div class="muted" id="contactHelp" style="margin-top:4px; display:none;">
                        Selecione uma empresa para listar os contatos.
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="form-group col-lg-6">
                      <label>Valor total do processo</label>
                      <input id="total_value" type="text" class="form-control currency-brl" placeholder="R$ 0,00" autocomplete="off">
                    </div>
                    <div class="form-group col-lg-6"></div>
                  </div>
                </div>

                <div class="col-lg-3">
                  <div class="text-center">
                    <div style="margin-top: 20px">
                      <i class="fa fa-suitcase" style="font-size: 180px; color: #e5e5e5"></i>
                    </div>
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- STEP 2 -->
            <h1>Transportes</h1>
            <fieldset>
              <div class="transport-toolbar">
                <div>
                  <strong>Transportes do processo</strong>
                  <div class="muted">Adicione um ou mais transportes relacionados a este processo.</div>
                </div>
                <div>
                  <button type="button" class="btn btn-primary btn-xs2" id="btnAddTransport">
                    <i class="fa fa-plus"></i> Adicionar transporte
                  </button>
                </div>
              </div>

              <div class="table-responsive" style="height: 435px !important;">
                <table class="table table-bordered table-striped transport-table">
                  <thead>
                    <tr>
                      <th style="min-width:160px;">Companhia *</th>
                      <th style="min-width:140px;">Telefone</th>
                      <th style="min-width:160px;">Origem *</th>
                      <th style="min-width:160px;">Destino *</th>
                      <th style="min-width:170px;">Tipo *</th>
                      <th style="min-width:170px;">Status *</th>
                      <th style="min-width:120px;">Tracking Modo</th>
                      <th style="min-width:150px;">Tracking Provider</th>
                      <th style="min-width:160px;">Tracking IMO/MMSI</th>
                      <th style="min-width:150px;">Ship ID</th>
                      <th style="min-width:150px;">Previsão Embarque</th>
                      <th style="min-width:150px;">Previsão Chegada</th>
                      <th style="width:70px;" class="text-center">Ações</th>
                    </tr>
                  </thead>
                  <tbody id="transportsTbody"></tbody>
                </table>
              </div>

              <div class="alert alert-warning" id="transportWarning" style="display:none; margin-top:10px;"></div>
            </fieldset>

            <!-- STEP 3 -->
            <h1>Documentos</h1>
            <fieldset class="proc-doc-fieldset">
              <h3>Documentos do processo</h3>
              <p class="muted">Crie pastas, links e documentos. Tudo será associado à pasta do processo ao finalizar.</p>

              <div class="proc-doc-toolbar">
                <button type="button" class="btn btn-default btn-xs" id="btnProcDocBack" style="display:none;">
                  <i class="fa fa-arrow-left"></i> Voltar pasta
                </button>
                <div class="btn-group">
                  <button data-toggle="dropdown" class="btn btn-primary btn-xs dropdown-toggle">
                    <i class="fa fa-plus"></i> Adicionar <span class="caret"></span>
                  </button>
                  <ul class="dropdown-menu">
                    <li><a href="#" id="btnProcNewFolder"><i class="fa fa-folder"></i> Nova pasta</a></li>
                    <li><a href="#" id="btnProcUploadDoc"><i class="fa fa-upload"></i> Upload documento</a></li>
                    <li><a href="#" id="btnProcNewLink"><i class="fa fa-link"></i> Link</a></li>
                  </ul>
                </div>
                <span class="proc-doc-breadcrumb" id="procDocCurrentFolder">Raiz do processo</span>
              </div>

              <div class="proc-doc-panel">
                <div class="proc-doc-summary">
                  <div class="proc-doc-summary-main" id="procDocSummary">
                    Você está em <strong>Raiz do processo</strong>.
                  </div>
                  <div class="proc-doc-summary-badge" id="procDocPendingFiles">0/5 arquivos pendentes</div>
                </div>

                <button type="button" class="btn btn-primary" id="btnPickProcDocs">
                  <i class="fa fa-paperclip"></i> Selecionar arquivos
                </button>

                <div class="alert alert-info" id="procDocNotice" style="display:none; margin-top:10px; margin-bottom:10px;"></div>

                <div class="dropzone dz-clickable" id="dropzoneForm" style="margin-top:10px;display:none !important">
                  <div class="dz-default dz-message">
                    <span>
                      <strong>Arraste arquivos aqui</strong><br>
                      <span class="muted">Máximo 5 arquivos no total.</span>
                    </span>
                  </div>
                </div>

                <div id="procDocUploadProgress" style="display:none; margin-top: 6px;">
                  <div class="progress progress-striped active" style="margin-bottom:6px;">
                    <div id="procDocUploadProgressBar" class="progress-bar" style="width: 0%"></div>
                  </div>
                  <small id="procDocUploadProgressText" class="text-muted"></small>
                </div>

                <div class="small text-muted" style="margin: 10px 0 6px 0;">Itens na pasta atual</div>
                <ul class="list-group proc-doc-draft-list" id="procDocDraftList">
                  <li class="list-group-item text-muted">Nenhum item criado nesta pasta.</li>
                </ul>
              </div>

            </fieldset>

          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<% contentFor('scripts') %>
<script src="../Assets/inspinia/js/plugins/steps/jquery.steps.min.js"></script>
<script src="../Assets/inspinia/js/plugins/validate/jquery.validate.min.js"></script>
<script src="../Assets/inspinia/js/plugins/iCheck/icheck.min.js"></script>
<script src="../Assets/inspinia/js/plugins/select2/select2.full.min.js"></script>
<script src="../Assets/inspinia/js/plugins/datapicker/bootstrap-datepicker.js"></script>
<script src="../Assets/inspinia/js/plugins/typehead/bootstrap3-typeahead.min.js"></script>
<script src="../Assets/inspinia/js/plugins/dropzone/dropzone.js"></script>

<script>
(function () {
  // =========================
  // State
  // =========================
  const state = {
    processId: null,
    creating: false,
    companies: [],
    invoices: [],
    processTypes: [],
    users: [],
    transportTypes: [],
    transportStatuses: [],
    processStatusConfigs: [],
    processStatusByLegacy: new Map(),
    companiesById: new Map(),
    transportRows: [],
    transportEditIndex: null,
    transportSeq: 0,

    // Step 3 (documents)
    __procDzInitialized: false,
    procDocDz: null,
    procDocDraftItems: [],
    procDocDraftSeq: 0,
    procDocCurrentParentTempId: null,
    procDocNavStack: [],
    procDocNoticeTimer: null,
  };

  // =========================
  // Helpers
  // =========================
  function escapeHtml(value) {
    if (value == null) return "";
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  async function readJsonSafe(resp) {
    const text = await resp.text().catch(() => "");
    if (!text) return {};
    try { return JSON.parse(text); } catch { return { message: text }; }
  }

  async function apiGet(url) {
    const resp = await fetch(url, { method: "GET", headers: { "Accept": "application/json" } });
    const data = await readJsonSafe(resp);
    if (!resp.ok) throw new Error(data?.message || "Falha na requisição.");
    return data;
  }

  async function apiPost(url, payload) {
    const resp = await fetch(url, {
      method: "POST",
      headers: { "Accept": "application/json", "Content-Type": "application/json" },
      body: JSON.stringify(payload || {})
    });
    const data = await readJsonSafe(resp);
    if (!resp.ok) throw new Error(data?.message || "Falha ao salvar.");
    return data;
  }

  async function apiPut(url, payload) {
    const resp = await fetch(url, {
      method: "PUT",
      headers: { "Accept": "application/json", "Content-Type": "application/json" },
      body: JSON.stringify(payload || {})
    });
    const data = await readJsonSafe(resp);
    if (!resp.ok) throw new Error(data?.message || "Falha ao salvar.");
    return data;
  }

  function parseUnsupportedProcessFieldsFromError(err) {
    const msg = String(err?.message || "").toLowerCase();
    const unsupported = [];
    if (!msg) return unsupported;
    if (msg.includes("total_value") && msg.includes("should not exist")) unsupported.push("total_value");
    if (msg.includes("status_config_id") && msg.includes("should not exist")) unsupported.push("status_config_id");
    if (msg.includes("related_table") && msg.includes("should not exist")) unsupported.push("related_table");
    if (msg.includes("related_id") && msg.includes("should not exist")) unsupported.push("related_id");
    return unsupported;
  }

  function stripUnsupportedProcessFields(payload, err) {
    const unsupported = parseUnsupportedProcessFieldsFromError(err);
    if (!unsupported.length) return null;
    const next = { ...(payload || {}) };
    unsupported.forEach((field) => { delete next[field]; });
    return next;
  }

  function isUuidLike(value) {
    return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(value || "").trim());
  }

  function normalizeLooseText(value) {
    return String(value || "")
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");
  }

  function resolveProcessTypeIdFromUi() {
    const $ddl = $("#process_type_id");
    const rawValue = String($ddl.val() || "").trim();
    if (isUuidLike(rawValue)) return rawValue;

    const selectedValue = String($ddl.find("option:selected").val() || "").trim();
    if (isUuidLike(selectedValue)) return selectedValue;

    const selectedText = String($ddl.find("option:selected").text() || "").trim();
    if (selectedText) {
      const byName = (state.processTypes || []).find((item) => (
        normalizeLooseText(item?.name) === normalizeLooseText(selectedText) ||
        normalizeLooseText(item?.name) === normalizeLooseText(rawValue)
      ));
      if (byName?.id) return String(byName.id).trim();
    }

    return rawValue;
  }

  function validateProcessCreateFields() {
    const companyId = String($("#company_id").val() || "").trim();
    const processTypeId = resolveProcessTypeIdFromUi();

    if (!companyId || !isUuidLike(companyId)) {
      return "Selecione uma empresa válida antes de criar o processo.";
    }

    if (!processTypeId || !isUuidLike(processTypeId)) {
      return "Selecione um tipo de processo válido antes de criar o processo.";
    }

    return null;
  }

  function collectProcessCreatePayload() {
    const companyId = String($("#company_id").val() || "").trim();
    const processTypeId = resolveProcessTypeIdFromUi();
    const invoice = String($("#invoice").val() || "").trim();
    const primaryContactId = String($("#primary_contact_id").val() || "").trim();
    const shipDate = toIsoZFromBr(String($("#ship_date").val() || "").trim());
    const totalValue = parseCurrencyPtBr($("#total_value").val());
    const payload = {
      company_id: companyId,
      process_type_id: processTypeId,
    };

    if (invoice) payload.invoice = invoice;
    if (primaryContactId) payload.primary_contact_id = primaryContactId;
    if (shipDate) payload.ship_date = shipDate;
    if (Number.isFinite(totalValue)) payload.total_value = totalValue;

    const statusConfigId = pickDefaultProcessStatusConfig();
    if (statusConfigId) payload.status_config_id = statusConfigId;

    return payload;
  }

  async function ensureProcessCreated() {
    if (state.processId) return state.processId;
    if (state.creating) return state.processId;

    state.creating = true;
    try {
      const validationError = validateProcessCreateFields();
      if (validationError) {
        throw new Error(validationError);
      }

      const payload = collectProcessCreatePayload();
      let createdProcess;

      try {
        createdProcess = await apiPost("/api/processes", payload);
      } catch (error) {
        const strippedPayload = stripUnsupportedProcessFields(payload, error);
        if (!strippedPayload) throw error;
        createdProcess = await apiPost("/api/processes", strippedPayload);
      }

      const processId = String(createdProcess?.id || createdProcess?.process_id || "").trim();
      if (!processId) {
        throw new Error("O processo foi criado, mas não retornou ID.");
      }

      state.processId = processId;
      const processNumber = String(createdProcess?.process_number || createdProcess?.processNumber || "").trim();
      if (processNumber) {
        $("#process_number").val(processNumber);
      }

      return processId;
    } finally {
      state.creating = false;
    }
  }

  function parseDateBr(value) {
    const text = (value || "").trim();
    const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(text);
    if (!match) return null;

    const day = Number(match[1]);
    const month = Number(match[2]);
    const year = Number(match[3]);

    const date = new Date(year, month - 1, day);
    if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) return null;
    return date;
  }

  function toIsoZFromBr(value) {
    const d = parseDateBr(value);
    if (!d) return null;
    const utc = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate(), 0, 0, 0, 0));
    return utc.toISOString();
  }

  function applyBrazilPhoneMask(rawValue) {
    const digits = String(rawValue || "").replace(/\D/g, "").slice(0, 11);
    const ddd = digits.slice(0, 2);
    const isMobile = digits.length > 10;

    const part1 = isMobile ? digits.slice(2, 7) : digits.slice(2, 6);
    const part2 = isMobile ? digits.slice(7, 11) : digits.slice(6, 10);

    if (!digits) return "";
    if (digits.length <= 2) return `(${ddd}`;
    if (digits.length <= 6) return `(${ddd}) ${digits.slice(2)}`;
    if (digits.length <= 10) return `(${ddd}) ${part1}-${part2}`.replace(/-$/, "");
    return `(${ddd}) ${part1}-${part2}`;
  }

  function parseCurrencyPtBr(value) {
    const raw = String(value || "").trim();
    if (!raw) return null;

    const cleaned = raw.replace(/[^\d,.-]/g, "");
    if (!cleaned) return null;

    let normalized = cleaned;
    const hasComma = normalized.includes(",");
    const hasDot = normalized.includes(".");

    if (hasComma && hasDot) {
      normalized = normalized.replace(/\./g, "").replace(",", ".");
    } else if (hasComma) {
      normalized = normalized.replace(",", ".");
    } else {
      normalized = normalized.replace(/\.(?=\d{3}(\D|$))/g, "");
    }

    const n = Number(normalized);
    return Number.isFinite(n) ? n : null;
  }

  function formatCurrencyBrl(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return "";
    return new Intl.NumberFormat("pt-BR", {
      style: "currency",
      currency: "BRL",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(n);
  }

  function formatDecimalPtBr(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return "";
    return new Intl.NumberFormat("pt-BR", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(n);
  }

  function initCurrencyInputMask($el) {
    if (!$el || !$el.length) return;
    if ($el.data("currency-mask-initialized")) return;
    $el.data("currency-mask-initialized", true);

    function applyMask(inputEl) {
      const digits = String(inputEl.value || "").replace(/\D/g, "");
      if (!digits) {
        inputEl.value = "";
        return;
      }
      const n = Number(digits) / 100;
      if (!Number.isFinite(n)) {
        inputEl.value = "";
        return;
      }
      inputEl.value = formatCurrencyBrl(n);
    }

    $el.on("focus", function () {
      // Mantém a máscara visível durante a digitação.
      if ($(this).val()) applyMask(this);
    });

    $el.on("input", function () {
      applyMask(this);
    });

    $el.on("blur", function () {
      if ($(this).val()) applyMask(this);
    });

    if ($el.val()) applyMask($el.get(0));
  }

  function applyCurrencyBrlMaskInput(inputEl) {
    if (!inputEl) return;
    const digits = String(inputEl.value || "").replace(/\D/g, "");
    if (!digits) {
      inputEl.value = "";
      return;
    }
    const n = Number(digits) / 100;
    if (!Number.isFinite(n)) {
      inputEl.value = "";
      return;
    }
    inputEl.value = formatCurrencyBrl(n);
  }

  function listToArray(data) {
    if (Array.isArray(data)) return data;
    if (Array.isArray(data?.data)) return data.data;
    if (Array.isArray(data?.rows)) return data.rows;
    if (Array.isArray(data?.items)) return data.items;
    return [];
  }

  document.addEventListener("input", function (ev) {
    const target = ev.target;
    if (!target) return;
    if (target.classList.contains("phone-mask")) {
      target.value = applyBrazilPhoneMask(target.value);
      return;
    }
    if (target.classList.contains("currency-brl")) {
      applyCurrencyBrlMaskInput(target);
    }
  }, true);

  document.addEventListener("focusout", function (ev) {
    const target = ev.target;
    if (!target) return;
    if (target.classList.contains("currency-brl")) {
      applyCurrencyBrlMaskInput(target);
    }
  }, true);

  // =========================
  // UI init
  // =========================
  function initDatePickers(scope) {
    const $scope = scope ? $(scope) : $(document);

    $scope.find(".datepicker").each(function () {
      const $input = $(this);
      if ($input.data("datepicker")) return;

      $input.datepicker({
        todayBtn: "linked",
        keyboardNavigation: false,
        forceParse: false,
        calendarWeeks: true,
        autoclose: true,
        format: "dd/mm/yyyy",
        container: "body"
      });

      if (!String($input.val() || "").trim()) {
        const now = new Date();
        const dd = String(now.getDate()).padStart(2, "0");
        const mm = String(now.getMonth() + 1).padStart(2, "0");
        const yyyy = now.getFullYear();
        $input.val(`${dd}/${mm}/${yyyy}`);
      }
    });
  }

  function initSelect2($el, placeholder, dropdownParent) {
    if (!$el || !$el.length) return;
    if (!$.fn.select2) return;

    if ($el.hasClass("select2-hidden-accessible") || $el.data("select2")) {
      try { $el.select2("destroy"); } catch (_) { }
    }
    $el.siblings(".select2").remove();

    const parent = dropdownParent || $(document.body);
    $el.select2({
      width: "100%",
      theme: "bootstrap",
      placeholder: placeholder || "Selecionar...",
      allowClear: true,
      minimumResultsForSearch: 0,
      language: "pt-BR",
      dropdownParent: parent
    });
  }

  function setSelectDisabled(selectId, disabled) {
    const el = document.getElementById(selectId);
    if (!el) return;
    el.disabled = !!disabled;

    const $el = $(el);
    const $container = $el.next(".select2");
    if ($container && $container.length) {
      if (disabled) $container.addClass("readonly-select2");
      else $container.removeClass("readonly-select2");
    }
  }

