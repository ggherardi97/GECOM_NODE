<style>
  .ibox-title {
    padding: 15px 90px 20px 15px;
  }

  .wizard-big.wizard > .content {
    min-height: 620px !important;
    overflow: visible !important;
  }

  .wizard > .content > .body {
    float: left;
    position: absolute;
    width: 100% !important;
    height: auto !important;
    min-height: 560px;
    padding: 18px 16px 10px;
    overflow-y: visible !important;
  }
  .muted {
    color: #888;
    font-size: 12px;
  }

  .select2-container {
    background-color: white;
    box-sizing: border-box;
    display: inline-block;
    margin: 0;
    position: relative;
    vertical-align: middle;
    padding: 3px;
    border: 1px solid #c0c0c0;
  }

  .transport-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .transport-table th, .transport-table td {
    vertical-align: middle !important;
  }

  .transport-table td {
    position: relative;
  }

  .table-responsive {
    overflow-y: visible !important;
  }

  .btn-xs2 {
    padding: 4px 8px;
    font-size: 12px;
    line-height: 1.2;
  }

  .readonly-select2 .select2-selection {
    background: #eee !important;
    cursor: not-allowed !important;
  }

  .select2-selection__clear{
    padding-right: 10px;
  }

  .select2-container--open,
  .select2-dropdown {
    z-index: 1000001 !important;
  }

  /* Fix: typeahead dropdown position/z-index inside wizard/table */
  .typeahead.dropdown-menu {
    z-index: 1000001 !important;
    max-height: 240px;
    overflow-y: auto;
  }

  .transport-table td .typeahead.dropdown-menu {
    left: 0 !important;
    top: calc(100% + 2px) !important;
    min-width: 100%;
    max-width: 100%;
  }

  /* Dropzone usability */
  #dropzoneForm {
    min-height: 160px;
    cursor: pointer;
  }

  .dz-message .btn {
    margin-top: 10px;
  }

  .proc-doc-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .proc-doc-breadcrumb {
    font-size: 12px;
    color: #777;
    padding: 3px 8px;
    border-radius: 999px;
    background: #f4f6f8;
  }

  .proc-doc-draft-list .list-group-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .proc-doc-draft-list {
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  .proc-doc-draft-list > li {
    list-style: none;
  }

  .proc-doc-panel {
    border: 1px solid #e5e6e7;
    border-radius: 6px;
    background: #fff;
    padding: 14px;
    margin-top: 12px;
  }

  .proc-doc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .proc-doc-summary-main {
    font-size: 13px;
    color: #4a4a4a;
  }

  .proc-doc-summary-badge {
    background: #e7f7f4;
    color: #0b8f77;
    border: 1px solid #b7ece2;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }

  #dropzoneForm {
    border: 2px dashed #9bcad9;
    border-radius: 8px;
    background: linear-gradient(180deg, #f9fdff 0%, #f4f8fb 100%);
    min-height: 84px;
    cursor: pointer;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  #dropzoneForm.dz-drag-hover {
    border-color: #17a689;
    background: #f0fbf8;
  }

  #dropzoneForm .dz-message {
    margin: 0;
    text-align: center;
    padding: 10px 8px;
    line-height: 1.25;
  }

  #dropzoneForm .dz-message strong {
    font-size: 21px;
  }

  #dropzoneForm .dz-message .muted {
    display: inline-block;
    margin-top: 4px;
  }

  #procDocNotice {
    padding: 8px 12px;
    margin-top: 8px !important;
    margin-bottom: 8px !important;
  }

  .proc-doc-list-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .proc-doc-list-actions .btn {
    margin: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
  }

  .proc-doc-draft-list .list-group-item {
    padding: 10px 12px;
  }

  .proc-doc-panel .btn.btn-xs {
    min-width: 30px;
  }

  @media (max-width: 768px) {
    .wizard-big.wizard > .content {
      min-height: 700px !important;
    }

    .proc-doc-summary {
      align-items: flex-start;
    }
  }

  .proc-doc-item-sub {
    margin-top: 2px;
  }

  .proc-doc-fieldset {
    overflow: visible !important;
    padding-bottom: 8px;
  }
</style>

