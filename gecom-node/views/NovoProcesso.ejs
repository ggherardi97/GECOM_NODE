  function buildTransportTrackingSummary(transport) {
    const parts = [];
    const mode = String(transport?.tracking_mode || '').trim();
    const provider = String(transport?.tracking_provider || '').trim();
    const externalId = String(transport?.tracking_external_id || '').trim();
