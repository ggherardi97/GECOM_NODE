    .footer{padding:28px 0 42px;background:#081a28;color:rgba(255,255,255,.82)}.footer-shell{padding:24px 28px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);display:grid;grid-template-columns:1.1fr .9fr .9fr;gap:24px;align-items:start}.footer-brand img{height:40px}.footer-contact{display:grid;gap:12px;margin-top:18px}.footer-contact-item{display:flex;align-items:flex-start;gap:12px;color:rgba(255,255,255,.74);font-size:14px;line-height:1.7}.footer-contact-item i{width:18px;margin-top:3px;color:#7ce7d1;text-align:center;font-size:16px}.footer-contact-item a{color:inherit;text-decoration:none}.footer-contact-item a:hover,.footer-contact-item a:focus{color:#fff}.footer-copy{margin-top:16px;font-size:14px}.footer-nav{display:grid;gap:10px}.footer-nav a,.footer-compliance a{color:rgba(255,255,255,.74);font-size:14px;font-weight:700;text-decoration:none}.footer-nav a:hover,.footer-nav a:focus,.footer-compliance a:hover,.footer-compliance a:focus{color:#fff}.footer-compliance strong,.footer-nav strong{display:block;margin-bottom:12px;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#bff3e7}.footer-compliance p{margin:0 0 14px;color:rgba(255,255,255,.68)}.footer-legal-links{display:flex;flex-wrap:wrap;gap:14px}
    .lead-modal{position:fixed;inset:0;z-index:1200;display:none;padding:24px;background:rgba(7,20,30,.64);overflow-y:auto}.lead-modal.is-open{display:flex;align-items:center;justify-content:center}.lead-modal-dialog{width:min(100%,620px);max-height:calc(100dvh - 48px);display:flex;flex-direction:column;overflow:hidden;border-radius:32px;background:#fff;box-shadow:0 34px 80px rgba(5,18,28,.34)}.lead-modal-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:26px 30px 18px;background:linear-gradient(180deg,#ffffff 0%,#fbfdff 100%);border-bottom:1px solid rgba(17,40,59,.08)}.lead-modal-header h2{margin:0;font-family:'Outfit',sans-serif;font-size:32px;line-height:1.04}.lead-modal-close{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;border:1px solid rgba(17,40,59,.1);background:#fff;color:var(--ink);font-size:18px;box-shadow:0 10px 24px rgba(10,29,43,.08)}.lead-modal-body{padding:18px 30px 26px;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:rgba(17,40,59,.22) transparent}.lead-modal-body::-webkit-scrollbar{width:8px}.lead-modal-body::-webkit-scrollbar-track{background:transparent}.lead-modal-body::-webkit-scrollbar-thumb{background:rgba(17,40,59,.22);border-radius:999px}.lead-modal-body::-webkit-scrollbar-thumb:hover{background:rgba(17,40,59,.32)}
    .lead-form-shell{position:relative}.lead-form-subtitle{margin:10px 0 0;color:var(--soft);line-height:1.7;max-width:42ch}.lead-form{margin-top:20px}.lead-form-grid{display:grid;gap:14px}.form-field{display:grid;gap:8px}.form-label{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--ink)}.form-control-gecom{width:100%;min-height:52px;padding:0 16px;border:1px solid rgba(17,40,59,.14);border-radius:var(--radius-md);background:#fff;color:var(--ink);font-size:15px}.form-control-gecom:focus{border-color:rgba(26,179,148,.58);box-shadow:0 0 0 4px rgba(26,179,148,.14);outline:none}.form-control-gecom.is-invalid{border-color:rgba(205,71,66,.5);box-shadow:0 0 0 4px rgba(205,71,66,.08)}select.form-control-gecom{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--soft) 50%),linear-gradient(135deg,var(--soft) 50%,transparent 50%);background-position:calc(100% - 22px) calc(50% - 4px),calc(100% - 16px) calc(50% - 4px);background-size:6px 6px,6px 6px;background-repeat:no-repeat;padding-right:42px}.form-error{min-height:18px;font-size:13px;line-height:1.4;color:#c1453d}.form-feedback{display:none;margin-top:18px;padding:14px 16px;border-radius:16px;line-height:1.6;font-weight:700}.form-feedback.is-visible{display:block}.form-feedback.is-error{color:#a13832;background:rgba(205,71,66,.12);border:1px solid rgba(205,71,66,.18)}.form-feedback.is-warning{color:#8a5a08;background:rgba(243,178,38,.14);border:1px solid rgba(243,178,38,.18)}.lead-form-submit{width:100%;margin-top:6px}.btn-spinner{width:18px;height:18px;border:2px solid rgba(8,35,48,.22);border-top-color:rgba(8,35,48,.86);border-radius:50%;animation:spin-gecom .7s linear infinite}.lead-form-submit[disabled]{cursor:wait;opacity:.8}.lead-form-microcopy{margin:14px 0 0;color:var(--soft);font-size:13px;line-height:1.7;text-align:center}.success-card{display:none;padding:28px;border-radius:var(--radius);background:linear-gradient(180deg,rgba(231,251,246,.92) 0%,rgba(255,255,255,.98) 100%);border:1px solid rgba(26,179,148,.18);color:var(--ink)}.success-card.is-visible{display:block}.success-card h3{margin:0 0 10px;font-family:'Outfit',sans-serif;font-size:30px;line-height:1.08}.success-card p{margin:0;color:var(--soft);line-height:1.8}
    .reveal{opacity:1;transform:none}.js-enhanced .reveal{opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s ease;transition-delay:var(--delay,0ms)}.js-enhanced .reveal.is-visible{opacity:1;transform:translateY(0)}
    @media (max-width:1199px){.problem-grid,.solutions-grid,.segments-grid,.team-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-title{max-width:none}}
    @media (max-width:1023px){.hero-grid,.portal-grid,.final-grid,.steps-grid,.portal-panels{grid-template-columns:1fr}.steps-grid:before{display:none}.portal-layout{grid-template-columns:1fr}.portal-sidebar{border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}}
    @media (max-width:991px){.landing-navbar .container-gecom{display:block}.landing-navbar .navbar-toggle{display:inline-flex}.landing-navbar .navbar-collapse{display:none!important;margin-top:16px;padding:18px 20px 0;align-items:stretch}.landing-navbar .navbar-collapse.in{display:block!important}.landing-navbar .navbar-nav{display:flex!important;flex-direction:column;align-items:flex-start;gap:16px;margin:0}.navbar-side{display:block;margin-top:18px}.language-switcher{margin-bottom:16px}.hero{padding-top:128px}.problem-card,.solution-card,.segment-card,.team-card,.step-card,.final-card,.hero-spotlight,.portal-panel{padding:24px}}
    @media (max-width:767px){.section{padding:78px 0}.container-gecom{width:min(100% - 24px,var(--max))}.landing-navbar .navbar-brand img{height:47px}.problem-grid,.solutions-grid,.segments-grid,.team-grid,.metrics-grid,.portal-metrics{grid-template-columns:1fr}.hero-actions{flex-direction:column;align-items:stretch}.footer-shell{grid-template-columns:1fr;text-align:left}.lead-modal{padding:14px}.lead-modal-dialog{max-height:calc(100dvh - 28px);border-radius:26px}.lead-modal-header,.lead-modal-body{padding-left:22px;padding-right:22px}.lead-modal-header{padding-top:22px;padding-bottom:16px}.lead-modal-header h2{font-size:28px}.lead-form-subtitle{max-width:none}}
  </style>
</head>
<body id="page-top" class="landing-page">
  <nav class="navbar landing-navbar" id="landingNavbar" role="navigation" aria-label="Primary navigation">
    <div class="container-gecom">
      <div class="navbar-header">
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#landingNavbarMenu" aria-expanded="false" aria-controls="landingNavbarMenu">
          <span class="sr-only"><%= gecom.nav.openMenu %></span>
          <i class="fa fa-bars" aria-hidden="true"></i>
        </button>
        <a class="navbar-brand" href="#page-top" data-scroll aria-label="GECOM"><img style="margin-top: -15px;height: 100px;" src="/Assets/img/logoFundoBranco.png" alt="GECOM"></a>
      </div>
      <div class="collapse navbar-collapse" id="landingNavbarMenu">
        <ul class="nav navbar-nav">
          <li><a href="#sobre" data-scroll><%= gecom.nav.about %></a></li>
          <li><a href="#metodologia" data-scroll><%= gecom.nav.method %></a></li>
          <li><a href="#portal-gecom" data-scroll><%= gecom.nav.portal %></a></li>
          <li><a href="#atuacao" data-scroll><%= gecom.nav.solutions %></a></li>
          <li><a href="#segmentos" data-scroll><%= gecom.nav.segments %></a></li>
        </ul>
        <div class="navbar-side">
          <div class="language-switcher" aria-label="<%= gecom.nav.language %>">
            <% languageLinks.forEach((item) => { %>
              <a href="?lang=<%= item.code %>" class="<%= currentLang === item.code ? 'is-active' : '' %>" aria-label="<%= item.ariaLabel %>" title="<%= item.ariaLabel %>"<% if (currentLang === item.code) { %> aria-current="page"<% } %>><span class="language-flag <%= item.flagClass %>" aria-hidden="true"></span></a>
            <% }) %>
          </div>
          <button type="button" class="btn-gecom btn-gecom--primary" data-open-gecom-modal data-form-context="Navbar CTA"><%= gecom.nav.cta %></button>
        </div>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero" id="sobre">
      <div class="container-gecom">
        <div class="hero-grid">
          <div class="hero-copy reveal">
            <span style="display:none;" class="section-kicker hero-kicker"><%= gecom.hero.kicker %></span>
            <!-- Alternative headline: <%= gecom.hero.headlineAlt %> -->
            <h1 class="hero-title"><%= gecom.hero.headline %></h1>
            <div class="hero-subheadline"><%= gecom.hero.subheadline %></div>
            <p style="display:none;"><%= gecom.hero.body %></p>
            <div class="hero-actions">
              <button type="button" class="btn-gecom btn-gecom--primary btn-pulse" data-open-gecom-modal data-form-context="Hero CTA"><%= gecom.hero.primaryCta %> <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
            </div>
            <div class="hero-note">
              <span><i class="fa fa-check-circle-o" aria-hidden="true"></i> <%= gecom.hero.note1 %></span>
              <span><i class="fa fa-check-circle-o" aria-hidden="true"></i> <%= gecom.hero.note2 %></span>
            </div>
          </div>
         
        </div>
      </div>
    </section>

    <section class="section section--tight" id="problemas">
      <div class="container-gecom">
        <div class="section-header reveal">
          <h2 class="section-title"><%= gecom.problems.title %></h2>
        </div>
        <div class="cards-grid problem-grid">
          <% gecom.problems.cards.forEach((card, index) => { %>
            <article class="problem-card reveal" style="--delay:<%= index * 100 %>ms;">
              <div class="problem-icon"><i class="fa <%= card.icon %>" aria-hidden="true"></i></div>
              <span class="problem-eyebrow"><%= card.eyebrow %></span>
              <h3><%= card.title %></h3>
              <p><%= card.body %></p>
            </article>
          <% }) %>
        </div>
        <p class="problem-closing reveal" style="--delay:220ms;"><%= gecom.problems.closing %></p>
      </div>
    </section>

    <section class="section" id="metodologia">
      <div class="container-gecom">
        <div class="section-header reveal">
          <h2 class="section-title"><%= gecom.method.title %></h2>
          <p class="section-subtitle"><%= gecom.method.subtitle %></p>
        </div>
        <div class="steps-grid">
          <% gecom.method.steps.forEach((step, index) => { %>
            <article class="step-card reveal" style="--delay:<%= index * 100 %>ms;">
              <div class="step-number"><%= step.number %></div>
              <h3><%= step.title %></h3>
              <p><%= step.body %></p>
            </article>
          <% }) %>
        </div>
        <div class="text-center reveal" style="margin-top:34px;--delay:220ms;">
          <button type="button" class="btn-gecom btn-gecom--secondary" data-open-gecom-modal data-form-context="Method CTA"><%= gecom.method.cta %> <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
        </div>
      </div>
    </section>

    <section class="section section--tight" id="portal-gecom">
      <div class="container-gecom">
        <div class="portal-grid">
          <div class="portal-copy reveal">
            <span class="section-kicker"><%= gecom.portal.kicker %></span>
            <h2 class="section-title"><%= gecom.portal.title %></h2>
            <p class="section-subtitle"><%= gecom.portal.subtitle %></p>
            <p><%= gecom.portal.summary %></p>
            <div class="portal-availability"><%= gecom.portal.availability %></div>
            <ul>
              <% gecom.portal.features.forEach((feature) => { %>
                <li><%= feature %></li>
              <% }) %>
            </ul>
          </div>
          <div class="portal-mockup reveal" style="--delay:120ms;">
            <div class="portal-showcase">
              <article class="portal-shot">
                <div class="portal-shot-meta">
                  <div>
                    <strong><%= gecom.portal.mockup.badge %></strong>
                    <span>Timeline do processo</span>
                  </div>
                  <span class="portal-shot-pill">Timeline</span>
                </div>
                <img class="portal-shot-art" src="/Assets/img/portal/gecom1.png" alt="Preview da timeline do portal GECOM" loading="lazy">
              </article>

              <article class="portal-shot">
                <div class="portal-shot-meta">
                  <div>
                    <strong><%= gecom.portal.mockup.badge %></strong>
                    <span>Trajetoria da operacao</span>
                  </div>
                  <span class="portal-shot-pill">Trajetoria</span>
                </div>
                <img class="portal-shot-art" src="/Assets/img/portal/gecom2.png" alt="Preview da trajetoria do portal GECOM" loading="lazy">
              </article>

              <article class="portal-shot">
                <div class="portal-shot-meta">
                  <div>
                    <strong><%= gecom.portal.mockup.badge %></strong>
                    <span>Rastreamento maritimo integrado</span>
                  </div>
                  <span class="portal-shot-pill">Tracking</span>
                </div>
                <img class="portal-shot-art" src="/Assets/img/portal/gecom3.png" alt="Preview do rastreamento maritimo do portal GECOM" loading="lazy">
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="atuacao">
      <div class="container-gecom">
        <div class="section-header reveal">
          <h2 class="section-title"><%= gecom.solutions.title %></h2>
          <p class="section-subtitle"><%= gecom.solutions.subtitle %></p>
        </div>
        <div class="cards-grid solutions-grid">
          <% gecom.solutions.cards.forEach((card, index) => { %>
            <article class="solution-card <%= card.featured ? 'solution-card--featured' : '' %> reveal" style="--delay:<%= index * 100 %>ms;">
              <% if (card.badge) { %><span class="solution-badge"><%= card.badge %></span><% } %>
              <span class="solution-tag"><%= card.tag %></span>
              <h3><%= card.title %></h3>
              <p class="solution-audience"><strong><%= card.audienceLabel %>:</strong> <%= card.audience %></p>
              <ul class="solution-list">
                <% card.features.forEach((feature) => { %>
                  <li><%= feature %></li>
                <% }) %>
              </ul>
              <div class="solution-result"><%= card.result %></div>
              <div class="solution-cta">
                <button type="button" class="btn-gecom <%= card.featured ? 'btn-gecom--primary' : 'btn-gecom--secondary' %>" data-open-gecom-modal data-form-context="Solutions CTA - <%= card.tag %>"><%= card.cta %> <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
              </div>
            </article>
          <% }) %>
        </div>
        <p class="investment-note reveal" style="--delay:260ms;"><%= gecom.solutions.investmentNote %></p>
      </div>
    </section>

    <section class="section section--tight" id="segmentos">
      <div class="container-gecom">
        <div class="section-header reveal">
          <h2 class="section-title"><%= gecom.segments.title %></h2>
          <p class="section-subtitle"><%= gecom.segments.subtitle %></p>
        </div>
        <div class="cards-grid segments-grid">
          <% gecom.segments.items.forEach((segment, index) => { %>
            <article class="segment-card reveal" style="--delay:<%= index * 70 %>ms;">
              <span class="segment-name"><%= segment.name %></span>
              <ul>
                <% segment.details.forEach((detail) => { %>
                  <li><%= detail %></li>
                <% }) %>
              </ul>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="section section--numbers section--dark" id="numeros">
      <div class="container-gecom">
        <div class="section-header reveal">
          <span class="section-kicker"><%= gecom.numbers.kicker %></span>
          <h2 class="section-title"><%= gecom.numbers.title %></h2>
        </div>
        <div class="metrics-grid">
          <% gecom.numbers.items.forEach((item, index) => { %>
            <article class="metric-card reveal" style="--delay:<%= index * 100 %>ms;">
              <div class="metric-value" data-counter="<%= item.value %>" data-prefix="<%= item.prefix %>" data-suffix="<%= item.suffix %>"><%= item.prefix %>0<%= item.suffix %></div>
              <div class="metric-label"><%= item.label %></div>
            </article>
          <% }) %>
        </div>
        <p class="metrics-note reveal" style="--delay:220ms;"><%= gecom.numbers.note %></p>
      </div>
    </section>

    <section class="section section--tight" id="equipe">
      <div class="container-gecom">
        <div class="section-header reveal">
          <h2 class="section-title"><%= gecom.team.title %></h2>
          <p class="section-subtitle"><%= gecom.team.subtitle %></p>
        </div>
        <div class="cards-grid team-grid">
          <% gecom.team.members.forEach((member, index) => { %>
            <article class="team-card reveal" style="--delay:<%= index * 100 %>ms;">
              <div class="team-avatar" data-initials="<%= member.initials %>">
                <img src="<%= member.photo %>" alt="<%= member.name %>" loading="lazy" onerror="this.parentNode.classList.add('is-fallback')">
                <span><%= member.initials %></span>
              </div>
              <span class="team-role"><%= member.role %></span>
              <h3><%= member.name %></h3>
              <p><%= member.bio %></p>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="contato">
      <div class="container-gecom">
        <div class="final-grid">
          <div class="final-copy reveal">
            <span class="section-kicker"><%= gecom.finalCta.kicker %></span>
            <h2 class="final-title"><%= gecom.finalCta.title %></h2>
            <p><%= gecom.finalCta.body %></p>
            <div class="hero-actions">
              <button type="button" class="btn-gecom btn-gecom--primary" data-open-gecom-modal data-form-context="Final CTA"><%= gecom.finalCta.primaryCta %> <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="final-card reveal" style="--delay:120ms;">
            <h3><%= gecom.finalCta.cardTitle %></h3>
            <ul>
              <% gecom.finalCta.cardItems.forEach((item) => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container-gecom">
      <div class="footer-shell reveal">
        <div>
          <a class="footer-brand" href="#page-top" data-scroll aria-label="GECOM"><img src="/Assets/img/logoFundoBranco.png" alt="GECOM"></a>
          <div class="footer-contact" aria-label="Informações de contato da empresa">
            <div class="footer-contact-item">
              <i class="fa fa-map-marker" aria-hidden="true"></i>
              <span>Rua Fernando Camargo, 500 - Sala 42 - Centro - Americana - SP - CEP 13465-020</span>
            </div>
            <div class="footer-contact-item">
              <a href="https://api.whatsapp.com/send/?phone=5519994382871&amp;text&amp;type=phone_number&amp;app_absent=0" target="_blank" rel="noopener noreferrer" aria-label="Falar com a GECOM no WhatsApp">
                <i class="fa fa-whatsapp" aria-hidden="true"></i>
              </a>
              <a href="https://api.whatsapp.com/send/?phone=5519994382871&amp;text&amp;type=phone_number&amp;app_absent=0" target="_blank" rel="noopener noreferrer">(19) 99438-2871</a>
            </div>
          </div>
          <div class="footer-copy"><%= gecom.footer.brandCopy %></div>
          <div class="footer-copy">&copy; <%= currentYear %> <%= gecom.footer.copyright %></div>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <strong>GECOM</strong>
          <a href="#page-top" data-scroll><%= gecom.footer.links.home %></a>
          <a href="#metodologia" data-scroll><%= gecom.footer.links.method %></a>
          <a href="#portal-gecom" data-scroll><%= gecom.footer.links.portal %></a>
          <a href="#atuacao" data-scroll><%= gecom.footer.links.solutions %></a>
          <a href="#segmentos" data-scroll><%= gecom.footer.links.segments %></a>
          <a href="#contato" data-scroll><%= gecom.footer.links.contact %></a>
        </nav>
        <div class="footer-compliance">
          <strong><%= gecom.footer.complianceTitle %></strong>
          <p><%= gecom.footer.complianceCopy %></p>
          <div class="footer-legal-links">
            <a href="/gecom/privacy-policy"><%= gecom.footer.privacy %></a>
            <a href="/gecom/terms-of-use"><%= gecom.footer.terms %></a>
            <a href="/gecom/privacy-policy"><%= gecom.footer.lgpd %></a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <div class="lead-modal" id="gecomLeadModal" aria-hidden="true">
    <div class="lead-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="gecomLeadModalTitle">
      <div class="lead-modal-header">
        <div>
          <h2 id="gecomLeadModalTitle"><%= gecom.form.title %></h2>
          <p class="lead-form-subtitle"><%= gecom.form.subtitle %></p>
        </div>
        <button type="button" class="lead-modal-close" data-close-gecom-modal aria-label="<%= gecom.form.close %>">
          <i class="fa fa-times" aria-hidden="true"></i>
        </button>
      </div>
      <div class="lead-modal-body">
        <div class="lead-form-shell" data-form-shell>
          <div class="lead-form-body">
            <form class="lead-form" data-gecom-form novalidate>
              <input type="hidden" name="form_context" value="Modal CTA">
              <div class="lead-form-grid">
                <div class="form-field">
                  <label class="form-label" for="gecom-name"><%= gecom.form.fields.name %></label>
                  <input class="form-control-gecom" id="gecom-name" name="name" type="text" maxlength="150" placeholder="<%= gecom.form.fields.namePlaceholder %>" required>
                  <div class="form-error" data-error-for="name"></div>
                </div>
                <div class="form-field">
                  <label class="form-label" for="gecom-phone"><%= gecom.form.fields.phone %></label>
                  <input class="form-control-gecom" id="gecom-phone" name="phone" type="tel" inputmode="numeric" maxlength="15" placeholder="<%= gecom.form.fields.phonePlaceholder %>" required>
                  <div class="form-error" data-error-for="phone"></div>
                </div>
                <div class="form-field">
                  <label class="form-label" for="gecom-company"><%= gecom.form.fields.company %></label>
                  <input class="form-control-gecom" id="gecom-company" name="company" type="text" maxlength="150" placeholder="<%= gecom.form.fields.companyPlaceholder %>" required>
                  <div class="form-error" data-error-for="company"></div>
                </div>
                <div class="form-field">
                  <label class="form-label" for="gecom-operation-mode"><%= gecom.form.fields.operationMode %></label>
                  <select class="form-control-gecom" id="gecom-operation-mode" name="operation_mode" required>
                    <option value=""><%= gecom.form.fields.selectOption %></option>
                    <% operationOptions.forEach((option) => { %>
                      <option value="<%= option %>"><%= option %></option>
                    <% }) %>
                  </select>
                  <div class="form-error" data-error-for="operation_mode"></div>
                </div>
                <div class="form-field">
                  <label class="form-label" for="gecom-import-volume"><%= gecom.form.fields.importVolume %></label>
                  <select class="form-control-gecom" id="gecom-import-volume" name="import_volume" required>
                    <option value=""><%= gecom.form.fields.selectOption %></option>
                    <% volumeOptions.forEach((option) => { %>
                      <option value="<%= option %>"><%= option %></option>
                    <% }) %>
                  </select>
                  <div class="form-error" data-error-for="import_volume"></div>
                </div>
              </div>
              <div class="form-feedback" data-form-feedback aria-live="polite"></div>
              <button type="submit" class="btn-gecom btn-gecom--primary lead-form-submit" data-submit-button>
                <span data-submit-label><%= gecom.form.submitLabel %></span>
              </button>
              <p class="lead-form-microcopy"><%= gecom.form.microcopy %></p>
            </form>
          </div>
          <div class="success-card" data-form-success aria-live="polite">
            <h3><%= gecom.form.successTitle %></h3>
            <p><%= gecom.form.successBody %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/Assets/inspinia/js/jquery-3.1.1.min.js"></script>
  <script src="/Assets/inspinia/js/popper.min.js"></script>
  <script src="/Assets/inspinia/js/bootstrap.js"></script>
  <script>
    const operationOptions = <%- JSON.stringify(operationOptions) %>;
    const volumeOptions = <%- JSON.stringify(volumeOptions) %>;
    const formTexts = <%- JSON.stringify({
      submitLabel: gecom.form.submitLabel,
      loadingLabel: gecom.form.loadingLabel,
      validation: gecom.form.validation,
      feedback: gecom.form.feedback
    }) %>;
    const formFields = ["name", "phone", "company", "operation_mode", "import_volume"];
    const navbar = document.getElementById("landingNavbar");
    const smoothLinks = [...document.querySelectorAll("[data-scroll]")];
    const revealElements = [...document.querySelectorAll(".reveal")];
    const counters = [...document.querySelectorAll("[data-counter]")];
    const modal = document.getElementById("gecomLeadModal");
    const modalDialog = modal ? modal.querySelector(".lead-modal-dialog") : null;
    const modalForm = modal ? modal.querySelector("[data-gecom-form]") : null;
    const modalShell = modal ? modal.querySelector("[data-form-shell]") : null;
    document.body.classList.add("js-enhanced");

    function updateNavbarState() {
      if (!navbar) return;
      navbar.classList.toggle("is-scrolled", window.scrollY > 24);
    }

    function closeMobileMenu() {
      const menu = document.getElementById("landingNavbarMenu");
      if (!menu || !window.jQuery) return;
      window.jQuery(menu).collapse("hide");
    }

    smoothLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("#")) return;
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        const offset = navbar ? navbar.offsetHeight + 14 : 88;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: "smooth" });
        closeMobileMenu();
      });
    });

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: .18, rootMargin: "0px 0px -40px 0px" });
    revealElements.forEach((element) => revealObserver.observe(element));

    const counterObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const element = entry.target;
        const target = Number(element.getAttribute("data-counter") || "0");
        const prefix = element.getAttribute("data-prefix") || "";
        const suffix = element.getAttribute("data-suffix") || "";
        const startTime = performance.now();
        const duration = 1500;
        const step = (now) => {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          element.textContent = `${prefix}${Math.round(target * eased)}${suffix}`;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        observer.unobserve(element);
      });
    }, { threshold: .45 });
    counters.forEach((element) => counterObserver.observe(element));

    function maskPhone(value) {
      const digits = String(value || "").replace(/\D/g, "").slice(0, 11);
      if (!digits) return "";
      if (digits.length < 3) return `(${digits}`;
      if (digits.length < 8) return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
      return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7, 11)}`;
    }

    function validatePayload(payload) {
      const errors = {};
      const normalized = {
        name: String(payload.name || "").trim(),
        phone: maskPhone(payload.phone),
        company: String(payload.company || "").trim(),
        operation_mode: String(payload.operation_mode || "").trim(),
        import_volume: String(payload.import_volume || "").trim(),
        form_context: String(payload.form_context || "").trim()
      };
      if (normalized.name.length < 3) errors.name = formTexts.validation.name;
      if (!/^\(\d{2}\) \d{5}-\d{4}$/.test(normalized.phone)) errors.phone = formTexts.validation.phone;
      if (normalized.company.length < 2) errors.company = formTexts.validation.company;
      if (!operationOptions.includes(normalized.operation_mode)) errors.operation_mode = formTexts.validation.operationMode;
      if (!volumeOptions.includes(normalized.import_volume)) errors.import_volume = formTexts.validation.importVolume;
      return { success: Object.keys(errors).length === 0, data: normalized, errors };
    }

    function setFieldError(form, fieldName, message) {
      const field = form.querySelector(`[name="${fieldName}"]`);
      const error = form.querySelector(`[data-error-for="${fieldName}"]`);
      if (field) field.classList.toggle("is-invalid", Boolean(message));
      if (error) error.textContent = message || "";
    }

    function clearFieldErrors(form) {
      formFields.forEach((field) => setFieldError(form, field, ""));
    }

    function setFormFeedback(form, type, message) {
      const feedback = form.querySelector("[data-form-feedback]");
      if (!feedback) return;
      feedback.className = `form-feedback is-visible ${type ? `is-${type}` : ""}`.trim();
      feedback.textContent = message;
    }

    function clearFormFeedback(form) {
      const feedback = form.querySelector("[data-form-feedback]");
      if (!feedback) return;
      feedback.className = "form-feedback";
      feedback.textContent = "";
    }

    function setLoadingState(form, isLoading) {
      const button = form.querySelector("[data-submit-button]");
      const label = form.querySelector("[data-submit-label]");
      if (!button || !label) return;
      button.disabled = isLoading;
      if (isLoading) {
        label.innerHTML = `<span class="btn-spinner" aria-hidden="true"></span> ${formTexts.loadingLabel}`;
      } else {
        label.textContent = formTexts.submitLabel;
      }
    }

    function showSuccess(form) {
      const shell = form.closest("[data-form-shell]");
      if (!shell) return;
      const body = shell.querySelector(".lead-form-body");
      const success = shell.querySelector("[data-form-success]");
      if (body) body.style.display = "none";
      if (success) success.classList.add("is-visible");
    }

    function trackGoogleAdsConversion() {
      if (typeof window.gtag !== "function") return;
      window.gtag("event", "conversion", {
        send_to: "AW-741733974/2LUECP2LgdwcENbs1-EC"
      });
    }

    function resetModalState() {
      if (!modalForm || !modalShell) return;
      modalForm.reset();
      clearFieldErrors(modalForm);
      clearFormFeedback(modalForm);
      setLoadingState(modalForm, false);
      const body = modalShell.querySelector(".lead-form-body");
      const success = modalShell.querySelector("[data-form-success]");
      if (body) body.style.display = "";
      if (success) success.classList.remove("is-visible");
      const phoneField = modalForm.querySelector('[name="phone"]');
      if (phoneField) phoneField.value = "";
    }

    function openModal(context) {
      if (!modal) return;
      resetModalState();
      if (modalForm) {
        const contextField = modalForm.querySelector('[name="form_context"]');
        if (contextField) contextField.value = context || "Modal CTA";
      }
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("has-modal");
      closeMobileMenu();
      const firstField = modal.querySelector("input, select");
      if (firstField) window.setTimeout(() => firstField.focus(), 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("has-modal");
    }

    document.querySelectorAll("[data-open-gecom-modal]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        openModal(button.getAttribute("data-form-context") || "Modal CTA");
      });
    });

    if (modal) {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });
      modal.querySelectorAll("[data-close-gecom-modal]").forEach((button) => {
        button.addEventListener("click", () => closeModal());
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal && modal.classList.contains("is-open")) {
        closeModal();
      }
    });

    if (modalDialog) {
      modalDialog.addEventListener("click", (event) => event.stopPropagation());
    }

    document.querySelectorAll('input[name="phone"]').forEach((input) => {
      input.addEventListener("input", () => {
        input.value = maskPhone(input.value);
      });
    });

    if (modalForm) {
      modalForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearFieldErrors(modalForm);
        clearFormFeedback(modalForm);
        const payload = Object.fromEntries(new FormData(modalForm).entries());
        const parsed = validatePayload(payload);
        if (!parsed.success) {
          formFields.forEach((field) => setFieldError(modalForm, field, parsed.errors[field] || ""));
          setFormFeedback(modalForm, "error", formTexts.feedback.invalid);
          return;
        }
        if (payload.phone !== parsed.data.phone) {
          const phoneField = modalForm.querySelector('[name="phone"]');
          if (phoneField) phoneField.value = parsed.data.phone;
        }
        setLoadingState(modalForm, true);
        try {
          const response = await fetch("/api/public/gecom-contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json"
            },
            body: JSON.stringify(parsed.data)
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data && data.message ? data.message : formTexts.feedback.error);
          if (data && data.email_sent === false) {
            setFormFeedback(modalForm, "warning", formTexts.feedback.warning);
          }
          trackGoogleAdsConversion();
          showSuccess(modalForm);
        } catch (error) {
          setFormFeedback(modalForm, "error", error instanceof Error && error.message ? error.message : formTexts.feedback.error);
        } finally {
          setLoadingState(modalForm, false);
        }
      });
    }

    updateNavbarState();
    window.addEventListener("scroll", updateNavbarState, { passive: true });
  </script>
</body>
</html>
