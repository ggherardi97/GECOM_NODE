    .metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.metric-card{padding:28px 24px;border-radius:28px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);text-align:center;color:#fff}.metric-value{font-family:'Outfit',sans-serif;font-size:clamp(36px,5vw,56px);line-height:1;font-weight:800;letter-spacing:-.05em}.metric-label{margin-top:14px;color:rgba(255,255,255,.78);line-height:1.7;font-size:15px}.metrics-note{margin-top:18px;text-align:center;color:rgba(255,255,255,.68);font-size:13px;letter-spacing:.04em;text-transform:uppercase}
