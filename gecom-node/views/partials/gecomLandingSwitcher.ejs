<style>
  .gecom-layout-switcher {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 9999;
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 10px;
    border-radius: 18px;
    background: rgba(15, 23, 42, 0.84);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.24);
    backdrop-filter: blur(14px);
  }

  .gecom-layout-switcher__label {
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0 6px 0 2px;
  }

  .gecom-layout-switcher__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 94px;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    color: #dbeafe;
    text-decoration: none !important;
    font-size: 13px;
    font-weight: 700;
    background: rgba(148, 163, 184, 0.16);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .gecom-layout-switcher__link:hover,
  .gecom-layout-switcher__link:focus {
    color: #ffffff;
    background: rgba(96, 165, 250, 0.32);
    transform: translateY(-1px);
  }

  .gecom-layout-switcher__link.is-active {
    color: #082f49;
    background: linear-gradient(135deg, #a7f3d0 0%, #7dd3fc 100%);
  }

  @media (max-width: 900px) {
    .gecom-layout-switcher {
      left: 12px;
      right: 12px;
      top: auto;
      bottom: 12px;
      justify-content: center;
      flex-wrap: wrap;
      border-radius: 20px;
    }

    .gecom-layout-switcher__label {
      width: 100%;
      text-align: center;
      padding: 0 0 2px;
    }

    .gecom-layout-switcher__link {
      flex: 1 1 88px;
      min-width: 88px;
    }
  }
</style>
<div class="gecom-layout-switcher" aria-label="Seletor de layouts da landing page da Gecom">
  <div class="gecom-layout-switcher__label">Layouts Gecom</div>
  <a
    class="gecom-layout-switcher__link <%= (currentLayout || 'classic') === 'classic' ? 'is-active' : '' %>"
    href="/gecom?layout=classic"
  >
    Atual
  </a>
  <a
    class="gecom-layout-switcher__link <%= currentLayout === 'tabs' ? 'is-active' : '' %>"
    href="/gecom?layout=tabs"
  >
    Tabs
  </a>
  <a
    class="gecom-layout-switcher__link <%= currentLayout === 'vision' ? 'is-active' : '' %>"
    href="/gecom?layout=vision"
  >
    Vision
  </a>
</div>
