<style>
  .service-grid-page .ibox-title { padding: 15px 20px 18px; }
  .service-grid-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .service-grid-toolbar .ibox-tools { float:none !important; display:inline-flex; align-items:center; gap:8px; margin-top:0 !important; }
  .service-grid-bulk { display:none; align-items:center; gap:8px; margin-bottom:12px; }
  .service-grid-bulk.is-open { display:flex; }
  #serviceHeaderRow th.sortable { cursor:pointer; user-select:none; }
  #serviceRows tr { cursor:pointer; }
  #serviceRows tr.is-selected { background:#f2fbf8; }
  #serviceHeaderRow th.service-select-col,
  #serviceFiltersRow th.service-select-col,
  #serviceRows td.service-select-col { width:42px; }
</style>

<div class="row animated fadeInRight service-grid-page" style="margin-top: 25px;">
  <div class="col-lg-12">
    <div class="ibox">
      <div class="ibox-title">
        <div class="service-grid-toolbar">
          <h5 id="serviceGridTitle" style="margin:0;"><%= typeof servicePage?.title === "string" ? servicePage.title : "Servico" %></h5>
          <div class="ibox-tools">
            <button id="serviceRefreshBtn" type="button" class="btn btn-white btn-sm"><i class="fa fa-refresh"></i> Atualizar</button>
            <button id="serviceKanbanBtn" type="button" class="btn btn-default btn-sm" style="display:none;"><i class="fa fa-columns"></i> Kanban</button>
            <button id="serviceNewBtn" type="button" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Novo</button>
          </div>
        </div>
      </div>
      <div class="ibox-content">
        <div id="serviceMessage" class="alert service-message" style="display:none;"></div>

        <div id="serviceBulkBar" class="service-grid-bulk">
          <span><strong id="serviceSelectedCount">0</strong> selecionados</span>
          <button id="serviceDeleteSelectedBtn" type="button" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Excluir</button>
          <button id="serviceClearSelectionBtn" type="button" class="btn btn-white btn-sm">Limpar selecao</button>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-hover" id="serviceTable">
            <thead>
              <tr id="serviceFiltersRow"></tr>
              <tr id="serviceHeaderRow"></tr>
            </thead>
            <tbody id="serviceRows"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__SERVICE_PAGE_CONFIG = <%- safeJson(servicePage || {}) %>;
</script>

<% contentFor('scripts') %>
  <script src="/js/servico/serviceApi.js"></script>
  <script src="/js/servico/service.resources.js"></script>
  <script src="/js/servico/crud.page.js"></script>
<% %>
