    function setVoiceStatus(message, tone) {
      const $status = $('#aiVoiceStatus');
      $status.text(String(message || '').trim());
      $status.removeClass('is-error is-active');
      if (tone === 'error') {
        $status.addClass('is-error');
      } else if (tone === 'active') {
        $status.addClass('is-active');
      }
    }

    function appendPromptText(transcript) {
      const cleanText = String(transcript || '').trim();
      if (!cleanText) return;

      const current = String($('#aiPrompt').val() || '');
      const spacer = current && !/\s$/.test(current) ? ' ' : '';
      $('#aiPrompt').val(current + spacer + cleanText).trigger('focus');
    }

    function syncVoiceButton() {
      const $button = $('#btnVoicePrompt');
      if (!$button.length) return;

      const disabled = !state.voiceSupported || state.aiPending;
      $button.prop('disabled', disabled);
      $button.toggleClass('is-listening', !!state.voiceListening);
      $button.attr(
        'title',
        !state.voiceSupported
          ? text.aiVoiceUnsupported
          : state.voiceListening
            ? text.aiVoiceStop
            : text.aiVoiceTitle,
      );
    }

    function stopVoiceRecognition() {
      if (!state.voiceRecognition || !state.voiceListening) return;
      try {
        state.voiceRecognition.stop();
      } catch (_error) {
        state.voiceListening = false;
        syncVoiceButton();
      }
    }

    function initVoiceRecognition() {
      const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (typeof SpeechRecognitionCtor !== 'function') {
        state.voiceSupported = false;
        state.voiceRecognition = null;
        return;
      }

      const recognition = new SpeechRecognitionCtor();
      recognition.lang = String(currentLang || locale || 'pt-BR');
      recognition.interimResults = true;
      recognition.continuous = false;
      recognition.maxAlternatives = 1;

      recognition.onstart = function () {
        state.voiceListening = true;
        syncVoiceButton();
        setVoiceStatus(text.aiVoiceListening, 'active');
      };

      recognition.onend = function () {
        state.voiceListening = false;
        syncVoiceButton();
        if (state.voiceSupported && !state.aiPending) {
          setVoiceStatus(text.aiVoiceIdle, '');
        }
      };

      recognition.onerror = function (event) {
        state.voiceListening = false;
        syncVoiceButton();

        const code = String(event?.error || '').trim().toLowerCase();
        if (code === 'not-allowed' || code === 'service-not-allowed' || code === 'audio-capture') {
          setVoiceStatus(text.aiVoiceDenied, 'error');
          return;
        }

        if (code === 'no-speech') {
          setVoiceStatus(text.aiVoiceNoSpeech, 'error');
          return;
        }

        setVoiceStatus(text.aiVoiceError, 'error');
      };

      recognition.onresult = function (event) {
        let finalTranscript = '';

        for (let index = event.resultIndex; index < event.results.length; index += 1) {
          const result = event.results[index];
          const transcript = String(result?.[0]?.transcript || '').trim();
          if (result && result.isFinal && transcript) {
            finalTranscript += (finalTranscript ? ' ' : '') + transcript;
          }
        }

        if (finalTranscript) {
          appendPromptText(finalTranscript);
          setVoiceStatus(text.aiVoiceAppend, 'active');
        }
      };

      state.voiceSupported = true;
      state.voiceRecognition = recognition;
    }

