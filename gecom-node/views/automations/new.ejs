    }

    function setAiPending(pending) {
      state.aiPending = !!pending;
      $('#aiPendingWrap').toggle(state.aiPending);
      $('#btnSendAiPrompt').prop('disabled', state.aiPending);
      $('#aiPrompt').prop('disabled', state.aiPending);
      $('#btnConfirmAiDraft').prop('disabled', state.aiPending);
      $('#btnRefineAiDraft').prop('disabled', state.aiPending);
      if (state.aiPending) {
        stopVoiceRecognition();
      }
      syncVoiceButton();
    }

    function clearDraftConfirmation() {
      state.draftAutomation = null;
      state.draftSummary = '';
      renderDraftConfirmation();
    }

    function setDraftConfirmation(summary, draftAutomation) {
      state.draftSummary = String(summary || '').trim();
      state.draftAutomation = draftAutomation && typeof draftAutomation === 'object' ? draftAutomation : null;
      renderDraftConfirmation();
      if (state.draftAutomation) {
        const block = document.getElementById('aiDraftConfirmation');
        if (block) {
          block.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          setTimeout(function () {
            try { block.focus({ preventScroll: true }); } catch (_error) { block.focus(); }
          }, 120);
        }
      }
    }

    function renderDraftConfirmation() {
      if (!state.draftAutomation) {
        $('#aiDraftConfirmation').removeClass('is-visible');
        $('#aiDraftSummary').text('');
        $('#aiDraftMeta').html('');
        return;
      }

      const draft = state.draftAutomation || {};
      const meta = [
        `${text.draftNameLabel}: ${String(draft.name || '').trim() || '-'}`,
        `${text.draftEntityLabel}: ${entityNameToLabel(draft.entity_name || draft.entityName || '')}`,
        `${text.draftTriggerLabel}: ${triggerTypeLabel(draft.trigger_type || draft.triggerType || '')}`,
      ];

      $('#aiDraftSummary').text(state.draftSummary || text.aiDraftReady);
      $('#aiDraftMeta').html(
        meta
          .filter(Boolean)
          .map((item) => `<span class="automation-ai-chip">${esc(item)}</span>`)
          .join(''),
      );
      $('#aiDraftConfirmation').addClass('is-visible');
    }

    function appendChatMessage(role, content, sendable) {
      state.aiMessages.push({
        role: role === 'user' ? 'user' : 'assistant',
        content: String(content || '').trim(),
        sendable: sendable !== false,
      });
      renderChat();
    }

    function renderChat() {
      const rows = state.aiMessages.length
        ? state.aiMessages
            .map((message) => {
              const isUser = message.role === 'user';
              const roleLabel = isUser ? text.userLabel : text.assistantLabel;
              return `
                <div class="automation-chat-message ${isUser ? 'is-user' : 'is-assistant'}">
                  <div class="automation-chat-bubble">
                    <span class="automation-chat-role">${esc(roleLabel)}</span>
                    <div>${esc(message.content).replace(/\n/g, '<br>')}</div>
                  </div>
                </div>
              `;
            })
            .join('')
        : `
            <div class="automation-chat-empty">
              ${esc(text.aiWelcome)}
            </div>
          `;

      $('#aiChatThread').html(rows);
      const thread = document.getElementById('aiChatThread');
      if (thread) {
        thread.scrollTop = thread.scrollHeight;
      }
    }

    function composeAiMessages() {
      return state.aiMessages
        .filter((message) => message.sendable)
        .map((message) => ({
          role: message.role,
          content: message.content,
        }));
    }

    async function sendPromptToAi() {
      const prompt = String($('#aiPrompt').val() || '').trim();
      if (!prompt || state.aiPending) return;

      appendChatMessage('user', prompt, true);
      $('#aiPrompt').val('');
      clearDraftConfirmation();
      setAiPending(true);

      try {
        const response = await api('/api/automations/ai/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lang: currentLang,
            messages: composeAiMessages(),
          }),
        });

        const parts = [String(response?.reply || '').trim()]
          .concat(
            Array.isArray(response?.questions)
              ? response.questions.map((item) => String(item || '').trim()).filter(Boolean)
              : [],
          )
          .filter(Boolean);

        appendChatMessage('assistant', parts.join('\n\n') || text.aiWelcome, true);

        if (String(response?.status || '') === 'needs_confirmation') {
          setDraftConfirmation(response?.summary, response?.draft_automation);
        } else if (String(response?.status || '') === 'needs_clarification') {
          clearDraftConfirmation();
        }

        if (String(response?.status || '') === 'created') {
          const automationId = String(response?.automation?.id || '').trim();
          if (automationId) {
            setTimeout(function () {
              window.location.href = '/automations/' + encodeURIComponent(automationId) + '/builder';
            }, 500);
          } else {
            window.alert(text.aiRedirect);
          }
        }
      } catch (error) {
        appendChatMessage('assistant', error?.message || text.autoAiError, false);
      } finally {
        setAiPending(false);
      }
    }

    async function confirmDraftCreation() {
      if (!state.draftAutomation || state.aiPending) return;

      setAiPending(true);
      $('#aiPendingText').text(text.aiConfirming);

      try {
        const response = await api('/api/automations/ai/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lang: currentLang,
            confirmed: true,
            draft_automation: state.draftAutomation,
            messages: composeAiMessages(),
          }),
        });

        appendChatMessage('assistant', String(response?.reply || text.aiRedirect).trim(), true);

        if (String(response?.status || '') === 'created') {
          clearDraftConfirmation();
          const automationId = String(response?.automation?.id || '').trim();
          if (automationId) {
            setTimeout(function () {
              window.location.href = '/automations/' + encodeURIComponent(automationId) + '/builder';
            }, 500);
            return;
          }
        }

        if (String(response?.status || '') === 'needs_confirmation') {
          setDraftConfirmation(response?.summary, response?.draft_automation);
        }
      } catch (error) {
        appendChatMessage('assistant', error?.message || text.autoAiError, false);
      } finally {
        $('#aiPendingText').text(text.aiPending);
        setAiPending(false);
      }
    }

    function applyCopy() {
      $('#pageAutomationTitle').text(text.pageTitle);
      $('#aiTitle').text(text.aiTitle);
      $('#aiSubtitle').text(text.aiSubtitle);
      $('#aiPromptLabel').text(text.aiPromptLabel);
      $('#aiPrompt').attr('placeholder', text.aiPlaceholder);
      $('#btnSendAiPromptText').text(text.aiSend);
      $('#btnVoicePrompt').attr('title', text.aiVoiceTitle);
      $('#aiPendingText').text(text.aiPending);
      $('#btnToggleManualText').text(text.aiManual);
      setVoiceStatus(state.voiceSupported ? text.aiVoiceIdle : text.aiVoiceUnsupported, state.voiceSupported ? '' : 'error');
      syncVoiceButton();
      $('#aiHelperText').text(text.aiHelper);
      $('#aiDraftTitle').text(text.aiDraftTitle);
      $('#btnConfirmAiDraftText').text(text.aiConfirm);
      $('#btnRefineAiDraftText').text(text.aiRefine);
      $('#presetSectionTitle').text(text.presetSectionTitle);
      $('#presetSectionSubtitle').text(text.presetSectionSubtitle);
      $('#manualTitle').text(text.manualTitle);
      $('#manualSubtitle').text(text.manualSubtitle);
      $('#manualNameLabel').text(text.name);
      $('#name').attr('placeholder', text.namePlaceholder);
      $('#manualDescriptionLabel').text(text.description);
      $('#description').attr('placeholder', text.descriptionPlaceholder);
      $('#manualEntityLabel').text(text.entity);
      $('#manualTriggerLabel').text(text.trigger);
      $('#manualEventTypeLabel').text(text.event);
      $('#manualFieldChangedLabel').text(text.fieldChanged);
      $('#fieldChanged').attr('placeholder', text.fieldChangedPlaceholder);
      $('#manualCronLabel').text(text.cron);
      $('#manualCancelText').text(text.cancel);
      $('#manualSubmitText').text(text.submit);
    }

    $(document).ready(function () {
      $('#masterHeader').hide();
      $('#pageName').text(text.pageTitle);
      $('#subpageName').text(text.pageCrumb).attr('href', '/automations');
      $('#path').show();
      $('#subSecoundPageName').text(text.pageCrumbCurrent).attr('href', '/automations/new');

      initVoiceRecognition();
      applyCopy();
      syncVoiceButton();
      renderTriggerOptions();
      renderChat();
      renderDraftConfirmation();
      renderServicePresets();
      toggleTriggerConfig();
      setManualVisible(false);

      if ($.fn.tooltip) {
        $('[data-toggle="tooltip"]').tooltip();
      }

      $('#triggerType').on('change', toggleTriggerConfig);
      $('#btnToggleManual').on('click', function () {
        setManualVisible(!state.manualVisible);
      });

      $('#btnSendAiPrompt').on('click', function () {
        sendPromptToAi().catch(() => {
          window.alert(text.autoAiError);
        });
      });

      $('#btnVoicePrompt').on('click', function () {
        if (!state.voiceSupported || !state.voiceRecognition || state.aiPending) {
          setVoiceStatus(text.aiVoiceUnsupported, 'error');
          return;
        }

        if (state.voiceListening) {
          stopVoiceRecognition();
          return;
        }

        try {
          state.voiceRecognition.lang = String(currentLang || locale || 'pt-BR');
          state.voiceRecognition.start();
          setVoiceStatus(text.aiVoiceStart, 'active');
        } catch (_error) {
          setVoiceStatus(text.aiVoiceError, 'error');
        }
      });

      $('#btnConfirmAiDraft').on('click', function () {
        confirmDraftCreation().catch(() => {
          window.alert(text.autoAiError);
        });
      });

      $('#btnRefineAiDraft').on('click', function () {
        $('#aiPrompt').trigger('focus');
        appendChatMessage('assistant', text.aiFocusRefine, false);
      });

      $(document).on('click', '.js-create-preset', function () {
        const presetKey = String($(this).data('preset-key') || '').trim();
        createServicePreset(presetKey).catch(function (error) {
          window.alert(error?.message || text.autoCreateError);
        });
      });

      $('#aiPrompt').on('keydown', function (event) {
        if (event.key === 'Enter' && !event.shiftKey) {
          event.preventDefault();
          sendPromptToAi().catch(() => {
            window.alert(text.autoAiError);
          });
        }
      });

      loadEntities().catch(() => {
        renderEntityOptions();
      });

      $('#automationCreateForm').on('submit', async function (event) {
        event.preventDefault();

        try {
          const payload = buildPayload();
          const created = await api('/api/automations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const id = String(created?.id || '').trim();
          if (!id) throw new Error('Automação criada sem ID retornado.');

          window.location.href = '/automations/' + encodeURIComponent(id) + '/builder';
        } catch (error) {
          window.alert(error?.message || text.autoCreateError);
        }
      });
    });
  })();
</script>
