<style>
  .automation-create-shell { display:flex; flex-direction:column; gap:18px; }
  .automation-ai-panel { border:1px solid #e7eaec; border-radius:10px; background:linear-gradient(180deg, #fbfdff 0%, #f5f9fc 100%); padding:20px; }
  .automation-ai-header { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:14px; }
  .automation-ai-title h3 { margin:0 0 6px; font-size:24px; color:#23415c; }
  .automation-ai-title p { margin:0; color:#6d8294; max-width:760px; }
  .automation-chat-thread { border:1px solid #dde6ee; border-radius:12px; background:#fff; min-height:280px; max-height:460px; overflow-y:auto; padding:18px; box-shadow:inset 0 1px 0 rgba(255,255,255,.7); }
  .automation-chat-empty { color:#7e94a7; font-size:13px; }
  .automation-chat-message { display:flex; margin-bottom:14px; }
  .automation-chat-message.is-user { justify-content:flex-end; }
  .automation-chat-bubble { max-width:82%; border-radius:14px; padding:12px 14px; font-size:14px; line-height:1.55; white-space:normal; box-shadow:0 8px 24px rgba(35, 65, 92, .06); }
  .automation-chat-message.is-assistant .automation-chat-bubble { background:#f3f7fb; border:1px solid #dce7f0; color:#2c455c; }
  .automation-chat-message.is-user .automation-chat-bubble { background:#1ab394; border:1px solid #16a085; color:#fff; }
  .automation-chat-role { display:block; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; margin-bottom:6px; opacity:.72; }
  .automation-ai-composer { margin-top:16px; background:#fff; border:1px solid #dde6ee; border-radius:12px; padding:16px; }
  .automation-ai-label { display:flex; align-items:center; gap:8px; font-weight:600; color:#294964; margin-bottom:8px; }
  .automation-ai-label .fa { color:#1c84c6; cursor:help; }
  .automation-ai-textarea { min-height:124px; resize:vertical; border-radius:10px; }
  .automation-ai-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; align-items:center; }
  .automation-ai-mic-btn { min-width:44px; display:inline-flex; align-items:center; justify-content:center; }
  .automation-ai-mic-btn.is-listening { background:#ed5565; border-color:#d9534f; color:#fff; }
  .automation-ai-mic-btn[disabled] { cursor:not-allowed; opacity:.65; }
  .automation-ai-note { color:#7d90a2; font-size:12px; margin-top:10px; }
  .automation-ai-voice-status { margin-top:8px; color:#5e7488; font-size:12px; min-height:18px; }
  .automation-ai-voice-status.is-error { color:#d9534f; }
  .automation-ai-voice-status.is-active { color:#1c84c6; }
  .automation-ai-confirm { display:none; order:1; margin-top:16px; border:1px solid #d8ebe3; border-radius:12px; background:#fff; padding:16px; box-shadow:0 8px 24px rgba(26, 179, 148, .06); }
  .automation-ai-confirm.is-visible { display:block; }
  .automation-ai-confirm h4 { margin:0 0 8px; color:#245b4a; font-size:16px; }
  .automation-ai-confirm p { margin:0 0 10px; color:#536b62; }
  .automation-ai-confirm-meta { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
  .automation-ai-chip { display:inline-flex; align-items:center; border-radius:999px; padding:6px 10px; background:#edf8f4; color:#2f6453; font-size:12px; border:1px solid #d6ece4; }
  .automation-ai-confirm-actions { display:flex; gap:10px; flex-wrap:wrap; }
  .automation-preset-panel { order:2; margin-top:18px; border:1px solid #dde6ee; border-radius:12px; background:#fff; padding:18px; }
  .automation-preset-header { display:flex; justify-content:space-between; gap:14px; align-items:flex-start; margin-bottom:14px; }
  .automation-preset-header h4 { margin:0; color:#24445e; font-size:18px; }
  .automation-preset-header p { margin:6px 0 0; color:#708395; max-width:760px; }
  .automation-preset-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px; }
  .automation-preset-card { border:1px solid #dde6ee; border-radius:14px; padding:16px; background:linear-gradient(180deg, #ffffff 0%, #f7fbfd 100%); box-shadow:0 10px 24px rgba(36, 68, 94, .06); display:flex; flex-direction:column; gap:10px; min-height:230px; }
  .automation-preset-card h5 { margin:0; color:#23415c; font-size:16px; }
  .automation-preset-card p { margin:0; color:#6f8597; font-size:13px; line-height:1.5; }
  .automation-preset-badges { display:flex; flex-wrap:wrap; gap:8px; }
  .automation-preset-badge { display:inline-flex; align-items:center; padding:5px 9px; border-radius:999px; background:#edf6fb; color:#2f5b77; font-size:11px; font-weight:600; border:1px solid #d7e7f2; }
  .automation-preset-badge.is-accent { background:#edf8f4; color:#2f6453; border-color:#d6ece4; }
  .automation-preset-actions { margin-top:auto; display:flex; justify-content:flex-end; }
  .automation-preset-card .btn { border-radius:10px; }
  .automation-manual-panel { display:none; border:1px solid #e7eaec; border-radius:10px; background:#fff; padding:18px; }
  .automation-manual-panel.is-visible { display:block; }
  .automation-manual-header { display:flex; justify-content:space-between; gap:12px; align-items:center; margin-bottom:16px; }
  .automation-manual-header h4 { margin:0; color:#2b4f6a; }
  .automation-manual-header p { margin:6px 0 0; color:#7b8d9d; }
  .automation-loading { display:inline-flex; align-items:center; gap:8px; color:#7b8d9d; font-size:12px; }
  .automation-spinner { width:16px; height:16px; border-radius:50%; border:2px solid #dbe6ef; border-top-color:#1ab394; display:inline-block; animation:automationSpin .8s linear infinite; }
  @keyframes automationSpin { to { transform:rotate(360deg); } }
  @media (max-width: 768px) {
    .automation-ai-header { flex-direction:column; }
    .automation-chat-bubble { max-width:100%; }
    .automation-ai-actions { flex-direction:column; align-items:stretch; }
    .automation-ai-actions .btn { width:100%; }
  }
</style>

<div class="row animated fadeInRight" style="margin-top:25px;">
  <div class="col-lg-10">
    <div class="ibox">
      <div class="ibox-title">
        <h5 id="pageAutomationTitle">Nova Automação</h5>
      </div>
      <div class="ibox-content">
        <div class="automation-create-shell">
          <div class="automation-ai-panel">
            <div class="automation-ai-header">
              <div class="automation-ai-title">
                <h3 id="aiTitle">Crie com IA</h3>
                <p id="aiSubtitle">Descreva o que deseja automatizar e a IA monta a automação completa para você. Se faltar alguma informação, ela pergunta antes de criar.</p>
              </div>
              <div id="aiPendingWrap" class="automation-loading" style="display:none;">
                <span class="automation-spinner"></span>
                <span id="aiPendingText">Analisando sua automação...</span>
              </div>
            </div>

            <div id="aiChatThread" class="automation-chat-thread"></div>

            <div class="automation-ai-composer">
              <label class="automation-ai-label" for="aiPrompt">
                <span id="aiPromptLabel">Prompt da IA</span>
                <i
                  class="fa fa-question-circle"
                  data-toggle="tooltip"
                  data-placement="right"
                  title="Para que a IA seja acertíva, lembre de dizer o nome da tabela que será automação, qual o trigger, e que ações deseja efetuar. Também especifique se é algo a ser disparado por ações ou deve ser agendado."
                ></i>
              </label>
              <textarea id="aiPrompt" class="form-control automation-ai-textarea" placeholder="Ex: Quando um lead for criado na tabela leads, envie um e-mail para o comercial e crie uma tarefa para o responsável."></textarea>
              <div id="aiVoiceStatus" class="automation-ai-voice-status" aria-live="polite"></div>
              <div class="automation-ai-actions">
                <button id="btnSendAiPrompt" type="button" class="btn btn-primary">
                  <i class="fa fa-magic"></i> <span id="btnSendAiPromptText">Gerar com IA</span>
                </button>
                <button id="btnVoicePrompt" type="button" class="btn btn-default automation-ai-mic-btn" title="Falar no microfone">
                  <i class="fa fa-microphone"></i>
                </button>
                <button id="btnToggleManual" type="button" class="btn btn-default">
                  <span id="btnToggleManualText">Ou Crie manualmente</span>
                </button>
              </div>
              <div id="aiHelperText" class="automation-ai-note">Quanto mais específico o prompt, melhor a automação sai pronta para uso.</div>
            </div>

            <div class="automation-preset-panel">
              <div class="automation-preset-header">
                <div>
                  <h4 id="presetSectionTitle">Fluxos prontos de ServiÃ§o</h4>
                  <p id="presetSectionSubtitle">Comece com automaÃ§Ãµes prontas para incidentes, follow-up e field service. VocÃª pode abrir no builder e ajustar depois.</p>
                </div>
              </div>
              <div id="servicePresetGrid" class="automation-preset-grid"></div>
            </div>

            <div id="aiDraftConfirmation" class="automation-ai-confirm" tabindex="-1">
              <h4 id="aiDraftTitle">Confirme a automação</h4>
              <p id="aiDraftSummary"></p>
              <div id="aiDraftMeta" class="automation-ai-confirm-meta"></div>
              <div class="automation-ai-confirm-actions">
                <button id="btnConfirmAiDraft" type="button" class="btn btn-primary">
                  <i class="fa fa-check"></i> <span id="btnConfirmAiDraftText">Confirmar e criar</span>
                </button>
                <button id="btnRefineAiDraft" type="button" class="btn btn-default">
                  <span id="btnRefineAiDraftText">Quero ajustar no chat</span>
                </button>
              </div>
            </div>
          </div>

          <div id="manualAutomationWrap" class="automation-manual-panel">
            <div class="automation-manual-header">
              <div>
                <h4 id="manualTitle">Criação manual</h4>
                <p id="manualSubtitle">Prefere ajustar a automação na mão? Escolha a tabela e o trigger inicial para abrir o builder.</p>
              </div>
            </div>

            <form id="automationCreateForm" class="form-horizontal">
              <div class="form-group">
                <label id="manualNameLabel" class="col-sm-3 control-label">Nome</label>
                <div class="col-sm-9">
                  <input id="name" type="text" class="form-control" placeholder="Ex: Lead criado -> Webhook" required />
                </div>
              </div>

              <div class="form-group">
                <label id="manualDescriptionLabel" class="col-sm-3 control-label">Descrição</label>
                <div class="col-sm-9">
                  <textarea id="description" class="form-control" rows="3" placeholder="Descrição opcional"></textarea>
                </div>
              </div>

              <div class="form-group">
                <label id="manualEntityLabel" class="col-sm-3 control-label">Entidade</label>
                <div class="col-sm-9">
                  <select id="entityName" class="form-control" required>
                    <option value="">Carregando entidades...</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label id="manualTriggerLabel" class="col-sm-3 control-label">Trigger</label>
                <div class="col-sm-9">
                  <select id="triggerType" class="form-control" required></select>
                </div>
              </div>

              <div id="entityEventConfig" style="display:none;">
                <div class="form-group">
                  <label id="manualEventTypeLabel" class="col-sm-3 control-label">Evento</label>
                  <div class="col-sm-9">
                    <select id="eventType" class="form-control"></select>
                  </div>
                </div>
                <div class="form-group">
                  <label id="manualFieldChangedLabel" class="col-sm-3 control-label">Campo alterado</label>
                  <div class="col-sm-9">
                    <input id="fieldChanged" type="text" class="form-control" placeholder="Opcional (ex: status)" />
                  </div>
                </div>
              </div>

              <div id="scheduleConfig" style="display:none;">
                <div class="form-group">
                  <label id="manualCronLabel" class="col-sm-3 control-label">Cron</label>
                  <div class="col-sm-9">
                    <input id="cron" type="text" class="form-control" placeholder="0 9 * * *" />
                  </div>
                </div>
              </div>

              <div class="form-group">
                <div class="col-sm-9 col-sm-offset-3">
                  <a href="/automations" id="manualCancelText" class="btn btn-default">Cancelar</a>
                  <button id="btnCreateAutomation" type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> <span id="manualSubmitText">Criar e abrir Builder</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

