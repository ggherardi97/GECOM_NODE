    function populateUpdateAction(config) {
      const entityName = String(config.entityName || $('#automationEntity').val() || '').trim().toLowerCase();
      loadFields(entityName, 'writable').then(function (fields) {
        $('#cfgUpdateField').html(fields.length ? fields.map(function (field) { return '<option value="' + esc(field.name) + '">' + esc(field.label) + '</option>'; }).join('') : '<option value="">Sem campos</option>');
        $('#cfgUpdateField').val(String(config.field || '').trim().toLowerCase());
        $('#cfgUpdateTargetMode').val(String(config.targetMode || (config.recordId ? 'LOOKUP' : 'CONTEXT')).trim().toUpperCase());
        $('#cfgUpdateValueSource').val(parseValueBinding(config.value).source);
        renderUpdateValueEditor(config);
      });
      initLookup('#cfgUpdateLookup', '#cfgUpdateRecordId', '#cfgUpdateMenu', function () { return $('#cfgUpdateEntity').val(); });
      $('#cfgUpdateTargetMode').on('change', function () { $('#cfgUpdateLookupWrap').toggle(String($(this).val() || 'CONTEXT') === 'LOOKUP'); }).trigger('change');
      $('#cfgUpdateEntity').on('change', function () { populateUpdateAction({ entityName: $(this).val(), field: '', value: '' }); });
      $('#cfgUpdateField,#cfgUpdateValueSource').on('change', function () { renderUpdateValueEditor(config); });
    }

    function renderUpdateValueEditor(config) {
      const entityName = String($('#cfgUpdateEntity').val() || $('#automationEntity').val() || '').trim().toLowerCase();
      const fieldName = String($('#cfgUpdateField').val() || config.field || '').trim().toLowerCase();
      const fieldMeta = fieldByName(entityName, fieldName, 'writable');
      const parsed = parseValueBinding(config.value);
      const source = String($('#cfgUpdateValueSource').val() || parsed.source || 'FIXED').trim().toUpperCase();
      let html = '';
      if (source === 'TRIGGER_FIELD') {
        const triggerEntity = String((S.workflow.trigger && S.workflow.trigger.config && S.workflow.trigger.config.entityName) || $('#automationEntity').val() || '').trim().toLowerCase();
        const fields = S.fieldsByEntity.all[triggerEntity] || [];
        html = '<select id="cfgUpdateDynamicField" class="form-control">' + fields.map(function (field) { return '<option value="' + esc(field.name) + '" ' + (field.name === parsed.dynamicField ? 'selected' : '') + '>' + esc(field.label) + '</option>'; }).join('') + '</select>';
      } else if (source === 'CONTEXT_RECORD_ID') {
        html = '<div class="builder-note">Usa o registro que disparou a automacao.</div>';
      } else if (source === 'TEMPLATE') {
        html = '<textarea id="cfgUpdateTemplateValue" class="form-control" rows="3">' + esc(parsed.source === 'TEMPLATE' ? parsed.value : (config.value || '')) + '</textarea>';
      } else {
        html = fixedValueMarkup('cfgUpdate', fieldMeta, parsed.source === 'FIXED' ? parsed.value : (config.value || ''));
      }
      $('#cfgUpdateValueWrap').html(html);
      initFixedLookup('cfgUpdate', fieldMeta);
    }

    function renderWhatsappRecipient(config) {
      const mode = String($('#cfgWhatsappRecipientMode').val() || 'MANUAL').trim().toUpperCase();
      let html = '';
      if (mode === 'TRIGGER_FIELD') {
        const triggerEntity = String((S.workflow.trigger && S.workflow.trigger.config && S.workflow.trigger.config.entityName) || $('#automationEntity').val() || '').trim().toLowerCase();
        const fields = S.fieldsByEntity.all[triggerEntity] || [];
        html = '<select id="cfgWhatsappPhoneField" class="form-control">' + fields.map(function (field) { return '<option value="' + esc(field.name) + '" ' + (field.name === String(config.phoneField || '') ? 'selected' : '') + '>' + esc(field.label) + '</option>'; }).join('') + '</select>';
      } else if (mode === 'TEMPLATE') {
        html = '<textarea id="cfgWhatsappToTemplate" class="form-control" rows="2">' + esc(String(config.to || '')) + '</textarea>';
      } else {
        html = '<input id="cfgWhatsappTo" class="form-control" value="' + esc(String(config.to || '')) + '" />';
      }
      $('#cfgWhatsappRecipientWrap').html(html);
    }

    function saveOffcanvas() {
      if (!S.selectedNode) return;
      if (S.selectedNode.kind === 'trigger') {
        const type = String($('#cfgTriggerType').val() || 'MANUAL').toUpperCase();
        const config = {};
        if (type === 'ENTITY_EVENT') {
          config.entityName = String($('#cfgTriggerEntityName').val() || $('#automationEntity').val() || '').trim().toLowerCase();
          config.eventType = String($('#cfgTriggerEventType').val() || 'CREATE').toUpperCase();
          const fieldChanged = String($('#cfgTriggerFieldChanged').val() || '').trim().toLowerCase();
          if (fieldChanged) config.fieldChanged = fieldChanged;
          const field = String($('#cfgTriggerConditionField').val() || '').trim().toLowerCase();
          const operator = String($('#cfgTriggerConditionOperator').val() || '').trim().toUpperCase();
          if (field && operator) {
            const fieldMeta = fieldByName(config.entityName, field, 'all');
            const condition = { source: String($('#cfgTriggerConditionSource').val() || 'after'), field: field, operator: operator };
            if (['IS_TRUE','IS_FALSE','NOT_EMPTY','IS_EMPTY'].indexOf(operator) < 0) condition.value = readFixedValue('cfgTriggerCondition', fieldMeta);
            config.condition = condition;
          }
        }
        if (type === 'SCHEDULE') {
          config.cron = String($('#cfgTriggerCron').val() || '').trim();
          config.timezone = String($('#cfgTriggerTimezone').val() || 'America/Sao_Paulo').trim() || 'America/Sao_Paulo';
        }
        S.workflow.trigger = { type: type, config: config };
      } else {
        const action = S.workflow.actions.find(function (item) { return item.id === S.selectedNode.id; });
        if (!action) return;
        if (action.type === 'UPDATE_FIELD') {
          const entityName = String($('#cfgUpdateEntity').val() || '').trim().toLowerCase();
          const fieldMeta = fieldByName(entityName, $('#cfgUpdateField').val(), 'writable');
          const source = String($('#cfgUpdateValueSource').val() || 'FIXED').trim().toUpperCase();
          let value = '';
          if (source === 'TRIGGER_FIELD') value = compileValueBinding(source, '', String($('#cfgUpdateDynamicField').val() || '').trim());
          else if (source === 'TEMPLATE') value = compileValueBinding(source, $('#cfgUpdateTemplateValue').val(), '');
          else if (source === 'CONTEXT_RECORD_ID') value = '{{recordId}}';
          else value = compileValueBinding(source, readFixedValue('cfgUpdate', fieldMeta), '');
          action.config = { name: String($('#cfgActionName').val() || '').trim(), entityName: entityName, targetMode: String($('#cfgUpdateTargetMode').val() || 'CONTEXT').trim().toUpperCase(), recordId: String($('#cfgUpdateRecordId').val() || '').trim(), recordLabel: String($('#cfgUpdateLookup').val() || '').trim(), field: String($('#cfgUpdateField').val() || '').trim().toLowerCase(), valueSource: source, value: value };
        } else if (action.type === 'SEND_EMAIL') {
          const body = $('#cfgBody').data('summernote') ? String($('#cfgBody').summernote('code') || '').trim() : String($('#cfgBody').val() || '').trim();
          action.config = { name: String($('#cfgActionName').val() || '').trim(), to: String($('#cfgTo').val() || '').trim(), cc: String($('#cfgCc').val() || '').trim(), bcc: String($('#cfgBcc').val() || '').trim(), subject: String($('#cfgSubject').val() || '').trim(), body: body, body_html: body };
        } else if (action.type === 'CREATE_TASK') {
          action.config = { name: String($('#cfgActionName').val() || '').trim(), title: String($('#cfgTaskTitle').val() || '').trim(), description: String($('#cfgTaskDescription').val() || '').trim() };
        } else if (action.type === 'WEBHOOK') {
          action.config = { name: String($('#cfgActionName').val() || '').trim(), url: String($('#cfgWebhookUrl').val() || '').trim(), method: String($('#cfgWebhookMethod').val() || 'POST').trim().toUpperCase(), headers: parseJson($('#cfgWebhookHeaders').val()), body: parseJson($('#cfgWebhookBody').val()) };
        } else if (action.type === 'AI_ACTION') {
          action.config = { name: String($('#cfgActionName').val() || '').trim(), prompt: String($('#cfgAiPrompt').val() || '').trim(), instructions: String($('#cfgAiInstructions').val() || '').trim(), outputKey: String($('#cfgAiOutputKey').val() || 'ai_result').trim() || 'ai_result' };
        } else if (action.type === 'CREATE_REGISTER') {
          action.config = { name: String($('#cfgActionName').val() || '').trim(), entityName: String($('#cfgCreateRegisterEntity').val() || '').trim().toLowerCase(), fieldMappings: (function () { try { const parsed = JSON.parse(String($('#cfgCreateRegisterMappingsJson').val() || '[]')); return Array.isArray(parsed) ? parsed : []; } catch (_e) { return []; } })() };
        } else if (action.type === 'WHATSAPP') {
          const mode = String($('#cfgWhatsappRecipientMode').val() || 'MANUAL').trim().toUpperCase();
          let to = '';
          let phoneField = '';
          if (mode === 'TRIGGER_FIELD') { phoneField = String($('#cfgWhatsappPhoneField').val() || '').trim(); to = phoneField ? triggerTokenForField(phoneField) : ''; }
          else if (mode === 'TEMPLATE') to = String($('#cfgWhatsappToTemplate').val() || '').trim();
          else to = String($('#cfgWhatsappTo').val() || '').trim();
          action.config = { name: String($('#cfgActionName').val() || '').trim(), integrationId: String($('#cfgWhatsappIntegration').val() || '').trim(), recipientMode: mode, phoneField: phoneField, to: to, message: String($('#cfgWhatsappMessage').val() || '').trim() };
        }
      }
      renderCanvas();
      closeOffcanvas();
    }

    function removeAction(actionId) {
      S.workflow.actions = S.workflow.actions.filter(function (item) { return item.id !== actionId; });
      if (S.selectedNode && S.selectedNode.kind === 'action' && S.selectedNode.id === actionId) {
        S.selectedNode = null;
        closeOffcanvas();
      }
      renderCanvas();
    }

    function reorderActionsFromDom() {
      const ids = $('#workflowActionsList .workflow-action-card').map(function () { return String($(this).data('action-id') || ''); }).get();
      const map = new Map(S.workflow.actions.map(function (action) { return [action.id, action]; }));
      S.workflow.actions = ids.map(function (id) { return map.get(id); }).filter(Boolean);
      renderCanvas();
    }

    function setupSortables() {
      new Sortable(document.getElementById('paletteActions'), { group: { name: 'actions', pull: 'clone', put: false }, sort: false, animation: 120 });
      new Sortable(document.getElementById('workflowActionsList'), {
        group: { name: 'actions', pull: true, put: true },
        animation: 150,
        onAdd: function (evt) {
          const fromPalette = evt.from && evt.from.id === 'paletteActions';
          if (fromPalette) {
            const type = String(evt.item && evt.item.dataset && evt.item.dataset.actionType || '').toUpperCase();
            const disabled = String(evt.item && evt.item.dataset && evt.item.dataset.disabled || '0') === '1';
            evt.item.remove();
            if (!type || disabled) return;
            const action = { id: uuid(), type: type, config: defaultConfig(type) };
            S.workflow.actions.splice(Math.max(0, Number(evt.newIndex || 0)), 0, action);
            renderCanvas();
            openAction(action.id);
            if (type === 'UPDATE_FIELD') populateUpdateAction(action.config);
            if (type === 'WHATSAPP') renderWhatsappRecipient(action.config);
            return;
          }
          reorderActionsFromDom();
        },
        onUpdate: function () { reorderActionsFromDom(); }
      });
    }

    function loadAutomation() {
      return api('/api/automations/' + encodeURIComponent(automationId)).then(function (row) {
        S.automation = row;
        S.workflow = normalizeWorkflow(row.workflow_json || {});
        const entityName = String(row.entity_name || 'leads').trim().toLowerCase();
        $('#automationName').val(row.name || '');
        $('#automationEntity').html(entityOptions(entityName)).val(entityName);
        $('#automationDescription').val(row.description || '');
        $('#btnToggleActive').text(row.is_active ? (locale === 'en' ? 'Deactivate' : locale === 'es' ? 'Desactivar' : 'Desativar') : (locale === 'en' ? 'Activate' : locale === 'es' ? 'Activar' : 'Ativar'))
          .toggleClass('btn-warning', !!row.is_active)
          .toggleClass('btn-info', !row.is_active);
        initLookup('#manualRecordLookup', '#manualRecordId', '#manualRecordMenu', function () { return $('#automationEntity').val(); });
        return loadFields(entityName, 'all').then(function () { return loadFields(entityName, 'writable'); }).then(renderCanvas);
      });
    }

    function saveAutomation(showMessage) {
      if (!S.automation) return Promise.resolve();
      const payload = { name: String($('#automationName').val() || '').trim(), description: String($('#automationDescription').val() || '').trim() || null, entity_name: String($('#automationEntity').val() || '').trim().toLowerCase(), is_active: !!S.automation.is_active, workflow_json: S.workflow };
      return api('/api/automations/' + encodeURIComponent(automationId), { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).then(function (updated) {
        S.automation = updated;
        S.workflow = normalizeWorkflow(updated.workflow_json || S.workflow);
        renderCanvas();
        if (showMessage) window.alert(C.saveSuccess);
      });
    }

    function toggleActive() {
      if (!S.automation) return Promise.resolve();
      S.automation.is_active = !S.automation.is_active;
      return saveAutomation(false);
    }

    function executeNow() {
      const recordId = String($('#manualRecordId').val() || '').trim();
      return api('/api/automations/' + encodeURIComponent(automationId) + '/execute', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ record_id: recordId || undefined, payload: { source: 'builder' } }) }).then(function (output) {
        loadLogs();
        window.alert((locale === 'en' ? 'Execution completed with status: ' : locale === 'es' ? 'Ejecucion completada con estado: ' : 'Execucao concluida com status: ') + String(output && output.status || '-'));
      });
    }

    function loadLogs() {
      $('#automationLogsBody').html('<tr><td colspan="3" class="text-center">' + esc(C.loading) + '</td></tr>');
      const qs = new URLSearchParams();
      if (String($('#logStatusFilter').val() || '').trim()) qs.set('status', String($('#logStatusFilter').val() || '').trim());
      if (String($('#logFromFilter').val() || '').trim()) qs.set('from', String($('#logFromFilter').val() || '').trim());
      if (String($('#logToFilter').val() || '').trim()) qs.set('to', String($('#logToFilter').val() || '').trim());
      if (String($('#logSearchFilter').val() || '').trim()) qs.set('search', String($('#logSearchFilter').val() || '').trim());
      qs.set('limit', '200');
      return api('/api/automations/' + encodeURIComponent(automationId) + '/executions?' + qs.toString()).then(function (data) {
        const rows = arr(data);
        S.logs = rows;
        $('#automationLogsBody').html(rows.length ? rows.map(function (row, index) {
          return '<tr class="js-open-log" data-log-index="' + index + '"><td>' + esc(fmtDate(row.executed_at)) + '</td><td>' + statusLabel(row.status) + '</td><td><div class="automation-log-summary">' + esc(summarizeLog(row)) + '</div>' + renderLogMeta(row) + '</td></tr>';
        }).join('') : '<tr><td colspan="3" class="text-center">' + esc(C.noLogs) + '</td></tr>');
      });
    }

