<link href="/Assets/inspinia/css/plugins/summernote/summernote-bs4.css" rel="stylesheet" />
<style>
  .automation-builder-layout { display:grid; grid-template-columns:260px 1fr; gap:18px; }
  .builder-panel { border:1px solid #e4edf5; border-radius:12px; background:#fff; box-shadow:0 10px 30px rgba(16, 40, 67, .04); }
  .builder-panel-body { padding:16px; }
  .builder-palette .palette-item { border:1px solid #dce6ef; border-radius:10px; padding:12px; margin-bottom:10px; background:linear-gradient(180deg,#fff 0%,#f8fbfd 100%); cursor:grab; font-size:12px; transition:all .18s ease; }
  .builder-palette .palette-item:hover { border-color:#1c84c6; transform:translateY(-1px); }
  .builder-palette .palette-item.is-disabled { cursor:not-allowed; opacity:.55; background:#f3f5f7; border-color:#d7dde4; color:#7f8e9a; }
  .builder-palette .palette-title { font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:#7f93a6; margin:0 0 10px; }
  .builder-canvas { border:1px dashed #d4dce4; border-radius:14px; min-height:380px; padding:16px; background-size:24px 24px; background-image:linear-gradient(to right, rgba(0,0,0,.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,.03) 1px, transparent 1px); }
  .workflow-trigger-card,.workflow-action-card { border:1px solid #e1e7ec; border-left-width:4px; border-radius:12px; background:#fff; padding:14px 16px; margin-bottom:12px; cursor:pointer; box-shadow:0 8px 20px rgba(21,41,63,.05); }
  .workflow-trigger-card { border-left-color:#1ab394; }
  .workflow-action-card { border-left-color:#23c6c8; position:relative; }
  .workflow-action-card .btn-delete-action { position:absolute; top:10px; right:10px; border:0; background:transparent; color:#d9534f; font-size:14px; }
  .workflow-trigger-card.is-selected,.workflow-action-card.is-selected { box-shadow:0 0 0 2px rgba(28,132,198,.18), 0 12px 28px rgba(21,41,63,.08); }
  .builder-toolbar { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0 16px; align-items:center; }
  .record-lookup-wrap { position:relative; min-width:280px; }
  .record-lookup-menu { display:none; position:absolute; left:0; right:0; top:calc(100% + 2px); z-index:99999; max-height:220px; overflow-y:auto; background:#fff; border:1px solid #d9dee4; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.12); }
  .lookup-item { padding:8px 10px; border-bottom:1px solid #f0f2f4; cursor:pointer; }
  .lookup-item:last-child { border-bottom:0; }
  .lookup-item:hover { background:#f5f9fc; }
  .automation-offcanvas { position:fixed; top:0; right:-560px; width:560px; height:100vh; background:#fff; border-left:1px solid #d9dee4; box-shadow:-3px 0 14px rgba(0,0,0,.15); z-index:999999; display:flex; flex-direction:column; transition:right .2s ease; }
  .automation-offcanvas.is-open { right:0; }
  .automation-offcanvas-header { padding:14px 16px; border-bottom:1px solid #eef1f4; display:flex; justify-content:space-between; align-items:center; }
  .automation-offcanvas-body { padding:16px; overflow-y:auto; flex:1; }
  .automation-offcanvas-footer { padding:14px 16px; border-top:1px solid #eef1f4; text-align:right; }
  .automation-overlay { position:fixed; inset:0; background:rgba(0,0,0,.28); z-index:999998; display:none; }
  .automation-overlay.is-open { display:block; }
  .log-filters { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px; align-items:flex-end; }
  .log-filters .form-group { margin-bottom:0; }
  .automation-log-table tbody tr { cursor:pointer; transition:background .16s ease; }
  .automation-log-table tbody tr:hover { background:#f7fbfe; }
  .automation-log-summary { max-width:720px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:#4c6478; }
  .automation-log-meta { font-size:11px; color:#7f93a6; margin-top:4px; }
  .automation-log-json { max-height:320px; overflow:auto; background:#f7fafc; border:1px solid #e1e7ec; border-radius:10px; padding:12px; white-space:pre-wrap; word-break:break-word; }
  .automation-log-empty { color:#7f93a6; font-style:italic; }
  .automation-builder-tabs { margin-top:8px; }
  .automation-builder-tabs .nav-tabs { border-bottom:1px solid #dce6ef; }
  .automation-builder-tabs .nav-tabs > li > a { border-radius:10px 10px 0 0; color:#567086; }
  .automation-builder-tabs .nav-tabs > li.active > a,
  .automation-builder-tabs .nav-tabs > li.active > a:focus,
  .automation-builder-tabs .nav-tabs > li.active > a:hover { color:#23415c; font-weight:600; }
  .automation-tab-pane { padding-top:16px; }
  .config-card { border:1px solid #e6edf3; border-radius:10px; padding:14px; background:#fbfdff; margin-bottom:14px; }
  .config-card h5 { margin:0 0 10px; color:#274a63; }
  .mapping-row { border:1px solid #dde7f0; border-radius:10px; padding:12px; background:#fff; margin-bottom:10px; }
  .mapping-row-toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
  .mapping-editor-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .value-editor-note { font-size:12px; color:#73879a; margin-top:8px; }
  .action-summary-line,.trigger-summary-line { color:#688092; font-size:12px; margin-top:6px; }
  .action-name-pill { display:inline-flex; align-items:center; border-radius:999px; padding:4px 10px; background:#edf8fb; color:#227a8a; font-size:11px; margin-top:8px; }
  .field-token-list { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .field-token { display:inline-flex; align-items:center; border-radius:999px; background:#f1f6fb; border:1px solid #d8e4ef; color:#34516a; padding:4px 10px; font-size:11px; }
  .builder-note { border:1px solid #dbe8f2; border-radius:10px; background:#f5f9fd; color:#46627a; padding:12px; font-size:12px; }
  @media (max-width: 991px) {
    .automation-builder-layout { grid-template-columns:1fr; }
    .automation-offcanvas { width:100%; right:-100%; }
    .mapping-editor-grid { grid-template-columns:1fr; }
  }
</style>

