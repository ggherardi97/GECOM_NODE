    };
    COPY.en = Object.assign({}, COPY.pt, {
      builderTitle: 'Automation Builder',
      name: 'Name',
      entity: 'Entity',
      description: 'Description',
      optional: 'Optional',
      save: 'Save',
      executeNow: 'Run now',
      back: 'Back',
      palette: 'Palette',
      builderTab: 'Builder',
      logsTab: 'Logs',
      triggerOneOnly: 'Only one per flow.',
      actions: 'Actions',
      flowTitle: 'Linear flow',
      flowSubtitle: 'Drag actions from the palette and click blocks to configure them.',
      logs: 'Execution logs',
      from: 'From',
      to: 'To',
      search: 'Search',
      filter: 'Filter',
      refresh: 'Refresh',
      clear: 'Clear',
      dateTime: 'Date/Time',
      summary: 'Summary',
      error: 'Error',
      viewLog: 'Log details',
      noLogs: 'No logs found.',
      noError: 'No error recorded.',
      noData: 'No data.',
      triggerMatched: 'Trigger matched and action started.',
      triggerCreate: 'Create trigger executed.',
      triggerUpdate: 'Update trigger executed.',
      logSearchPlaceholder: 'Error, input, output',
      loading: 'Loading...',
      saveSuccess: 'Automation saved successfully.',
      saveFail: 'Failed to save automation.',
      loadFail: 'Failed to load automation.',
      executeFail: 'Failed to run automation.',
      logsFail: 'Failed to load logs.',
      invalidId: 'Invalid automation id.',
      close: 'Close',
      saveConfig: 'Save configuration'
    });
    COPY.es = Object.assign({}, COPY.pt, {
      builderTitle: 'Constructor de automatizaciones',
      name: 'Nombre',
      entity: 'Entidad',
      description: 'Descripcion',
      optional: 'Opcional',
      save: 'Guardar',
      executeNow: 'Ejecutar ahora',
      back: 'Volver',
      palette: 'Paleta',
      builderTab: 'Builder',
      logsTab: 'Logs',
      actions: 'Acciones',
      flowTitle: 'Flujo lineal',
      flowSubtitle: 'Arrastra acciones de la paleta y haz clic en los bloques para configurarlos.',
      logs: 'Logs de ejecucion',
      status: 'Estado',
      from: 'Desde',
      to: 'Hasta',
      search: 'Busqueda',
      filter: 'Filtrar',
      refresh: 'Actualizar',
      clear: 'Limpiar',
      dateTime: 'Fecha/Hora',
      summary: 'Resumen',
      error: 'Error',
      viewLog: 'Detalles del log',
      noLogs: 'No se encontraron logs.',
      noError: 'No se registro ningun error.',
      noData: 'Sin datos.',
      triggerMatched: 'El trigger se ejecuto y la accion comenzo.',
      triggerCreate: 'Se ejecuto el trigger de creacion.',
      triggerUpdate: 'Se ejecuto el trigger de actualizacion.',
      logSearchPlaceholder: 'Error, input, output',
      loading: 'Cargando...',
      saveSuccess: 'Automatizacion guardada con exito.',
      saveFail: 'No se pudo guardar la automatizacion.',
      loadFail: 'No se pudo cargar la automatizacion.',
      executeFail: 'No se pudo ejecutar la automatizacion.',
      logsFail: 'No se pudieron cargar los logs.',
      invalidId: 'ID de automatizacion invalido.',
      close: 'Cerrar',
      saveConfig: 'Guardar configuracion'
    });

    const C = COPY[locale];
    const ACTION_DEFS = [];
    const TRIGGER_TYPES = [];
    const EVENT_TYPES = [];
    const CONDITION_OPERATORS = ['EQUALS','NOT_EQUALS','CONTAINS','GREATER_THAN','LESS_THAN','GREATER_OR_EQUAL','LESS_OR_EQUAL','CHANGED_TO','CHANGED_FROM','IS_TRUE','IS_FALSE','NOT_EMPTY','IS_EMPTY'];
    const S = {
      automation: null,
      entities: [],
      entityMap: {},
      fieldsByEntity: { all: {}, writable: {} },
      selectedNode: null,
      logs: [],
      whatsapp: { enabled: false, integrations: [] },
      workflow: { version: 1, trigger: { type: 'MANUAL', config: {} }, actions: [], ui: { nodes: [{ id: 'trigger', x: 120, y: 80 }] } }
    };

    function esc(v) {
      return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function arr(d) {
      if (Array.isArray(d)) return d;
      if (Array.isArray(d && d.data)) return d.data;
      if (Array.isArray(d && d.rows)) return d.rows;
      if (Array.isArray(d && d.items)) return d.items;
      return [];
    }

    function api(url, opt) {
      return fetch(url, Object.assign({ credentials: 'include' }, opt || {}))
        .then((r) => r.text().then((t) => ({ ok: r.ok, status: r.status, text: t })))
        .then((r) => {
          let data = {};
          try { data = r.text ? JSON.parse(r.text) : {}; } catch (_e) { data = { message: r.text }; }
          if (!r.ok) throw new Error((data && data.message) || ('HTTP ' + r.status));
          return data;
        });
    }

    function uuid() {
      if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
      return 'a' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    }

    ACTION_DEFS.push(
      { type: 'UPDATE_FIELD', icon: 'fa-pencil', label: { pt: 'Atualizar campo', en: 'Update field', es: 'Actualizar campo' } },
      { type: 'SEND_EMAIL', icon: 'fa-envelope', label: { pt: 'Enviar email', en: 'Send email', es: 'Enviar email' } },
      { type: 'CREATE_TASK', icon: 'fa-tasks', label: { pt: 'Create Task', en: 'Create task', es: 'Crear tarea' } },
      { type: 'WEBHOOK', icon: 'fa-exchange', label: { pt: 'Webhook', en: 'Webhook', es: 'Webhook' } },
      { type: 'AI_ACTION', icon: 'fa-magic', label: { pt: 'AI Action', en: 'AI Action', es: 'AI Action' } },
      { type: 'CREATE_REGISTER', icon: 'fa-database', label: { pt: 'Criar registro', en: 'Create record', es: 'Crear registro' } },
      { type: 'WHATSAPP', icon: 'fa-whatsapp', label: { pt: 'WhatsApp', en: 'WhatsApp', es: 'WhatsApp' } }
    );
    TRIGGER_TYPES.push(
      { value: 'MANUAL', label: locale === 'pt' ? 'Manual' : locale === 'es' ? 'Manual' : 'Manual' },
      { value: 'ENTITY_EVENT', label: locale === 'pt' ? 'Evento da entidade' : locale === 'es' ? 'Evento de entidad' : 'Entity event' },
      { value: 'SCHEDULE', label: locale === 'pt' ? 'Agendado' : locale === 'es' ? 'Programado' : 'Scheduled' }
    );
    EVENT_TYPES.push(
      { value: 'CREATE', label: locale === 'pt' ? 'Criado' : locale === 'es' ? 'Creado' : 'Created' },
      { value: 'UPDATE', label: locale === 'pt' ? 'Atualizado' : locale === 'es' ? 'Actualizado' : 'Updated' }
    );

    function humanize(value) {
      return String(value || '').replace(/_/g, ' ').replace(/\b\w/g, function (s) { return s.toUpperCase(); });
    }

    function entityLabel(name) {
      const normalized = String(name || '').trim().toLowerCase();
      return (S.entityMap[normalized] && S.entityMap[normalized].label) || humanize(normalized || '');
    }

    function defaultActionTitle(type, index) {
      const def = ACTION_DEFS.find(function (item) { return item.type === type; });
      const base = def ? (def.label[locale] || def.label.pt) : humanize(type);
      return base + ' ' + (index + 1);
    }

    function defaultConfig(type) {
      if (type === 'UPDATE_FIELD') return { name: '', entityName: '', targetMode: 'CONTEXT', recordId: '', recordLabel: '', field: '', value: '', valueSource: 'FIXED', dynamicField: '' };
      if (type === 'SEND_EMAIL') return { name: '', to: '', cc: '', bcc: '', subject: '', body: '' };
      if (type === 'WEBHOOK') return { name: '', url: '', method: 'POST', headers: {}, body: {} };
      if (type === 'CREATE_TASK') return { name: '', title: '', description: '' };
      if (type === 'AI_ACTION') return { name: '', prompt: '', instructions: '', outputKey: 'ai_result' };
      if (type === 'CREATE_REGISTER') return { name: '', entityName: '', fieldMappings: [] };
      if (type === 'WHATSAPP') return { name: '', integrationId: '', recipientMode: 'TRIGGER_FIELD', phoneField: '', to: '', message: '' };
      return { name: '' };
    }

    function normalizeWorkflow(input) {
      if (!input || typeof input !== 'object') return { version: 1, trigger: { type: 'MANUAL', config: {} }, actions: [], ui: { nodes: [{ id: 'trigger', x: 120, y: 80 }] } };
      const trigger = input.trigger && typeof input.trigger === 'object' ? input.trigger : { type: 'MANUAL', config: {} };
      const actions = Array.isArray(input.actions) ? input.actions : [];
      return {
        version: 1,
        trigger: {
          type: String(trigger.type || 'MANUAL').toUpperCase(),
          config: trigger.config && typeof trigger.config === 'object' ? trigger.config : {}
        },
        actions: actions.filter(Boolean).map(function (item, index) {
          return {
            id: String(item.id || ('action_' + (index + 1))),
            type: String(item.type || 'UPDATE_FIELD').toUpperCase(),
            config: Object.assign({}, defaultConfig(String(item.type || 'UPDATE_FIELD').toUpperCase()), item.config || {})
          };
        }),
        ui: input.ui && typeof input.ui === 'object' ? input.ui : { nodes: [{ id: 'trigger', x: 120, y: 80 }] }
      };
    }

    function fmtDate(v) {
      if (!v) return '-';
      const d = new Date(v);
      return Number.isNaN(d.getTime()) ? '-' : d.toLocaleString(locale === 'pt' ? 'pt-BR' : locale === 'es' ? 'es-ES' : 'en-US');
    }

    function j(v) {
      try { return JSON.stringify(v == null ? {} : v, null, 2); } catch (_e) { return '{}'; }
    }

    function parseJson(v) {
      try {
        const parsed = JSON.parse(String(v || '').trim() || '{}');
        return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
      } catch (_e) {
        return {};
      }
    }

    function isSameTriggerEntity(entityName) {
      const triggerEntity = String((S.workflow.trigger && S.workflow.trigger.config && S.workflow.trigger.config.entityName) || $('#automationEntity').val() || '').trim().toLowerCase();
      return !!triggerEntity && triggerEntity === String(entityName || '').trim().toLowerCase();
    }

    function triggerTokenForField(fieldName) {
      const triggerType = String(S.workflow.trigger && S.workflow.trigger.type || 'MANUAL').toUpperCase();
      if (triggerType === 'ENTITY_EVENT') return '{{payload.after.' + fieldName + '}}';
      return '{{payload.' + fieldName + '}}';
    }

    function parseValueBinding(value) {
      const raw = String(value == null ? '' : value).trim();
      if (!raw) return { source: 'FIXED', value: '', dynamicField: '' };
      if (raw === '{{recordId}}') return { source: 'CONTEXT_RECORD_ID', value: raw, dynamicField: '' };
      const payloadMatch = raw.match(/^{{\s*payload\.(?:after\.)?([a-zA-Z0-9_]+)\s*}}$/);
      if (payloadMatch) return { source: 'TRIGGER_FIELD', value: raw, dynamicField: payloadMatch[1] };
      if (raw.indexOf('{{') >= 0) return { source: 'TEMPLATE', value: raw, dynamicField: '' };
      return { source: 'FIXED', value: raw, dynamicField: '' };
    }

    function compileValueBinding(source, rawValue, dynamicField) {
      if (source === 'CONTEXT_RECORD_ID') return '{{recordId}}';
      if (source === 'TRIGGER_FIELD') return dynamicField ? triggerTokenForField(dynamicField) : '';
      if (source === 'TEMPLATE') return String(rawValue || '').trim();
      return String(rawValue == null ? '' : rawValue).trim();
    }

    function statusLabel(s) {
      const n = String(s || '').toUpperCase();
      if (n === 'SUCCESS') return '<span class="label label-primary">SUCCESS</span>';
      if (n === 'ERROR') return '<span class="label label-danger">ERROR</span>';
      return '<span class="label label-default">-</span>';
    }

    function summarizeLog(row) {
      if (!row || typeof row !== 'object') return C.noData;
      const error = String(row.error_message || '').trim();
      if (error) return error;
      const output = row.output_payload && typeof row.output_payload === 'object' ? row.output_payload : {};
      const input = row.input_payload && typeof row.input_payload === 'object' ? row.input_payload : {};
      if (String(output.message || '').trim()) return String(output.message || '').trim();
      if (String(output.result || '').trim()) return String(output.result || '').trim();
      if (String(output.status || '').trim()) return String(output.status || '').trim();
      if (String(input.recordId || '').trim()) return C.triggerMatched + ' recordId=' + String(input.recordId).trim();
      if (String(input.eventType || '').trim().toUpperCase() === 'CREATE') return C.triggerCreate;
      if (String(input.eventType || '').trim().toUpperCase() === 'UPDATE') return C.triggerUpdate;
      return C.noData;
    }

    function renderLogMeta(row) {
      if (!row || typeof row !== 'object') return '';
      const pieces = [];
      if (row.input_payload && typeof row.input_payload === 'object') {
        if (row.input_payload.entityName) pieces.push('entity=' + String(row.input_payload.entityName));
        if (row.input_payload.eventType) pieces.push('event=' + String(row.input_payload.eventType));
        if (row.input_payload.recordId) pieces.push('record=' + String(row.input_payload.recordId));
      }
      return pieces.length ? '<div class="automation-log-meta">' + esc(pieces.join(' · ')) + '</div>' : '';
    }

    function openLogModal(index) {
      const row = S.logs[index];
      if (!row) return;
      $('#automationLogModalTitle').text(C.viewLog);
      $('#automationLogModalDate').text(fmtDate(row.executed_at));
      $('#automationLogModalStatus').html(statusLabel(row.status));
      $('#automationLogModalSummary').text(summarizeLog(row));
      const errorMessage = String(row.error_message || '').trim();
      $('#automationLogModalError')
        .text(errorMessage || C.noError)
        .toggleClass('automation-log-empty', !errorMessage);
      $('#automationLogModalInput').text(j(row.input_payload || {}));
      $('#automationLogModalOutput').text(j(row.output_payload || {}));
      $('#automationLogModal').modal('show');
    }

    function actionLabel(type) {
      const def = ACTION_DEFS.find(function (item) { return item.type === type; });
      return def ? (def.label[locale] || def.label.pt) : humanize(type);
    }

    function entityOptions(selected) {
      return S.entities.map(function (entity) {
        return '<option value="' + esc(entity.name) + '" ' + (entity.name === selected ? 'selected' : '') + '>' + esc(entity.label || humanize(entity.name)) + '</option>';
      }).join('');
    }

    function operatorOptions(selected) {
      return CONDITION_OPERATORS.map(function (item) {
        return '<option value="' + esc(item) + '" ' + (String(selected || '') === item ? 'selected' : '') + '>' + esc(item) + '</option>';
      }).join('');
    }

    function triggerTypeOptions(selected) {
      return TRIGGER_TYPES.map(function (item) {
        return '<option value="' + item.value + '" ' + (item.value === selected ? 'selected' : '') + '>' + esc(item.label) + '</option>';
      }).join('');
    }

    function eventTypeOptions(selected) {
      return EVENT_TYPES.map(function (item) {
        return '<option value="' + item.value + '" ' + (item.value === selected ? 'selected' : '') + '>' + esc(item.label) + '</option>';
      }).join('');
    }

    function syncNodes() {
      const nodes = [{ id: 'trigger', x: 120, y: 80 }];
      S.workflow.actions.forEach(function (action, index) {
        nodes.push({ id: action.id, x: 380 + index * 250, y: 80 });
      });
      S.workflow.ui = { nodes: nodes };
    }

    function triggerConditionSummary(config) {
      const condition = config && typeof config === 'object' ? config.condition : null;
      if (!condition || typeof condition !== 'object') return '';
      const field = String(condition.field || '').trim();
      const operator = String(condition.operator || '').trim().toUpperCase();
      const value = condition.value == null ? '' : String(condition.value).trim();
      if (!field || !operator) return '';
      const label = locale === 'en' ? 'Condition' : locale === 'es' ? 'Condicion' : 'Condicao';
      return label + ': ' + field + ' ' + operator + (value ? ' ' + value : '');
    }

    function actionSummary(action) {
      const config = action.config || {};
      if (action.type === 'UPDATE_FIELD') return (config.field ? config.field + ' <- ' : '') + (config.value ? String(config.value).slice(0, 60) : '-');
      if (action.type === 'SEND_EMAIL') return String(config.to || '').trim() || '-';
      if (action.type === 'WEBHOOK') return String(config.url || '').trim() || '-';
      if (action.type === 'CREATE_TASK') return String(config.title || '').trim() || 'MVP/stub';
      if (action.type === 'AI_ACTION') return String(config.outputKey || 'ai_result');
      if (action.type === 'CREATE_REGISTER') return String(config.entityName || '').trim() || '-';
      if (action.type === 'WHATSAPP') return String(config.to || config.phoneField || '').trim() || '-';
      return '-';
    }

    function renderPalette() {
      $('#paletteActions').html(ACTION_DEFS.map(function (item) {
        const isDisabled = item.type === 'WHATSAPP' && !S.whatsapp.enabled;
        const title = isDisabled
          ? (locale === 'en' ? 'You do not have a configured WhatsApp instance.' : locale === 'es' ? 'No tienes una instancia de WhatsApp configurada.' : 'Voce nao possui instancia de Whats app configurada.')
          : '';
        return '<div class="palette-item ' + (isDisabled ? 'is-disabled' : '') + '" data-toggle="tooltip" title="' + esc(title) + '" data-action-type="' + esc(item.type) + '" data-disabled="' + (isDisabled ? '1' : '0') + '">' +
          '<strong><i class="fa ' + esc(item.icon) + '"></i> ' + esc(item.label[locale] || item.label.pt) + '</strong><br>' +
          '<span>' + esc(item.type) + '</span></div>';
      }).join(''));
      $('[data-toggle="tooltip"]').tooltip();
    }

    function renderCanvas() {
      syncNodes();
      const trigger = S.workflow.trigger || { type: 'MANUAL', config: {} };
      const config = trigger.config && typeof trigger.config === 'object' ? trigger.config : {};
      const triggerLines = ['<div class="trigger-summary-line"><strong>' + esc(locale === 'en' ? 'Type' : locale === 'es' ? 'Tipo' : 'Tipo') + ':</strong> ' + esc(trigger.type) + '</div>'];
      if (config.entityName) triggerLines.push('<div class="trigger-summary-line"><strong>' + esc(C.entity) + ':</strong> ' + esc(entityLabel(config.entityName)) + '</div>');
      if (config.eventType) triggerLines.push('<div class="trigger-summary-line"><strong>' + esc(locale === 'en' ? 'Event' : locale === 'es' ? 'Evento' : 'Evento') + ':</strong> ' + esc(config.eventType) + '</div>');
      if (config.fieldChanged) triggerLines.push('<div class="trigger-summary-line"><strong>' + esc(locale === 'en' ? 'Changed field' : locale === 'es' ? 'Campo alterado' : 'Campo alterado') + ':</strong> ' + esc(config.fieldChanged) + '</div>');
      if (config.cron) triggerLines.push('<div class="trigger-summary-line"><strong>Cron:</strong> ' + esc(config.cron) + '</div>');
      const conditionText = triggerConditionSummary(config);
      if (conditionText) triggerLines.push('<div class="trigger-summary-line">' + esc(conditionText) + '</div>');

      $('#workflowTriggerHost').html('<div id="workflowTriggerCard" class="workflow-trigger-card ' + (S.selectedNode && S.selectedNode.kind === 'trigger' ? 'is-selected' : '') + '">' +
        '<strong>' + esc(C.trigger) + '</strong>' + triggerLines.join('') + '</div>');

      $('#workflowActionsList').html(S.workflow.actions.map(function (action, index) {
        const displayName = String(action.config && action.config.name || '').trim() || defaultActionTitle(action.type, index);
        return '<div class="workflow-action-card ' + (S.selectedNode && S.selectedNode.kind === 'action' && S.selectedNode.id === action.id ? 'is-selected' : '') + '" data-action-id="' + esc(action.id) + '">' +
          '<button type="button" class="btn-delete-action js-delete-action" data-action-id="' + esc(action.id) + '"><i class="fa fa-trash"></i></button>' +
          '<div><strong>' + esc(displayName) + '</strong></div>' +
          '<div class="action-summary-line"><strong>' + esc(locale === 'en' ? 'Type' : locale === 'es' ? 'Tipo' : 'Tipo') + ':</strong> ' + esc(actionLabel(action.type)) + '</div>' +
          '<div class="action-summary-line">' + esc(actionSummary(action)) + '</div>' +
          '<div class="action-name-pill">' + esc(action.type) + '</div>' +
        '</div>';
      }).join(''));
    }

    function openOffcanvas(title, html) {
      $('#offcanvasTitle').text(title);
      $('#offcanvasBody').html(html);
      $('#automationOverlay').addClass('is-open');
      $('#automationOffcanvas').addClass('is-open');
    }

    function closeOffcanvas() {
      try { if ($('#cfgBody').data('summernote')) $('#cfgBody').summernote('destroy'); } catch (_e) {}
      $('#automationOverlay').removeClass('is-open');
      $('#automationOffcanvas').removeClass('is-open');
    }

    function initLookup(inputSel, idSel, menuSel, getEntity) {
      const $input = $(inputSel);
      const $id = $(idSel);
      const $menu = $(menuSel);
      if (!$input.length || !$menu.length) return;
      let timer = null;
      let requestId = 0;
      function draw(rows) {
        const noneText = locale === 'en' ? 'No records found.' : locale === 'es' ? 'No se encontraron registros.' : 'Nenhum registro encontrado.';
        $menu.html(rows.length ? rows.map(function (row) {
          return '<div class="lookup-item" data-id="' + esc(row.id) + '" data-label="' + esc(row.label) + '"><div><strong>' + esc(row.label || row.id) + '</strong></div>' + (row.subtitle ? '<div style="font-size:11px;color:#81909c;">' + esc(row.subtitle) + '</div>' : '') + '</div>';
        }).join('') : '<div class="lookup-item">' + esc(noneText) + '</div>').show();
      }
      function run(term) {
        const entity = String(getEntity() || '').trim().toLowerCase();
        if (!entity) { $menu.hide(); return; }
        const token = ++requestId;
        const qs = new URLSearchParams();
        if (String(term || '').trim()) qs.set('q', String(term || '').trim());
        qs.set('limit', '10');
        api('/api/automations/metadata/entities/' + encodeURIComponent(entity) + '/records?' + qs.toString())
          .then(function (data) { if (token === requestId) draw(arr(data)); })
          .catch(function () { if (token === requestId) $menu.html('<div class="lookup-item">Falha ao carregar.</div>').show(); });
      }
      $input.off('.lk');
      $menu.off('.lk');
      $input.on('focus.lk', function () { run(''); });
      $input.on('input.lk', function () {
        $id.val('');
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () { run(String($input.val() || '')); }, 250);
      });
      $menu.on('mousedown.lk', '.lookup-item', function (ev) {
        ev.preventDefault();
        const id = String($(this).data('id') || '').trim();
        const label = String($(this).data('label') || '').trim();
        if (!id) return;
        $id.val(id);
        $input.val(label || id);
        $menu.hide();
      });
      $input.on('blur.lk', function () { setTimeout(function () { $menu.hide(); }, 150); });
    }

    function loadEntities() {
      return api('/api/automations/metadata/entities').then(function (data) {
        S.entities = arr(data).map(function (row) {
          return { name: String(row.name || '').trim().toLowerCase(), label: String(row.label || '').trim() || humanize(row.name) };
        }).filter(function (row) { return row.name; });
        S.entityMap = {};
        S.entities.forEach(function (entity) { S.entityMap[entity.name] = entity; });
        $('#automationEntity').html(entityOptions(String($('#automationEntity').val() || '')));
      });
    }

    function loadWhatsappMeta() {
      return api('/api/sales/whatsapp/integrations').then(function (data) {
        const rows = arr(data).map(function (row) {
          return { id: String(row.id || '').trim(), name: String(row.name || '').trim() || 'WhatsApp', status: String(row.status || '').trim(), is_active: row.is_active !== false };
        }).filter(function (row) { return row.id; });
        S.whatsapp.integrations = rows;
        S.whatsapp.enabled = rows.some(function (row) { return row.is_active; });
      }).catch(function () {
        S.whatsapp.integrations = [];
        S.whatsapp.enabled = false;
      }).then(renderPalette);
    }

    function loadFields(entityName, scope) {
      const normalized = String(entityName || '').trim().toLowerCase();
      const effectiveScope = scope === 'all' ? 'all' : 'writable';
      if (!normalized) return Promise.resolve([]);
      if (Array.isArray(S.fieldsByEntity[effectiveScope][normalized])) return Promise.resolve(S.fieldsByEntity[effectiveScope][normalized]);
      const qs = effectiveScope === 'all' ? '?scope=all' : '';
      return api('/api/automations/metadata/entities/' + encodeURIComponent(normalized) + '/fields' + qs).then(function (data) {
        S.fieldsByEntity[effectiveScope][normalized] = arr(data).map(function (row) {
          return {
            name: String(row.name || '').trim().toLowerCase(),
            label: String(row.label || '').trim() || humanize(row.name || ''),
            dataType: String(row.dataType || '').trim(),
            writable: row.writable !== false,
            required: !!row.required,
            relationEntity: row.relationEntity ? String(row.relationEntity).trim().toLowerCase() : '',
            relationLabel: row.relationLabel ? String(row.relationLabel).trim() : '',
            options: Array.isArray(row.options) ? row.options.map(function (opt) { return { value: String(opt.value || '').trim(), label: String(opt.label || '').trim() || String(opt.value || '').trim() }; }) : []
          };
        }).filter(function (row) { return row.name; });
        return S.fieldsByEntity[effectiveScope][normalized];
      });
    }

    function fieldByName(entityName, fieldName, scope) {
      const normalizedEntity = String(entityName || '').trim().toLowerCase();
      const normalizedField = String(fieldName || '').trim().toLowerCase();
      const list = S.fieldsByEntity[scope === 'all' ? 'all' : 'writable'][normalizedEntity] || [];
      return list.find(function (item) { return item.name === normalizedField; }) || null;
    }

    function fixedValueMarkup(prefix, fieldMeta, value) {
      if (fieldMeta && fieldMeta.options && fieldMeta.options.length) {
        return '<select id="' + prefix + 'FixedValue" class="form-control">' + fieldMeta.options.map(function (option) {
          return '<option value="' + esc(option.value) + '" ' + (String(value || '') === option.value ? 'selected' : '') + '>' + esc(option.label) + '</option>';
        }).join('') + '</select>';
      }
      if (fieldMeta && fieldMeta.relationEntity) {
        return '<div class="record-lookup-wrap"><input id="' + prefix + 'LookupLabel" class="form-control" value="' + esc(value || '') + '" placeholder="Buscar registro" /><input id="' + prefix + 'LookupId" type="hidden" value="' + esc(value || '') + '" /><div id="' + prefix + 'LookupMenu" class="record-lookup-menu"></div></div>';
      }
      return '<input id="' + prefix + 'FixedValue" class="form-control" value="' + esc(value || '') + '" placeholder="Digite o valor" />';
    }

    function initFixedLookup(prefix, fieldMeta) {
      if (fieldMeta && fieldMeta.relationEntity) {
        initLookup('#' + prefix + 'LookupLabel', '#' + prefix + 'LookupId', '#' + prefix + 'LookupMenu', function () { return fieldMeta.relationEntity; });
      }
    }

    function readFixedValue(prefix, fieldMeta) {
      if (fieldMeta && fieldMeta.options && fieldMeta.options.length) return String($('#' + prefix + 'FixedValue').val() || '').trim();
      if (fieldMeta && fieldMeta.relationEntity) return String($('#' + prefix + 'LookupId').val() || $('#' + prefix + 'LookupLabel').val() || '').trim();
      return String($('#' + prefix + 'FixedValue').val() || '').trim();
    }

    function openTrigger() {
      S.selectedNode = { kind: 'trigger' };
      const trigger = S.workflow.trigger || { type: 'MANUAL', config: {} };
      const config = trigger.config || {};
      const condition = config.condition || {};
      const entityName = String(config.entityName || $('#automationEntity').val() || '').trim().toLowerCase();
      openOffcanvas(locale === 'en' ? 'Trigger configuration' : locale === 'es' ? 'Configuracion del trigger' : 'Configuracao do trigger',
        '<div class="form-group"><label>Tipo</label><select id="cfgTriggerType" class="form-control">' + triggerTypeOptions(trigger.type) + '</select></div>' +
        '<div id="cfgTriggerEntityWrap" style="display:' + (trigger.type === 'ENTITY_EVENT' ? 'block' : 'none') + ';">' +
          '<div class="form-group"><label>' + esc(C.entity) + '</label><select id="cfgTriggerEntityName" class="form-control">' + entityOptions(entityName) + '</select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Event' : 'Evento') + '</label><select id="cfgTriggerEventType" class="form-control">' + eventTypeOptions(String(config.eventType || 'CREATE').toUpperCase()) + '</select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Changed field' : locale === 'es' ? 'Campo alterado' : 'Campo alterado') + '</label><select id="cfgTriggerFieldChanged" class="form-control"></select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Condition field' : locale === 'es' ? 'Campo de condicion' : 'Campo da condicao') + '</label><select id="cfgTriggerConditionField" class="form-control"></select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Operator' : locale === 'es' ? 'Operador' : 'Operador') + '</label><select id="cfgTriggerConditionOperator" class="form-control">' + operatorOptions(String(condition.operator || 'EQUALS').toUpperCase()) + '</select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Source' : locale === 'es' ? 'Origen' : 'Origem') + '</label><select id="cfgTriggerConditionSource" class="form-control"><option value="after">after</option><option value="before">before</option></select></div>' +
          '<div class="form-group"><label>' + esc(locale === 'en' ? 'Value' : locale === 'es' ? 'Valor' : 'Valor') + '</label><div id="cfgTriggerConditionValueWrap"></div></div>' +
        '</div>' +
        '<div id="cfgTriggerScheduleWrap" style="display:' + (trigger.type === 'SCHEDULE' ? 'block' : 'none') + ';">' +
          '<div class="form-group"><label>Cron</label><input id="cfgTriggerCron" class="form-control" value="' + esc(config.cron || '') + '" placeholder="0 9 * * *" /></div>' +
          '<div class="form-group"><label>Timezone</label><input id="cfgTriggerTimezone" class="form-control" value="' + esc(config.timezone || 'America/Sao_Paulo') + '" /></div>' +
        '</div>'
      );
      $('#cfgTriggerConditionSource').val(String(condition.source || 'after'));
      $('#cfgTriggerType').on('change', function () {
        const value = String($(this).val() || 'MANUAL').toUpperCase();
        $('#cfgTriggerEntityWrap').toggle(value === 'ENTITY_EVENT');
        $('#cfgTriggerScheduleWrap').toggle(value === 'SCHEDULE');
      });
      loadFields(entityName, 'all').then(function (fields) {
        const options = '<option value=""></option>' + fields.map(function (field) { return '<option value="' + esc(field.name) + '">' + esc(field.label) + '</option>'; }).join('');
        $('#cfgTriggerFieldChanged').html('<option value=""></option>' + fields.map(function (field) { return '<option value="' + esc(field.name) + '">' + esc(field.label) + '</option>'; }).join('')).val(String(config.fieldChanged || '').trim().toLowerCase());
        $('#cfgTriggerConditionField').html(options).val(String(condition.field || '').trim().toLowerCase());
        function refreshValue() {
          const fieldMeta = fieldByName(entityName, $('#cfgTriggerConditionField').val(), 'all');
          const operator = String($('#cfgTriggerConditionOperator').val() || 'EQUALS').toUpperCase();
          if (['IS_TRUE','IS_FALSE','NOT_EMPTY','IS_EMPTY'].indexOf(operator) >= 0) {
            $('#cfgTriggerConditionValueWrap').html('');
            return;
          }
          $('#cfgTriggerConditionValueWrap').html(fixedValueMarkup('cfgTriggerCondition', fieldMeta, condition.value));
          initFixedLookup('cfgTriggerCondition', fieldMeta);
        }
        $('#cfgTriggerConditionField,#cfgTriggerConditionOperator').on('change', refreshValue);
        refreshValue();
      });
    }

    function openAction(actionId) {
      const action = S.workflow.actions.find(function (item) { return item.id === actionId; });
      if (!action) return;
      S.selectedNode = { kind: 'action', id: action.id };
      const config = action.config || {};
      const actionName = String(config.name || '').trim();
      let html = '<div class="form-group"><label>' + esc(locale === 'en' ? 'Action name' : locale === 'es' ? 'Nombre de la accion' : 'Nome da acao') + '</label><input id="cfgActionName" class="form-control" value="' + esc(actionName) + '" /></div>' +
        '<div class="form-group"><label>Tipo</label><input class="form-control" value="' + esc(actionLabel(action.type)) + '" disabled /></div>';

      if (action.type === 'UPDATE_FIELD') {
