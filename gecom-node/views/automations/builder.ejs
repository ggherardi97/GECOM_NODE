      } else if (action.type === 'AI_ACTION') {
        html += '<div class="builder-note">A AI action recebe o contexto do registro e o catalogo do ERP.</div><div class="form-group"><label>Prompt</label><textarea id="cfgAiPrompt" class="form-control" rows="5">' + esc(config.prompt || '') + '</textarea></div><div class="form-group"><label>Instrucoes extras</label><textarea id="cfgAiInstructions" class="form-control" rows="3">' + esc(config.instructions || '') + '</textarea></div><div class="form-group"><label>Output key</label><input id="cfgAiOutputKey" class="form-control" value="' + esc(config.outputKey || 'ai_result') + '" /></div>';
      } else if (action.type === 'CREATE_REGISTER') {
        html += '<div class="builder-note">Suporta valores fixos e dinamicos do trigger. Relacoes com a tabela do trigger devem usar {{recordId}} ou campos do payload.</div><div class="form-group"><label>Tabela destino</label><select id="cfgCreateRegisterEntity" class="form-control">' + entityOptions(String(config.entityName || $('#automationEntity').val() || '').trim().toLowerCase()) + '</select></div><div class="form-group"><label>Mapeamentos JSON</label><textarea id="cfgCreateRegisterMappingsJson" class="form-control" rows="8">' + esc(j(config.fieldMappings || [])) + '</textarea></div>';
      } else if (action.type === 'WHATSAPP') {
        html += '<div class="form-group"><label>Instancia</label><select id="cfgWhatsappIntegration" class="form-control">' + S.whatsapp.integrations.map(function (row) { return '<option value="' + esc(row.id) + '" ' + (row.id === String(config.integrationId || '') ? 'selected' : '') + '>' + esc(row.name + (row.status ? ' (' + row.status + ')' : '')) + '</option>'; }).join('') + '</select></div><div class="form-group"><label>Modo</label><select id="cfgWhatsappRecipientMode" class="form-control"><option value="MANUAL">MANUAL</option><option value="TRIGGER_FIELD">TRIGGER_FIELD</option><option value="TEMPLATE">TEMPLATE</option></select></div><div class="form-group"><label>Destino</label><div id="cfgWhatsappRecipientWrap"></div></div><div class="form-group"><label>Mensagem</label><textarea id="cfgWhatsappMessage" class="form-control" rows="4">' + esc(config.message || '') + '</textarea></div>';
      }
      html += '<hr><button type="button" id="btnDeleteAction" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Excluir bloco</button>';
