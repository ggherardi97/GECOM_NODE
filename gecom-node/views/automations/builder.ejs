      $('#subpageName').text(C.actions).attr('href', '/automations');
      $('#path').show();
      $('#subSecoundPageName').text(C.builderTitle).attr('href', window.location.pathname);
      if (!automationId) { window.alert(C.invalidId); return; }
      setupSortables();
      $('#btnCloseOffcanvas,#automationOverlay').on('click', closeOffcanvas);
      $('#btnSaveOffcanvas').on('click', saveOffcanvas);
      $('#btnSaveAutomation').on('click', function () { saveAutomation(true).catch(function (error) { window.alert((error && error.message) || C.saveFail); }); });
      $('#btnToggleActive').on('click', function () { toggleActive().catch(function (error) { window.alert((error && error.message) || C.saveFail); }); });
      $('#btnExecuteNow').on('click', function () { executeNow().catch(function (error) { window.alert((error && error.message) || C.executeFail); }); });
      $('#automationEntity').on('change', function () { const entityName = String($(this).val() || '').trim().toLowerCase(); loadFields(entityName, 'all').then(function () { return loadFields(entityName, 'writable'); }).then(renderCanvas); initLookup('#manualRecordLookup', '#manualRecordId', '#manualRecordMenu', function () { return $('#automationEntity').val(); }); $('#manualRecordLookup').val(''); $('#manualRecordId').val(''); });
      $('#btnApplyLogFilters').on('click', function () { loadLogs().catch(function (error) { window.alert((error && error.message) || C.logsFail); }); });
      $('#btnRefreshLogs').on('click', function () { loadLogs().catch(function (error) { window.alert((error && error.message) || C.logsFail); }); });
      $('#btnClearLogFilters').on('click', function () { $('#logStatusFilter,#logFromFilter,#logToFilter,#logSearchFilter').val(''); loadLogs().catch(function (error) { window.alert((error && error.message) || C.logsFail); }); });
      Promise.all([loadEntities(), loadWhatsappMeta()]).then(function () { return loadAutomation(); }).then(function () { return loadLogs(); }).catch(function (error) { window.alert((error && error.message) || C.loadFail); });
    });
  })();
</script>
