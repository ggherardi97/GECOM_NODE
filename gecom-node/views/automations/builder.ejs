    $(document).on('click', '#workflowTriggerCard', openTrigger);
    $(document).on('click', '.workflow-action-card', function () { const actionId = String($(this).data('action-id') || '').trim(); if (actionId) { openAction(actionId); const action = S.workflow.actions.find(function (item) { return item.id === actionId; }); if (action && action.type === 'UPDATE_FIELD') populateUpdateAction(action.config); if (action && action.type === 'WHATSAPP') { loadFields($('#automationEntity').val(), 'all').then(function () { renderWhatsappRecipient(action.config); $('#cfgWhatsappRecipientMode').on('change', function () { renderWhatsappRecipient(action.config); }); }); } } });
