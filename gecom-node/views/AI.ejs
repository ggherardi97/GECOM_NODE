<style>
  #masterHeader{ display:none;}
  .ai-hub-shell { display:flex; flex-direction:column; gap:18px; }
  .ai-hub-panel { border:1px solid #e7eaec; border-radius:10px; background:linear-gradient(180deg, #fbfdff 0%, #f5f9fc 100%); padding:20px; }
  .ai-hub-header { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:14px; }
  .ai-hub-title h3 { margin:0 0 6px; font-size:24px; color:#23415c; }
  .ai-hub-title p { margin:0; color:#6d8294; max-width:860px; }
  .ai-hub-thread { border:1px solid #dde6ee; border-radius:12px; background:#fff; min-height:300px; max-height:480px; overflow-y:auto; padding:18px; box-shadow:inset 0 1px 0 rgba(255,255,255,.7); }
  .ai-hub-empty { color:#7e94a7; font-size:13px; }
  .ai-hub-message { display:flex; margin-bottom:14px; }
  .ai-hub-message.is-user { justify-content:flex-end; }
  .ai-hub-bubble { max-width:82%; border-radius:14px; padding:12px 14px; font-size:14px; line-height:1.55; white-space:normal; box-shadow:0 8px 24px rgba(35, 65, 92, .06); }
  .ai-hub-message.is-assistant .ai-hub-bubble { background:#f3f7fb; border:1px solid #dce7f0; color:#2c455c; }
  .ai-hub-message.is-user .ai-hub-bubble { background:#1ab394; border:1px solid #16a085; color:#fff; }
  .ai-hub-role { display:block; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; margin-bottom:6px; opacity:.72; }
  .ai-hub-composer { margin-top:16px; background:#fff; border:1px solid #dde6ee; border-radius:12px; padding:16px; }
  .ai-hub-label { display:flex; align-items:center; gap:8px; font-weight:600; color:#294964; margin-bottom:8px; }
  .ai-hub-label .fa { color:#1c84c6; cursor:help; }
  .ai-hub-textarea { min-height:124px; resize:vertical; border-radius:10px; }
  .ai-hub-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; align-items:center; }
  .ai-hub-mic-btn { min-width:44px; display:inline-flex; align-items:center; justify-content:center; }
  .ai-hub-mic-btn.is-listening { background:#ed5565; border-color:#d9534f; color:#fff; }
  .ai-hub-mic-btn[disabled] { cursor:not-allowed; opacity:.65; }
  .ai-hub-note { color:#7d90a2; font-size:12px; margin-top:10px; }
  .ai-hub-voice-status { margin-top:8px; color:#5e7488; font-size:12px; min-height:18px; }
  .ai-hub-voice-status.is-error { color:#d9534f; }
  .ai-hub-voice-status.is-active { color:#1c84c6; }
  .ai-hub-confirm { display:none; margin-top:16px; border:1px solid #d8ebe3; border-radius:12px; background:#fff; padding:16px; box-shadow:0 8px 24px rgba(26, 179, 148, .06); }
  .ai-hub-confirm.is-visible { display:block; }
  .ai-hub-confirm h4 { margin:0 0 8px; color:#245b4a; font-size:16px; }
  .ai-hub-confirm p { margin:0 0 10px; color:#536b62; }
  .ai-hub-confirm-actions { display:flex; gap:10px; flex-wrap:wrap; }
  .ai-hub-artifact { border:1px solid #dde6ee; border-radius:12px; background:#fff; padding:18px; display:none; }
  .ai-hub-artifact.is-visible { display:block; }
  .ai-hub-artifact-header { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; margin-bottom:14px; }
  .ai-hub-artifact-header h4 { margin:0; color:#24445e; font-size:18px; }
  .ai-hub-artifact-header p { margin:6px 0 0; color:#708395; max-width:860px; }
  .ai-hub-widget-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:12px; }
  .ai-hub-widget { border:1px solid #e7eaec; border-radius:8px; background:#fff; padding:12px; min-height:120px; }
  .ai-hub-widget-title { font-weight:600; margin-bottom:8px; color:#26455f; }
  .ai-hub-kpi-value { font-size:26px; font-weight:700; line-height:1.2; color:#1a7f68; }
  .ai-hub-grid-table-wrap { overflow:auto; border:1px solid #edf1f4; border-radius:10px; }
  .ai-hub-grid-table { width:100%; border-collapse:collapse; }
  .ai-hub-grid-table th, .ai-hub-grid-table td { padding:10px 12px; border-bottom:1px solid #edf1f4; font-size:13px; vertical-align:top; }
  .ai-hub-grid-table th { background:#f8fbfd; color:#506779; font-weight:600; }
  .ai-hub-grid-table tr:last-child td { border-bottom:none; }
  .ai-hub-meta { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
  .ai-hub-chip { display:inline-flex; align-items:center; border-radius:999px; padding:6px 10px; background:#edf8f4; color:#2f6453; font-size:12px; border:1px solid #d6ece4; }
  .ai-hub-suggestions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  .ai-hub-suggestion { border:1px solid #dbe7ef; background:#fff; border-radius:999px; padding:7px 12px; font-size:12px; color:#37556e; cursor:pointer; transition:all .2s ease; }
  .ai-hub-suggestion:hover { border-color:#1ab394; color:#1a7f68; transform:translateY(-1px); }
  .ai-hub-loading { display:inline-flex; align-items:center; gap:8px; color:#7b8d9d; font-size:12px; }
  .ai-hub-spinner { width:16px; height:16px; border-radius:50%; border:2px solid #dbe6ef; border-top-color:#1ab394; display:inline-block; animation:aiHubSpin .8s linear infinite; }
  @keyframes aiHubSpin { to { transform:rotate(360deg); } }
  @media (max-width: 768px) {
    .ai-hub-header { flex-direction:column; }
    .ai-hub-bubble { max-width:100%; }
    .ai-hub-actions { flex-direction:column; align-items:stretch; }
    .ai-hub-actions .btn { width:100%; }
  }
</style>

<div class="row animated fadeInRight" style="margin-top:25px;">
  <div class="col-lg-9">
    <div class="ibox">
      <div class="ibox-title">
        <h5 id="pageAiTitle">Inteligência Artificial</h5>
      </div>
      <div class="ibox-content">
        <div class="ai-hub-shell">
          <div class="ai-hub-panel">
            <div class="ai-hub-header">
              <div class="ai-hub-title">
                <!-- <h3 id="aiHubTitle">Converse com a IA</h3> -->
                <p id="aiHubSubtitle">Peça dashboards, relatórios, criação de registros e informações do sistema em linguagem natural. Se faltar algo importante, a IA pergunta antes.</p>
              </div>
              <div id="aiHubPendingWrap" class="ai-hub-loading" style="display:none;">
                <span class="ai-hub-spinner"></span>
                <span id="aiHubPendingText">Analisando seu pedido...</span>
              </div>
            </div>

            <div id="aiHubThread" class="ai-hub-thread"></div>

            <div class="ai-hub-composer">
              <label class="ai-hub-label" for="aiHubPrompt">
                <span id="aiHubPromptLabel">Prompt da IA</span>
                <i
                  class="fa fa-question-circle"
                  data-toggle="tooltip"
                  data-placement="right"
                  title="Você pode pedir dashboards, relatórios, criação de registros e consultas do ERP. Quanto mais contexto de negócio você der, melhor a IA consegue montar a resposta."
                ></i>
              </label>
              <textarea id="aiHubPrompt" class="form-control ai-hub-textarea" placeholder="Ex: Crie um dashboard com faturamento dos últimos 6 meses e top 5 clientes."></textarea>
              <div id="aiHubVoiceStatus" class="ai-hub-voice-status" aria-live="polite"></div>
              <div class="ai-hub-actions">
                <button id="btnAiHubSend" type="button" class="btn btn-primary">
                  <i class="fa fa-magic"></i> <span id="btnAiHubSendText">Enviar para IA</span>
                </button>
                <button id="btnAiHubVoice" type="button" class="btn btn-default ai-hub-mic-btn" title="Falar no microfone">
                  <i class="fa fa-microphone"></i>
                </button>
                <button id="btnAiHubClear" type="button" class="btn btn-default">
                  <span id="btnAiHubClearText">Limpar conversa</span>
                </button>
              </div>
              <div id="aiHubHelperText" class="ai-hub-note">Exemplos: gerar dashboards, listar registros, criar incidente, trazer informações financeiras ou montar um relatório operacional.</div>

            </div>

            <div id="aiHubDraftConfirmation" class="ai-hub-confirm">
              <h4 id="aiHubDraftTitle">Confirme a ação</h4>
              <p id="aiHubDraftSummary"></p>
              <div id="aiHubDraftMeta" class="ai-hub-meta"></div>
              <div class="ai-hub-confirm-actions">
                <button id="btnAiHubConfirm" type="button" class="btn btn-primary">
                  <i class="fa fa-check"></i> <span id="btnAiHubConfirmText">Confirmar e criar</span>
                </button>
                <button id="btnAiHubRefine" type="button" class="btn btn-default">
                  <span id="btnAiHubRefineText">Ajustar no chat</span>
                </button>
              </div>
            </div>
          </div>

          <div id="aiHubArtifact" class="ai-hub-artifact">
            <div class="ai-hub-artifact-header">
              <div>
                <h4 id="aiHubArtifactTitle">Resultado</h4>
                <p id="aiHubArtifactSummary"></p>
              </div>
              <div id="aiHubArtifactActions"></div>
            </div>
            <div id="aiHubArtifactMeta" class="ai-hub-meta"></div>
            <div id="aiHubArtifactBody"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3">
    <div class="ibox">
      <div class="ibox-title">
        <h5 id="pageAiSugestionTitle">Sugestões</h5>
      </div>
      <div class="ibox-content">
                      <div id="aiHubSuggestions" class="ai-hub-suggestions"></div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__AI_HUB_PAGE = {
    lang: <%- JSON.stringify(lang || 'pt-BR') %>
  };
</script>

<% contentFor('scripts') %>
  <script src="/Assets/inspinia/js/plugins/chartJs/Chart.min.js"></script>
  <script src="/js/common/apiClient.js"></script>
  <script src="/js/common/aiApi.js"></script>
  <script src="/js/ai/ai.page.js"></script>
<% %>
