                    async function openEditProject() {
                        if (!processRaw) return;

                        await loadProcessStatusConfigsCache();

                        const completed = clampPercent(processRaw?.completed);
                        const shipLocal = toDatetimeLocalValue(processRaw?.ship_date);
                        const totalValueRaw =
                          processRaw?.total_value ??
                          processRaw?.totalValue ??
                          null;
                        const totalValueParsed = parseCurrencyPtBr(totalValueRaw);
                        const totalValueText = totalValueParsed == null ? "" : formatCurrencyBrl(totalValueParsed);
                        const statusInfo = getProcessStatusDisplay(processRaw);
                        const currentStatusConfigId = statusInfo.statusConfigId;
                        const currentLegacyStatus = statusInfo.legacyStatus;

                        const defaultLegacyOptions = [
                          { value: 0, label: "Rascunho" },
                          { value: 1, label: "Em andamento" },
                          { value: 2, label: "Proximo do prazo" },
                          { value: 3, label: "Atrasado" },
                          { value: 4, label: "Finalizado" },
                        ];

                        let statusOptions = [];
                        if (Array.isArray(processStatusOptionsCache) && processStatusOptionsCache.length > 0) {
                          statusOptions = processStatusOptionsCache.map((opt) => ({
                            value: opt.id,
                            label: opt.label,
                            legacy: Number.isFinite(opt.legacy) ? opt.legacy : null,
                          }));
                        } else {
                          statusOptions = defaultLegacyOptions.map((opt) => ({
                            value: `legacy:${opt.value}`,
                            label: opt.label,
                            legacy: opt.value,
                          }));
                        }

                        const hasCurrentByConfigId = currentStatusConfigId && statusOptions.some((opt) => String(opt.value) === currentStatusConfigId);
                        const hasCurrentByLegacy = currentLegacyStatus != null && statusOptions.some((opt) => Number(opt.legacy) === Number(currentLegacyStatus));
                        if (!hasCurrentByConfigId && !hasCurrentByLegacy && statusInfo.label) {
                          statusOptions.push({
                            value: currentStatusConfigId || `legacy:${currentLegacyStatus ?? 0}`,
                            label: statusInfo.label,
                            legacy: currentLegacyStatus,
                          });
                        }

                        const statusOptionsHtml = statusOptions
                          .map((opt, index) => {
                            const isSelected =
                              (currentStatusConfigId && String(opt.value) === currentStatusConfigId) ||
                              (!currentStatusConfigId && currentLegacyStatus != null && Number(opt.legacy) === Number(currentLegacyStatus)) ||
                              (!currentStatusConfigId && currentLegacyStatus == null && index === 0);
                            return `<option value="${escapeHtml(String(opt.value))}" data-legacy="${escapeHtml(String(opt.legacy ?? ""))}" ${isSelected ? "selected" : ""}>${escapeHtml(String(opt.label))}</option>`;
                          })
                          .join("");

                        const html = `
      <div class="form-group">
        <label for="txtCompleted">Concluído (0 a 100)</label>
        <input id="txtCompleted" type="number" min="0" max="100" class="form-control" value="${escapeHtml(String(completed))}" />
