    getTransportTypes()
  ]);

  const currentStatusId = String(t?.transport_status_id || "");
  const currentTypeId = String(t?.transport_type_id || "");
  const currentTrackingLink = Array.isArray(t?.tracking_links)
    ? t.tracking_links.find((link) => {
        const provider = String(link?.provider || "").trim().toUpperCase();
        const mode = String(link?.mode || "").trim().toUpperCase();
        return provider === "MARINETRAFFIC" || provider === "FR24" || mode === "SEA" || mode === "AIR";
      })
