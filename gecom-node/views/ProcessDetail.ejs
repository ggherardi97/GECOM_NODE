  const currentTrackingMode = String(currentTrackingLink?.mode || t?.tracking_mode || "").trim();
  const currentTrackingProvider = String(currentTrackingLink?.provider || t?.tracking_provider || "").trim();
  const currentTrackingExternalId = String(currentTrackingLink?.external_id || t?.tracking_external_id || "").trim();
  const currentShipId = String(t?.ship_id || t?.shipId || currentTrackingLink?.last_snapshot_json?.meta?.shipId || "").trim();

  const statusOptions = (statuses || [])
    .map((s) => {
