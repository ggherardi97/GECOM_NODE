    "Nova Zelândia": [-40.9006, 174.8860],
    "New Zealand": [-40.9006, 174.8860],
    "Nova Zelândia": [-40.9006, 174.8860],
    "África do Sul": [-30.5595, 22.9375],
    "South Africa": [-30.5595, 22.9375],
    "África do Sul": [-30.5595, 22.9375]
  };

  const COUNTRY_COORDS = new Map(
    Object.entries(COUNTRY_COORDS_RAW).map(([name, coords]) => [normalizeGeoKey(name), coords]),
  );

  function getCoords(countryName) {
    return COUNTRY_COORDS.get(normalizeGeoKey(countryName)) || null;
  }

  function getTransportLineColor(transportType) {
    const type = normalizeGeoKey(transportType);
    const compact = type.replace(/\s+/g, "");
    if (!type) return "#999";
    if (compact.includes("MARIT") || compact.includes("SEA") || compact.includes("OCEAN")) return "#1c84c6";
    if (compact.includes("AEREO") || compact.includes("AREO") || compact.includes("AER") || compact.includes("AIR")) return "#1ab394";
    if (compact.includes("TERRESTRE") || compact.includes("ROAD") || compact.includes("LAND")) return "#8b5a2b";
    return "#999";
  }

  function isAirTransportTypeName(typeName) {
    const token = normalizeGeoKey(typeName).replace(/\s+/g, "");
    return token.includes("AEREO") || token.includes("AREO") || token.includes("AER") || token.includes("AIR");
  }

  function extractFlightCodeCandidate(value) {
    const code = String(value || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
    if (!code || code.length < 3) return null;
    return code;
  }

  function normalizeMarineTrafficExternalIdentifierCandidate(value) {
    const cleaned = String(value || "").trim();
    if (!cleaned) return null;

    const prefixed = cleaned.match(/^(imo|mmsi)\s*[:=]?\s*(\d+)$/i);
    if (prefixed) {
      return {
        kind: prefixed[1].toLowerCase(),
        value: prefixed[2],
      };
    }

    const digitsOnly = cleaned.replace(/\D+/g, "");
    if (!digitsOnly) {
      return {
        kind: "imo",
        value: cleaned,
      };
    }

    return {
      kind: digitsOnly.length === 9 ? "mmsi" : "imo",
      value: digitsOnly,
    };
  }

  function normalizeMarineTrafficShipIdCandidate(value) {
    const cleaned = String(value || "").trim();
    return cleaned ? cleaned : null;
  }

  function buildMarineTrafficDetailsUrl(externalIdentifier) {
    const kind = String(externalIdentifier?.kind || "").trim().toLowerCase();
    const value = String(externalIdentifier?.value || "").trim();
    if (!kind || !value) return "about:blank";
    return `https://www.marinetraffic.com/en/ais/details/ships/${kind}:${encodeURIComponent(value)}/`;
  }

  function buildMarineTrafficTrackUrl(shipId) {
    const value = String(shipId || "").trim();
    if (!value) return "about:blank";
    return `https://www.marinetraffic.com/en/ais/home/shipid:${encodeURIComponent(value)}/zoom:14`;
  }

  function extractMarineTrafficSnapshotMeta(snapshot) {
    const meta = snapshot?.meta && typeof snapshot.meta === "object" ? snapshot.meta : {};
    const mtUrl = String(meta.mtUrl ?? meta.mt_url ?? meta.MT_URL ?? "").trim();
    const shipId = String(meta.shipId ?? meta.shipID ?? meta.ship_id ?? meta.SHIP_ID ?? "").trim();
    const vesselName = String(meta.vesselName ?? meta.vessel_name ?? meta.vessel ?? meta.SHIPNAME ?? "").trim();
    const shipIdFromUrl = mtUrl.match(/shipid:(\d+)/i)?.[1] || "";

    return {
      mtUrl,
      shipId: shipId || shipIdFromUrl,
      vesselName,
    };
  }

  function extractMarineTrafficCenterFromSnapshot(snapshot) {
    const current = snapshot?.current ?? snapshot?.current_position ?? snapshot?.position ?? snapshot?.data?.position;
    const lat = Number(current?.lat ?? current?.latitude);
    const lon = Number(current?.lon ?? current?.lng ?? current?.longitude);
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;
    return { lat, lon };
  }

  function extractMarineTrafficTrackingInfoFromTransport(transport) {
    const trackingLinks = Array.isArray(transport?.tracking_links) ? transport.tracking_links : [];
    let center = null;

    for (const link of trackingLinks) {
      const provider = normalizeGeoKey(link?.provider).replace(/\s+/g, "");
      const mode = normalizeGeoKey(link?.mode).replace(/\s+/g, "");
      if (mode && mode !== "SEA") continue;
      if (provider && provider !== "MARINETRAFFIC") continue;

      const snapshotMeta = extractMarineTrafficSnapshotMeta(link?.last_snapshot_json);
      const shipId = normalizeMarineTrafficShipIdCandidate(
        transport?.ship_id ??
          transport?.shipId ??
          snapshotMeta.shipId ??
          link?.ship_id ??
          link?.shipId ??
          "",
      );
      const externalIdentifier = normalizeMarineTrafficExternalIdentifierCandidate(
        link?.external_id ?? link?.externalId ?? transport?.tracking_external_id ?? transport?.trackingExternalId ?? "",
      );
      if (!center) {
        center = extractMarineTrafficCenterFromSnapshot(link?.last_snapshot_json);
      }

      if (externalIdentifier || shipId || snapshotMeta.vesselName) {
        return {
          externalIdentifier,
          center,
          shipId,
          vesselName: snapshotMeta.vesselName || null,
        };
      }
    }

    const externalCandidates = [transport?.tracking_external_id, transport?.trackingExternalId, transport?.external_id, transport?.externalId];

    for (const candidate of externalCandidates) {
      const externalIdentifier = normalizeMarineTrafficExternalIdentifierCandidate(candidate);
      const shipId = normalizeMarineTrafficShipIdCandidate(transport?.ship_id ?? transport?.shipId ?? "");
      if (externalIdentifier || shipId) {
        return { externalIdentifier, center, shipId, vesselName: null };
      }
    }

    return center ? { externalIdentifier: null, center, shipId: null, vesselName: null } : null;
  }

  function isMarineTrafficTransportRow(transport) {
    const token = normalizeGeoKey(getTransportTypeName(transport?.transport_type_id)).replace(/\s+/g, "");
    if (token.includes("MARIT") || token.includes("SEA") || token.includes("OCEAN")) return true;

    const trackingLinks = Array.isArray(transport?.tracking_links) ? transport.tracking_links : [];
    return trackingLinks.some((link) => {
      const provider = normalizeGeoKey(link?.provider).replace(/\s+/g, "");
      const mode = normalizeGeoKey(link?.mode).replace(/\s+/g, "");
      return provider === "MARINETRAFFIC" || mode === "SEA";
    });
  }

  function extractFlightCodeFromTransportRow(transport) {
    const candidates = [
      transport?.flight_number,
      transport?.flightNumber,
      transport?.flight_code,
      transport?.flightCode,
      transport?.external_id,
      transport?.externalId,
      transport?.tracking_code,
      transport?.trackingCode,
      transport?.awb,
      transport?.air_waybill,
      transport?.airWaybill,
      transport?.reference,
      transport?.reference_code,
      transport?.referenceCode,
    ];

    for (const candidate of candidates) {
      const code = extractFlightCodeCandidate(candidate);
      if (code) return code;
    }
    return null;
  }

  async function resolveMarineTrackingInfo(transportsInput) {
    const transports = Array.isArray(transportsInput) ? transportsInput : [];
    if (!transports.length) {
      return {
        externalIdentifier: null,
        shipId: null,
        detailsUrl: "about:blank",
        trackUrl: "about:blank",
        hint: "Nenhum transporte foi encontrado para este processo.",
      };
    }

    for (const row of transports) {
      const trackingInfo = extractMarineTrafficTrackingInfoFromTransport(row);
      const hasResolvedTrackingInfo = Boolean(trackingInfo?.externalIdentifier || trackingInfo?.shipId || trackingInfo?.center);
      if (hasResolvedTrackingInfo) {
        const detailsUrl = buildMarineTrafficDetailsUrl(trackingInfo.externalIdentifier);
        const trackUrl = buildMarineTrafficTrackUrl(trackingInfo.shipId);
        return {
          externalIdentifier: trackingInfo.externalIdentifier,
          shipId: trackingInfo.shipId,
          detailsUrl,
          trackUrl,
          hint: trackingInfo.shipId
            ? "SHIP_ID identificado a partir do transporte."
            : trackingInfo.externalIdentifier
                ? "IMO/MMSI identificado a partir do transporte."
                : trackingInfo.center
                  ? "Posição atual identificada a partir do transporte."
                  : "Rastreamento identificado a partir do transporte.",
        };
      }

      const fromTracking = await tryFetchMarineTrafficIdentifierFromTracking(row?.id);
      const hasResolvedFromTracking = Boolean(fromTracking?.externalIdentifier || fromTracking?.shipId || fromTracking?.center);
      if (hasResolvedFromTracking) {
        const detailsUrl = buildMarineTrafficDetailsUrl(fromTracking.externalIdentifier);
        const trackUrl = buildMarineTrafficTrackUrl(fromTracking.shipId);
        return {
          externalIdentifier: fromTracking.externalIdentifier,
          shipId: fromTracking.shipId,
          detailsUrl,
          trackUrl,
          hint: fromTracking.shipId
            ? "SHIP_ID identificado a partir do rastreamento vinculado ao transporte."
            : fromTracking.externalIdentifier
                ? "IMO/MMSI identificado a partir do rastreamento vinculado ao transporte."
                : fromTracking.center
                  ? "Posição atual identificada a partir do rastreamento vinculado ao transporte."
                  : "Rastreamento identificado a partir do rastreamento vinculado ao transporte.",
          };
      }
    }

    return {
      externalIdentifier: null,
      shipId: null,
      detailsUrl: "about:blank",
      trackUrl: "about:blank",
      hint: "Nenhum rastreamento marítimo MarineTraffic válido foi encontrado nos transportes deste processo.",
    };
  }

  async function tryFetchMarineTrafficIdentifierFromTracking(transportId) {
    const id = String(transportId || "").trim();
    if (!id) return null;

    try {
      const response = await fetch(`/api/transports/${encodeURIComponent(id)}/tracking?refresh=false`, {
        method: "GET",
        headers: { Accept: "application/json" },
      });
      if (!response.ok) return null;
      const data = await response.json().catch(() => ({}));

      const mode = String(data?.mode || "").trim().toUpperCase();
      const provider = String(data?.meta?.provider || data?.provider || "").trim().toUpperCase();
      if (mode && mode !== "SEA") return null;
      if (provider && provider !== "MARINETRAFFIC") return null;

      const snapshotMeta = extractMarineTrafficSnapshotMeta(data);
      const center = extractMarineTrafficCenterFromSnapshot(data);
      const candidates = [
        data?.meta?.externalId,
        data?.meta?.external_id,
        data?.externalId,
        data?.external_id,
      ];
      const shipId = normalizeMarineTrafficShipIdCandidate(snapshotMeta.shipId);

      for (const candidate of candidates) {
        const externalIdentifier = normalizeMarineTrafficExternalIdentifierCandidate(candidate);
        if (externalIdentifier || shipId || snapshotMeta.vesselName) {
          return {
            externalIdentifier,
            shipId,
            center,
            vesselName: snapshotMeta.vesselName || null,
          };
        }
      }

      return center ? { externalIdentifier: null, shipId, center, vesselName: snapshotMeta.vesselName || null } : null;
    } catch {
      return null;
    }
  }

  async function tryFetchFlightCodeFromTracking(transportId) {
    const id = String(transportId || "").trim();
    if (!id) return null;

    try {
      const response = await fetch(`/api/transports/${encodeURIComponent(id)}/tracking?refresh=false`, {
        method: "GET",
        headers: { Accept: "application/json" },
      });
      if (!response.ok) return null;
      const data = await response.json().catch(() => ({}));

      const candidates = [
        data?.meta?.externalId,
        data?.meta?.external_id,
        data?.externalId,
        data?.external_id,
        data?.flightNumber,
        data?.flight_number,
      ];

      for (const candidate of candidates) {
        const code = extractFlightCodeCandidate(candidate);
        if (code) return code;
      }

      return null;
    } catch {
      return null;
    }
  }

  async function resolveAirTrackingInfo(transportsInput) {
    const transports = Array.isArray(transportsInput) ? transportsInput : [];
    const airRows = transports.filter((row) => {
      if (isAirTransportTypeName(getTransportTypeName(row?.transport_type_id))) return true;

      const trackingLinks = Array.isArray(row?.tracking_links) ? row.tracking_links : [];
      return trackingLinks.some((link) => {
        const provider = normalizeGeoKey(link?.provider).replace(/\s+/g, "");
        const mode = normalizeGeoKey(link?.mode).replace(/\s+/g, "");
        return provider === "FR24" || mode === "AIR";
      });
    });

    if (!airRows.length) {
      return {
        flightCode: null,
        href: "https://www.flightradar24.com/",
        hint: "Nenhum transporte aéreo encontrado para este processo.",
      };
    }

    for (const row of airRows) {
      const fromTransport = extractFlightCodeFromTransportRow(row);
      if (fromTransport) {
        return {
          flightCode: fromTransport,
          href: `https://www.flightradar24.com/${encodeURIComponent(fromTransport)}`,
          hint: "Voo identificado a partir dos dados do transporte.",
        };
      }

      const fromTracking = await tryFetchFlightCodeFromTracking(row?.id);
      if (fromTracking) {
        return {
          flightCode: fromTracking,
          href: `https://www.flightradar24.com/${encodeURIComponent(fromTracking)}`,
          hint: "Voo identificado a partir do vínculo de rastreamento.",
        };
      }
    }

    return {
      flightCode: null,
      href: "https://www.flightradar24.com/",
      hint: "Transporte aéreo encontrado, mas sem número de voo vinculado.",
    };
  }

  async function refreshAirTrackingCard(transportsInput) {
    const codeEl = document.getElementById("airTrackingFlightCode");
    const hintEl = document.getElementById("airTrackingHint");
    const btnEl = document.getElementById("airTrackingLinkBtn");
    if (!codeEl || !hintEl || !btnEl) return;

    codeEl.textContent = "-";
    hintEl.textContent = "Carregando dados de rastreamento...";
    btnEl.setAttribute("href", "javascript:void(0)");
    btnEl.classList.add("disabled");
    btnEl.setAttribute("aria-disabled", "true");

    const info = await resolveAirTrackingInfo(transportsInput);
    codeEl.textContent = info.flightCode || "-";
    hintEl.textContent = info.hint;

    if (info.flightCode) {
      btnEl.setAttribute("href", info.href);
      btnEl.classList.remove("disabled");
      btnEl.removeAttribute("aria-disabled");
    } else {
      btnEl.setAttribute("href", "javascript:void(0)");
      btnEl.classList.add("disabled");
      btnEl.setAttribute("aria-disabled", "true");
    }
  }

  window.refreshAirTrackingCard = refreshAirTrackingCard;

  async function refreshMarineTrackingCard(transportsInput) {
    const externalIdEl = document.getElementById("marineTrafficMmsi");
    const shipIdEl = document.getElementById("marineTrafficShipId");
    const detailsBtnEl = document.getElementById("marineTrafficDetailsBtn");
    const trackBtnEl = document.getElementById("marineTrafficTrackBtn");
    const hintEl = document.getElementById("marineTrafficHint");
    if (!externalIdEl || !shipIdEl || !detailsBtnEl || !trackBtnEl || !hintEl) return;

    externalIdEl.textContent = "-";
    shipIdEl.textContent = "-";
    detailsBtnEl.setAttribute("href", "javascript:void(0)");
    detailsBtnEl.style.display = "none";
    detailsBtnEl.classList.add("disabled");
    detailsBtnEl.setAttribute("aria-disabled", "true");
    trackBtnEl.setAttribute("href", "javascript:void(0)");
    trackBtnEl.style.display = "none";
    trackBtnEl.classList.add("disabled");
    trackBtnEl.setAttribute("aria-disabled", "true");
    hintEl.textContent = "Carregando dados de rastreamento...";

    const info = await resolveMarineTrackingInfo(transportsInput);
    const externalLabel = info.externalIdentifier
      ? String(info.externalIdentifier.kind || "").trim().toUpperCase()
      : "-";
    externalIdEl.textContent = info.externalIdentifier ? `${externalLabel}: ${info.externalIdentifier.value}` : "-";
    shipIdEl.textContent = info.shipId || "-";
    hintEl.textContent = info.hint;

    if (info.detailsUrl && info.detailsUrl !== "about:blank" && info.externalIdentifier) {
      detailsBtnEl.setAttribute("href", info.detailsUrl);
      detailsBtnEl.style.display = "";
      detailsBtnEl.classList.remove("disabled");
      detailsBtnEl.removeAttribute("aria-disabled");
    }

    if (info.trackUrl && info.trackUrl !== "about:blank" && info.shipId) {
      trackBtnEl.setAttribute("href", info.trackUrl);
      trackBtnEl.style.display = "";
      trackBtnEl.classList.remove("disabled");
      trackBtnEl.removeAttribute("aria-disabled");
    }
  }

  window.refreshMarineTrackingCard = refreshMarineTrackingCard;

  window.loadMapLeft = function loadMapLeft() {
    setTimeout(function () {
      if (window.__trackingMap) {
        try { window.__trackingMap.remove(); } catch { /* ignore */ }
        window.__trackingMap = null;
      }

      const mapEl = document.getElementById("map");
      if (!mapEl) return;

      const map = L.map("map").setView([0, 0], 2);
      window.__trackingMap = map;

      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: "&copy; OpenStreetMap",
      }).addTo(map);

      const transports = Array.isArray(window.transportsCache) ? window.transportsCache : [];
      const routes = transports
        .map((t) => ({
          origin: String(t?.origin || "").trim(),
          destination: String(t?.destination || "").trim(),
          status: String(getTransportStatusName(t?.transport_status_id) || "").trim(),
          typeName: String(getTransportTypeName(t?.transport_type_id) || "").trim(),
        }))
        .filter((route) => route.origin && route.destination);

      if (!routes.length) {
        map.setView([0, 0], 2);
        setTimeout(() => map.invalidateSize(), 100);
        return;
      }

      const allLatLngs = [];

      routes.forEach((route) => {
        const origin = getCoords(route.origin);
        const destination = getCoords(route.destination);
        if (!origin || !destination) return;

        const lineColor = getTransportLineColor(route.typeName);
        const latlngs = [origin, destination];

        L.circleMarker(origin, {
          radius: 7,
          color: "#1ab394",
          fillColor: "#1ab394",
          fillOpacity: 0.85,
          weight: 2,
        }).addTo(map).bindPopup(`<b>Origem:</b> ${escapeHtml(route.origin)}`);

        L.circleMarker(destination, {
          radius: 7,
          color: "#ed5565",
          fillColor: "#ed5565",
          fillOpacity: 0.85,
          weight: 2,
        }).addTo(map).bindPopup(`<b>Destino:</b> ${escapeHtml(route.destination)}`);

        const line = L.polyline(latlngs, {
          weight: 4,
          color: lineColor,
          opacity: 0.95,
        }).addTo(map);

        line.bindPopup(
          `<b>${escapeHtml(route.origin)} → ${escapeHtml(route.destination)}</b><br/>` +
          `<small>Tipo: ${escapeHtml(route.typeName || "-")} | Status: ${escapeHtml(route.status || "-")}</small>`,
        );

        allLatLngs.push(...latlngs);
      });

      if (allLatLngs.length) {
        map.fitBounds(L.latLngBounds(allLatLngs), { padding: [24, 24] });
      } else {
        map.setView([0, 0], 2);
      }

      setTimeout(() => map.invalidateSize(), 100);
    }, 350);
  };
})();
</script>




