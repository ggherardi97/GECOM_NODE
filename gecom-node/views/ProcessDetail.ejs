                    function parseUnsupportedProcessFieldsFromError(err) {
                        const msg = String(err?.message || "").toLowerCase();
                        const unsupported = [];
                        if (!msg) return unsupported;
                        if (msg.includes("total_value") && msg.includes("should not exist")) unsupported.push("total_value");
                        if (msg.includes("status_config_id") && msg.includes("should not exist")) unsupported.push("status_config_id");
                        return unsupported;
                    }

                    function stripUnsupportedProcessFields(payload, err) {
                        const unsupported = parseUnsupportedProcessFieldsFromError(err);
                        if (!unsupported.length) return null;
                        const next = { ...(payload || {}) };
                        unsupported.forEach((field) => { delete next[field]; });
                        return next;
                    }

                    async function patchProcessWithCompatibility(id, payload) {
                        const url = `/api/processes/${encodeURIComponent(id)}`;
                        try {
                          return await apiPatch(url, payload);
                        } catch (e) {
                          const compatPayload = stripUnsupportedProcessFields(payload, e);
                          if (!compatPayload) throw e;
                          console.warn("Backend ainda não aceita alguns campos de processo no PATCH. Reenviando payload compatível.", e?.message || e);
                          return apiPatch(url, compatPayload);
                        }
                    }

                    async function fetchCompanyLogoObjectUrl(companyId) {
                        try {
                            const id = String(companyId || "").trim();
                            if (!id) return null;

                            const resp = await fetch(`/api/companies/${encodeURIComponent(id)}/logo`, {
                                method: "GET",
                                headers: { Accept: "image/*" },
                                cache: "no-store"
                            });

                            if (resp.status === 204 || !resp.ok) return null;

                            const blob = await resp.blob();
                            if (!blob || blob.size === 0) return null;
                            return URL.createObjectURL(blob);
                        } catch (e) {
                            console.warn("fetchCompanyLogoObjectUrl failed:", e);
                            return null;
                        }
                    }

                    function setProcessCompanyLogo(src) {
                        const wrap = document.getElementById("processCompanyLogoWrap");
                        const img = document.getElementById("processCompanyLogo");
                        if (!wrap || !img) return;

                        if (window.__processCompanyLogoObjectUrl && String(window.__processCompanyLogoObjectUrl).startsWith("blob:")) {
                            try { URL.revokeObjectURL(window.__processCompanyLogoObjectUrl); } catch {}
                        }

                        if (src) {
                            img.src = src;
                            wrap.style.display = "block";
                            window.__processCompanyLogoObjectUrl = src;
                            return;
                        }

                        img.removeAttribute("src");
                        wrap.style.display = "none";
                        window.__processCompanyLogoObjectUrl = null;
                    }

