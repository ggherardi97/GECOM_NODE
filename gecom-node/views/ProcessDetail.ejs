function updateTrackingTabsVisibility(transportsInput) {
  const transports = Array.isArray(transportsInput) ? transportsInput : [];
  const normalizeToken = (value) => String(value || "")
    .trim()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toUpperCase()
    .replace(/[^A-Z0-9 ]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  const hasMarine = transports.some((row) => {
    const token = normalizeToken(getTransportTypeName(row?.transport_type_id));
    if (token.includes("MARIT") || token.includes("SEA") || token.includes("OCEAN")) return true;

    const trackingLinks = Array.isArray(row?.tracking_links) ? row.tracking_links : [];
    return trackingLinks.some((link) => {
      const provider = normalizeToken(link?.provider);
      const mode = normalizeToken(link?.mode);
      return provider === "MARINETRAFFIC" || mode === "SEA";
    });
  });
  const hasAir = transports.some((row) => {
    const token = normalizeToken(getTransportTypeName(row?.transport_type_id));
    if (token.includes("AEREO") || token.includes("AREO") || token.includes("AER") || token.includes("AIR")) return true;

    const trackingLinks = Array.isArray(row?.tracking_links) ? row.tracking_links : [];
    return trackingLinks.some((link) => {
      const provider = normalizeToken(link?.provider);
      const mode = normalizeToken(link?.mode);
      return provider === "FR24" || mode === "AIR";
    });
  });

  const marineTab = document.getElementById("marineTrackingTabLink");
  const marinePane = document.getElementById("tab-5");
  const airTab = document.getElementById("airTrackingTabLink");
  const airPane = document.getElementById("tab-6");

  if (marineTab) marineTab.style.display = hasMarine ? "" : "none";
  if (marinePane) marinePane.style.display = hasMarine ? "" : "none";
  if (airTab) airTab.style.display = hasAir ? "" : "none";
  if (airPane) airPane.style.display = hasAir ? "" : "none";

  const activeTab = document.querySelector(".nav-tabs .nav-link.active");
  if (activeTab) {
    const activeTarget = String(activeTab.getAttribute("href") || "").trim();
    const activeHidden = (activeTarget === "#tab-5" && !hasMarine) || (activeTarget === "#tab-6" && !hasAir);
    if (activeHidden && typeof window.$ === "function") {
      try {
        window.$('.nav-tabs .nav-link[href="#tab-1"]').tab("show");
      } catch {
        // ignore
      }
    }
  }
}

