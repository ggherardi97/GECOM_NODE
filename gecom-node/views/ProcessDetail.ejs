                    function fillHeader(p) {
                        const number = p?.process_number || "-";
                        $("#projectName").text(`${number}`);

                        const status = getProcessStatusDisplay(p);
                        const $state = $("#state");
                        $state.text(status.label || "-").removeClass().addClass("label");
                        if (status.color) {
                          $state.css({ backgroundColor: status.color, color: "#fff" });
                        } else {
                          $state.removeAttr("style");
                          const cssClass = status.legacyStatus != null
                            ? (window.ProcessStatusEnum?.getCssClass(status.legacyStatus) || "label-default")
                            : "label-default";
                          $state.addClass(cssClass);
                        }

                        $("#contactName").text(p?.users?.full_name || "-");
                        $("#invoiceNumber").text(p?.invoice || "-");
                        $("#companyName").text(p?.companies?.company_name || "-");
                        const companyId = p?.companies?.id || p?.company_id || null;
                        fetchCompanyLogoObjectUrl(companyId)
                            .then(setProcessCompanyLogo)
                            .catch(() => setProcessCompanyLogo(null));

                        // ship_date -> Data Estimada de Entrega
                        $("#shipDateText").text(formatDateOnlyPtBR(p?.ship_date));
                        $("#createdOnText").text(formatDateOnlyPtBR(p?.created_on));
                        const totalValueRaw = p?.total_value ?? p?.totalValue ?? null;
                        const totalValueParsed = parseCurrencyPtBr(totalValueRaw);
                        $("#totalValueText").text(totalValueParsed == null ? "-" : formatCurrencyBrl(totalValueParsed));

                        const completed = clampPercent(p?.completed);
                        $("#completedBar").css("width", `${completed}%`);
                        $("#completedPercentText").text(`${completed}%`);
                    }

