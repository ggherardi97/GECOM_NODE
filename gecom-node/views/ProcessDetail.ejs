        <input id="txtTotalValue" type="text" class="form-control" value="${escapeHtml(totalValueText)}" placeholder="R$ 0,00" />
      </div>

      <div class="form-group">
        <label for="selStatus">Status</label>
        <select id="selStatus" class="form-control">${statusOptionsHtml}</select>
      </div>
    `;

                        SideModal.open({
                            title: "Editar projeto",
                            html,
                            onOk: async function () {
                                const selectedValue = String($("#selStatus").val() || "").trim();
                                const selectedLegacyRaw = $("#selStatus option:selected").data("legacy");
                                const selectedLegacy = Number(selectedLegacyRaw);

                                const payload = {
                                    completed: clampPercent($("#txtCompleted").val()),
                                    ship_date: $("#dtShip").val() ? new Date($("#dtShip").val()).toISOString() : null
                                };
                                const editedTotalValue = parseCurrencyPtBr($("#txtTotalValue").val());
                                payload.total_value = Number.isFinite(editedTotalValue) ? Number(editedTotalValue.toFixed(2)) : null;

                                if (selectedValue && !selectedValue.startsWith("legacy:")) {
                                  payload.status_config_id = selectedValue;
                                }

                                let legacyStatusToSend = null;
                                if (Number.isFinite(selectedLegacy)) {
                                  legacyStatusToSend = selectedLegacy;
                                } else if (selectedValue.startsWith("legacy:")) {
                                  const parsed = Number(selectedValue.slice("legacy:".length));
                                  if (Number.isFinite(parsed)) legacyStatusToSend = parsed;
                                } else if (currentLegacyStatus != null && Number.isFinite(Number(currentLegacyStatus))) {
                                  legacyStatusToSend = Number(currentLegacyStatus);
                                }

                                if (legacyStatusToSend != null) payload.status = legacyStatusToSend;

                                await patchProcessWithCompatibility(processId, payload);
                                await loadProcessDetail(processId); // 1 GET
                            }
                        });
                        setTimeout(() => {
                            const $totalInput = $("#txtTotalValue");
                            bindCurrencyMask($totalInput);
                            $totalInput.trigger("blur");
                        }, 0);
                    }
                    window.openEditProject = openEditProject;

