    </div>

    <div class="form-group">
      <label for="selTransportType">Tipo de transporte</label>
      <select id="selTransportType" class="form-control">
        <option value="">Selecione...</option>
        ${typeOptions}
      </select>
    </div>

    <div class="form-group">
      <label for="selTransportStatus">Status do transporte</label>
      <select id="selTransportStatus" class="form-control">
        <option value="">Selecione...</option>
        ${statusOptions}
      </select>
    </div>

    <div class="form-group">
      <label for="selTrackingMode">Tracking mode</label>
      <select id="selTrackingMode" class="form-control">
        <option value="">-</option>
        <option value="AIR"${currentTrackingMode === "AIR" ? " selected" : ""}>AIR</option>
        <option value="SEA"${currentTrackingMode === "SEA" ? " selected" : ""}>SEA</option>
      </select>
    </div>

    <div class="form-group">
      <label for="selTrackingProvider">Tracking provider</label>
      <select id="selTrackingProvider" class="form-control">
        <option value="">-</option>
        <option value="FR24"${currentTrackingProvider === "FR24" ? " selected" : ""}>FR24</option>
        <option value="MARINETRAFFIC"${currentTrackingProvider === "MARINETRAFFIC" ? " selected" : ""}>Marine Traffic</option>
