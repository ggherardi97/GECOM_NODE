      if (!String($(trackingModeSelect).val() || "").trim()) $(trackingModeSelect).val(defaults.mode).trigger("change");
      if (!String($(trackingProviderSelect).val() || "").trim()) $(trackingProviderSelect).val(defaults.provider).trigger("change");
